import NearSpecV3.Successor.HostCommStep

/-!
# W12 / O3 — the non-call instructions keep the action log, the store and the global-actions flag

`setX x s` overwrites `s`'s action log, trie-backed store and global-actions flag by `x`'s. Every
machine helper and every instruction but the two calls commutes with it (`X_exec`; the proofs are the
`setF` ones of `HostCommStep.lean`, generated by `gen/gen_hostq.py`). Read at `x := s` this says those
instructions keep the three fields.
-/
namespace NearSpecV3.Successor.HostComm
open NearSpecV3.Wasm

def setX (x : St) (s : St) : St :=
  { s with actions := x.actions, real := x.real, globalActions := x.globalActions }

theorem setX_self (s : St) : setX s s = s := rfl

section
variable (q0 : St) (t : St)
@[simp] theorem X_stack : (setX q0 t).stack = t.stack := rfl
@[simp] theorem X_frames : (setX q0 t).frames = t.frames := rfl
@[simp] theorem X_pages : (setX q0 t).pages = t.pages := rfl
@[simp] theorem X_globals : (setX q0 t).globals = t.globals := rfl
@[simp] theorem X_table : (setX q0 t).table = t.table := rfl
@[simp] theorem X_tableMax : (setX q0 t).tableMax = t.tableMax := rfl
@[simp] theorem X_elems : (setX q0 t).elems = t.elems := rfl
@[simp] theorem X_datas : (setX q0 t).datas = t.datas := rfl
@[simp] theorem X_stackRem : (setX q0 t).stackRem = t.stackRem := rfl
@[simp] theorem X_gas : (setX q0 t).gas = t.gas := rfl
@[simp] theorem X_ctx : (setX q0 t).ctx = t.ctx := rfl
@[simp] theorem X_ret : (setX q0 t).ret = t.ret := rfl
@[simp] theorem X_balance : (setX q0 t).balance = t.balance := rfl
@[simp] theorem X_storageUsage : (setX q0 t).storageUsage = t.storageUsage := rfl
@[simp] theorem X_registers : (setX q0 t).registers = t.registers := rfl
@[simp] theorem X_regUsage : (setX q0 t).regUsage = t.regUsage := rfl
@[simp] theorem X_logs : (setX q0 t).logs = t.logs := rfl
@[simp] theorem X_totalLogLen : (setX q0 t).totalLogLen = t.totalLogLen := rfl
@[simp] theorem X_promises : (setX q0 t).promises = t.promises := rfl
@[simp] theorem X_trie : (setX q0 t).trie = t.trie := rfl
@[simp] theorem X_dataCount : (setX q0 t).dataCount = t.dataCount := rfl
@[simp] theorem X_subsidized : (setX q0 t).subsidized = t.subsidized := rfl
@[simp] theorem X_curveHosts : (setX q0 t).curveHosts = t.curveHosts := rfl
@[simp] theorem X_memBytes : memBytes (setX q0 t) = memBytes t := rfl
@[simp] theorem X_readByte (a : Nat) : readByte (setX q0 t) a = readByte t a := rfl
@[simp] theorem X_readBytes (a n : Nat) : readBytes (setX q0 t) a n = readBytes t a n := rfl
@[simp] theorem X_readLE (a w : Nat) : readLE (setX q0 t) a w = readLE t a w := rfl
theorem X_readByte' : readByte (setX q0 t) = readByte t := rfl
@[simp] theorem X_popN : popN (setX q0 t) = ((popN t).1, setX q0 (popN t).2) := by
  unfold popN popV; simp only [X_stack]; cases t.stack.back?.getD (Val.i32 0) <;> rfl

theorem X_writeByte (q0 : St) (t : St) (a : Nat) (v : UInt8) :
    writeByte (setX q0 t) a v = setX q0 (writeByte t a v) := rfl

theorem forIn'_X {q0 : St} : ∀ (l : List Nat) (f : (x : Nat) → x ∈ l → St → St) (t : St)
    (_hf : ∀ x h t, f x h (setX q0 t) = setX q0 (f x h t)),
    (forIn' (m := Id) l (setX q0 t) fun x h s => ForInStep.yield (f x h s)) =
      setX q0 (forIn' (m := Id) l t fun x h s => ForInStep.yield (f x h s))
  | [], _, _, _ => rfl
  | x :: xs, f, t, hf => by
    simp only [List.forIn'_cons]
    rw [hf]
    exact forIn'_X xs (fun y hy => f y (List.mem_cons_of_mem _ hy)) _ (fun y hy t => hf y _ t)

theorem X_writeBytes (q0 : St) (t : St) (a : Nat) (d : ByteArray) :
    writeBytes (setX q0 t) a d = setX q0 (writeBytes t a d) := by
  unfold writeBytes
  simp only [Id.run, Std.Legacy.Range.forIn'_eq_forIn'_range']
  exact forIn'_X _ _ _ (fun _ _ _ => rfl)
end

/-- Fold a structure literal over `setX x s`'s three fields back into `setX`. -/
theorem X_mk (q0 : St) (s : St) (a1 a2 a3 a4 a5 a6 a7 a8 a9 a10 a11 a12 a13 a14 a15 a16 a17 a18 a19 a20 a22 a24 a26) :
    St.mk a1 a2 a3 a4 a5 a6 a7 a8 a9 a10 a11 a12 a13 a14 a15 a16 a17 a18 a19 a20 (setX q0 s).actions a22
        (setX q0 s).real a24 (setX q0 s).globalActions a26 =
      setX q0 (St.mk a1 a2 a3 a4 a5 a6 a7 a8 a9 a10 a11 a12 a13 a14 a15 a16 a17 a18 a19 a20 s.actions a22
        s.real a24 s.globalActions a26) := rfl

syntax "sx_step" : tactic
macro_rules | `(tactic| sx_step) => `(tactic| first
  | rfl
  | rw [X_readByte']
  | rw [X_stack]
  | rw [X_frames]
  | rw [X_pages]
  | rw [X_globals]
  | rw [X_table]
  | rw [X_tableMax]
  | rw [X_elems]
  | rw [X_datas]
  | rw [X_stackRem]
  | rw [X_gas]
  | rw [X_memBytes]
  | rw [X_readBytes]
  | rw [X_readLE]
  | (simp only [X_stack, X_frames, X_pages, X_globals, X_table,
      X_tableMax, X_elems, X_datas, X_stackRem, X_gas, X_ctx, X_ret, X_balance, X_storageUsage, X_registers,
      X_regUsage, X_logs, X_totalLogLen, X_promises, X_trie, X_dataCount, X_subsidized, X_curveHosts,
      X_memBytes, X_readByte, X_readBytes, X_readLE,
      X_popN, X_writeBytes, X_writeByte, mapRes_cont, mapRes_fin, mapRes_abort, mapRes_unmodeled, exmap_ok,
      exmap_error, ite_true, ite_false, dite_true, dite_false, ↓reduceIte, ↓reduceDIte, X_mk])
  | sf_gen
  | lk_split
  | (rw [apply_ite (mapRes _)]; apply ite_congr rfl <;> intro)
  | (split <;> (rename_i hh; simp only [hh, ↓reduceIte, ite_true, ite_false])))
macro "sx" : tactic => `(tactic| repeat (any_goals sx_step))

section
variable {q0 : St} {s : St}
theorem X_setFrame (f : Frame) : setFrame (setX q0 s) f = setX q0 (setFrame s f) := by
  unfold setFrame; simp only [X_frames]; split <;> rfl
theorem X_pushV (v : Val) : pushV (setX q0 s) v = setX q0 (pushV s v) := rfl
theorem X_pushI32 (v : Nat) : pushI32 (setX q0 s) v = setX q0 (pushI32 s v) := rfl
theorem X_pushI64 (v : Nat) : pushI64 (setX q0 s) v = setX q0 (pushI64 s v) := rfl
theorem X_popV : popV (setX q0 s) = ((popV s).1, setX q0 (popV s).2) := rfl
theorem X_popRef : popRef (setX q0 s) = ((popRef s).1, setX q0 (popRef s).2) := by
  unfold popRef popV; simp only [X_stack]; cases s.stack.back?.getD (Val.i32 0) <;> rfl
theorem X_sync : sync (setX q0 s) = (sync s).map (setX q0) := by
  unfold sync; sx
theorem X_charge (fee : Fee) (c : Nat) : charge (setX q0 s) fee c = mapRes (setX q0) (charge s fee c) := by
  unfold charge; simp only [X_sync]; sx
theorem X_pushT (t : VT) (v : Nat) : pushT (setX q0 s) t v = setX q0 (pushT s t v) := by
  unfold pushT; split <;> rfl
theorem X_execFloat (op : Nat) :
    execFloat (setX q0 s) op = (execFloat s op).map (setX q0) := by
  unfold execFloat
  by_cases h : (floatOperands op).size = 2
  · rw [if_pos h, if_pos h]
    cases hp : popN s with
    | mk b s1 =>
      cases hq : popN s1 with
      | mk a s2 =>
        simp only [hp, hq, X_popN, X_pushT]
        cases evalFloatOp op a b <;> rfl
  · rw [if_neg h, if_neg h]
    cases hp : popN s with
    | mk a s1 =>
      simp only [hp, X_popN, X_pushT]
      cases evalFloatOp op a 0 <;> rfl

macro_rules | `(tactic| sx_step) => `(tactic| simp only [X_setFrame, X_pushV, X_pushI32, X_pushI64, X_pushT, X_execFloat, X_popV, X_popRef, X_sync, X_charge])

theorem forIn_X : ∀ (l : List Nat) (f : Nat → St → St) (t : St)
    (_hf : ∀ x t, f x (setX q0 t) = setX q0 (f x t)),
    (forIn (m := Id) l (setX q0 t) fun x s => ForInStep.yield (f x s)) =
      setX q0 (forIn (m := Id) l t fun x s => ForInStep.yield (f x s))
  | [], _, _, _ => rfl
  | x :: xs, f, t, hf => by
    simp only [List.forIn_cons]
    rw [hf]
    exact forIn_X xs f _ hf

theorem X_writeLE (a w v : Nat) : writeLE (setX q0 s) a w v = setX q0 (writeLE s a w v) := by
  unfold writeLE
  simp only [Id.run, Std.Legacy.Range.forIn_eq_forIn_range']
  exact forIn_X _ _ _ (fun _ _ => rfl)

theorem X_memFill (d v n : Nat) : memFill (setX q0 s) d v n = mapRes (setX q0) (memFill s d v n) := by
  unfold memFill
  rw [X_memBytes]
  split
  · rfl
  · simp only [Id.run, Std.Legacy.Range.forIn_eq_forIn_range']
    have := forIn_X (q0 := q0) (List.range' 0 [0:n].size 1)
      (fun i s => writeByte s (d + i) (UInt8.ofNat v)) s (fun _ _ => rfl)
    simp only [bind, pure] at this ⊢
    rw [this]; rfl

macro_rules | `(tactic| sx_step) => `(tactic| simp only [X_writeLE, X_memFill])

theorem X_memCopy (d src n : Nat) : memCopy (setX q0 s) d src n = mapRes (setX q0) (memCopy s d src n) := by
  unfold memCopy; sx

theorem X_memInit (seg d src n : Nat) : memInit (setX q0 s) seg d src n = mapRes (setX q0) (memInit s seg d src n) := by
  unfold memInit; sx

theorem X_tableInit (seg d src n : Nat) :
    tableInit (setX q0 s) seg d src n = mapRes (setX q0) (tableInit s seg d src n) := by
  unfold tableInit; sx

macro_rules | `(tactic| sx_step) => `(tactic| simp only [X_memCopy, X_memInit, X_tableInit])

theorem X_doReturn (p : Prepared) : doReturn p (setX q0 s) = mapRes (setX q0) (doReturn p s) := by
  unfold doReturn; sx

macro_rules | `(tactic| sx_step) => `(tactic| simp only [X_doReturn])

theorem X_doBr (p : Prepared) (f : Frame) (l : Nat) : doBr p (setX q0 s) f l = mapRes (setX q0) (doBr p s f l) := by
  unfold doBr; sx

macro_rules | `(tactic| sx_step) => `(tactic| simp only [X_doBr])

theorem X_enter (p : Prepared) (fi : Nat) : enter p (setX q0 s) fi = mapRes (setX q0) (enter p s fi) := by
  unfold enter; sx

macro_rules | `(tactic| sx_step) => `(tactic| simp only [X_enter])

theorem X_execNum (op : Nat) : execNum (setX q0 s) op = (execNum s op).map (setX q0) := by
  unfold execNum; sx

macro_rules | `(tactic| sx_step) => `(tactic| simp only [X_execNum])
macro_rules | `(tactic| sx_step) => `(tactic| first | rw [X_popN] | rw [X_popRef] | rw [X_popV])

theorem X_topCount : topCount (setX q0 s) = topCount s := rfl
end

set_option maxHeartbeats 10000000 in
/-- Every instruction but the two calls commutes with `setX q0`. -/
theorem X_exec (cfg : NearCfg) (p : Prepared) (s : St) (f : Frame) (pf : PFunc) (i : Instr)
    (h1 : ∀ fi, i ≠ .call fi) (h2 : ∀ ty y, i ≠ .callIndirect ty y) (q0 : St) :
    exec cfg p (setX q0 s) f pf i = mapRes (setX q0) (exec cfg p s f pf i) := by
  cases i with
  | call fi => exact absurd rfl (h1 fi)
  | callIndirect ty y => exact absurd rfl (h2 ty y)
  | _ => simp only [exec]; sx

end NearSpecV3.Successor.HostComm
