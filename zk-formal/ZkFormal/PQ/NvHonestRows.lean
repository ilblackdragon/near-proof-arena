import ZkFormal.PQ.NvDagEval
import ZkFormal.PQ.NvHonestExport

/-!
# ZkFormal.PQ.NvHonestRows — the honest NvAir trace as a `Trace`, and its row environments

Lane E (E2E M11g, item 1), 2026-11-04. Data: `NvHonestExport.lean` (generated by
`nv-export/nv_export.rs`, `nv_export_trace`: proved and verified by the backend before export).
The row checks (`rowOK`, all 548 exported constraints by `NvDagEval`) are split over
`NvHonestCheck{0..12}.lean` so that each Lean process stays small; `NvHonest.lean` assembles them.
-/

namespace ZkFormal.PQ.NvHonestRows

open ZkFormal.Air ZkFormal.Algebra ZkFormal.PQ.NvDagEval ZkFormal.PQ.NvHonestExport

/-- Row `r` of the honest trace (zero beyond `hUsed`). -/
def hRow (r : Nat) : List Nat := hRows.getD r []

/-- The honest trace (NvAir is table 0; the other tables are not exported). -/
def hTr : Trace Fp := ⟨fun _ => hLog, fun _ r c => (((hRow r).getD c 0 : Nat) : Fp)⟩

def hPubF : List Fp := hPub.map fun n => ((n : Nat) : Fp)

theorem hHeight : hTr.height 0 = 4096 := rfl

/-- The `Nat` environment of row `r`. -/
def hEnv (r : Nat) : Env :=
  ⟨hRow r, hRow ((r + 1) % 4096), hPub, if r = 0 then 1 else 0, if r + 1 = 4096 then 1 else 0,
    if r + 1 = 4096 then 0 else 1⟩

theorem hPub_getD (j : Nat) : hPubF.getD j 0 = ((hPub.getD j 0 : Nat) : Fp) := by
  simp only [hPubF, List.getD_eq_getElem?_getD, List.getElem?_map]
  cases hPub[j]? <;> rfl

theorem hAgrees (r : Nat) : RowAgrees (hEnv r) hTr 0 r hPubF := by
  refine ⟨fun c => rfl, fun c => rfl, hPub_getD, ?_, ?_, ?_⟩
  · simp only [hEnv]; split <;> rfl
  · simp only [hEnv, hHeight]
    by_cases h : r + 1 = 4096 <;> simp only [h, if_true, if_false] <;> rfl
  · simp only [hEnv, hHeight]
    by_cases h : r + 1 = 4096 <;> simp only [h, if_true, if_false] <;> rfl

end ZkFormal.PQ.NvHonestRows
