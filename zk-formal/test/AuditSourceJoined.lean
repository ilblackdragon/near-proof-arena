open ZkFormal.NearV3 ZkFormal.NearV3.Rcpt.Candidates
open ZkFormal.Near ZkFormal.Air ZkFormal.Algebra

private def leafBlock (j q L : Nat) (dup : Bool) : SrcpB :=
  { j, L, dup, root := List.replicate 32 0, qe := q, le := 32, ql := q,
    leaf := List.replicate 32 0, path := [] }

private def pathBlock (dir : Bool) : SrcpB :=
  { leafBlock 0 1 12 false with
    qe := 2, le := 64,
    path := [{q := 2, dir, sib := List.replicate 32 0, acc := List.replicate 32 0, pq := 1, pl := 32}] }

private def pairTrace (log : Nat) (bs : List SrcpB) (rep : Nat → Bool) : Trace Fp :=
  { log := fun _ => log,
    cell := fun t r x => Fp.ofNat
      (DedupRender.cell bs rep (if t=0 then r else 2^log-1+r) x) }

private def checkLocal (T : Table) (tr : Trace Fp) (t : Nat) : Bool :=
  (List.range (tr.height t)).all fun r =>
    T.constraints.all (fun e => decide (e.eval tr t r []=0)) &&
    T.interactions.all (fun it => it.mult.all
      (fun b => decide (b.eval tr t r []=0 ∨ b.eval tr t r []=1)))

private def checkJoin (log : Nat) (bs : List SrcpB) (rep : Nat → Bool) : Bool :=
  let tr := pairTrace log bs rep
  checkLocal (DedupPartitionTable.leftTable 64) tr 0 &&
  checkLocal (DedupPartitionTable.rightTable 64) tr 1 &&
  checkLocal (DedupTable.table 24) (DedupPartitionTable.joinedTrace tr 0 1) 0

-- The overlap is an internal leaf row; the right physical endpoint is padding.
/-- info: true -/
#guard_msgs in
#eval checkJoin 5 [leafBlock 0 1 12 false] (fun _ => false)

-- Both path directions and a repeated header cross physical windows.
/-- info: true -/
#guard_msgs in
#eval checkJoin 6 [pathBlock false] (fun _ => false)

/-- info: true -/
#guard_msgs in
#eval checkJoin 7 [pathBlock true, leafBlock 1 3 12 true, leafBlock 2 3 12 false]
  (fun j => decide (j<2))
