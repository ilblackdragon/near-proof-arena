      },
      {
        "id": "mainnet_params",
        "text": "chain_id = mainnet: mainnet RuntimeConfig for PV 86 (RuntimeConfigStore::new(None))"
      },
      {
        "id": "claim_wf",
        "text": "all claim fields within their encoded widths (u16/u32/u64/u128, 32-byte hashes, chain id 1..64 printable ASCII)"
      },
      {
        "id": "batch_size",
        "text": "the batch has 1..=256 receipts"
      },
      {
        "id": "compute_limit",
        "text": "(n-1)*223182562500 < gas_limit: no receipt is pushed to the delayed queue"
      },
      {
        "id": "receipt_shape",
        "text": "every receipt is Receipt::V0 / ReceiptEnum::Action with exactly one Transfer action and no input/output data dependencies"
      },
      {
        "id": "valid_account_ids",
        "text": "predecessor, receiver and signer are valid NEAR AccountIds"
      },
      {
        "id": "signer_key_type",
        "text": "signer public key is ED25519 or SECP256K1"
      },
      {
        "id": "not_system_predecessor",
        "text": "predecessor is not 'system' (refund receipts are not inputs)"
      },
      {
        "id": "named_receiver",
        "text": "receiver is a NamedAccount (not NEAR-implicit, ETH-implicit or deterministic)"
      },
      {
        "id": "distinct_receipt_ids",
        "text": "receipt ids are pairwise distinct"
      },
      {
        "id": "witness_size",
        "text": "the revealed partial-trie bytes (receivers' Account paths and the path to key 0x0f) are <= 3,000,000"
      },
      {
        "id": "receiver_exists_v1",
        "text": "each receiver Account exists when its receipt is applied and is a 72-byte AccountV1"
      },
      {
        "id": "no_balance_overflow",
        "text": "amount+deposit <= 2^128-2 and amount'+locked < 2^128"
      },
      {
        "id": "storage_stake",
        "text": "after the credit, amount'+locked >= 10^19*storage_usage or storage_usage <= 770"
      },
      {
        "id": "burn_fits_u128",
        "text": "G*min(gas_price, block_gas_price), G*(gas_price-min) and the total tokens burnt fit in u128"
      },
      {
        "id": "single_shard_layout",
        "text": "the epoch's shard layout has exactly one shard, shard_id, and shard_id < 2^32 (NOT the case on multi-shard mainnet)"
      },
      {
        "id": "zero_congestion",
        "text": "the shard's CongestionInfoV1 in the block has delayed_receipts_gas = buffered_receipts_gas = receipt_bytes = 0"
      },
      {
        "id": "no_bandwidth_requests",
        "text": "the block carries no bandwidth requests"
      },
      {
        "id": "scheduler_state_decodes",
        "text": "an existing TrieKey::BandwidthSchedulerState (0x0f) value is a valid borsh BandwidthSchedulerState"
      },
      {
        "id": "refund_needs_grant",
        "text": "if missed_chunks_count > 0 (link (S,S) not allowed, no bandwidth granted) no receipt generates a gas refund"
      },
      {
        "id": "apply_context",
        "text": "the chunk applies only these incoming receipts: no transactions, no local/delayed/yield/buffered receipts, no validator-account update, new chunk"
      }
