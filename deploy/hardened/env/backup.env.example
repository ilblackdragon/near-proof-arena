# /etc/arena/backup.env  (root:arena-backup 0640)
ARENA_BACKUP_DIR=/var/backups/arena
ARENA_BACKUP_AGE_RECIPIENTS=/etc/arena/backup-recipients.txt   # age public keys; private key is offline
ARENA_BACKUP_DB=arena
ARENA_BACKUP_OBJECTS_DIR=/var/lib/arena/objects
ARENA_BACKUP_KEEP_DAILY=35
ARENA_BACKUP_KEEP_MONTHLY=13
