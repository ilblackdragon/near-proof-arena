# /etc/arena/worker-<class>.env  (root:arena-worker 0640), one class per host.
# The unit forces ARENA_ENV=production and ARENA_SANDBOX=firecracker; arena-guard
# refuses ARENA_DEV_UNSAFE, bwrap-dev, report keys and admin tokens here.
ARENA_SERVER_URL=https://10.20.0.10:8472
ARENA_WORKER_TOKEN=CHANGE_ME
# Workers never hold database credentials (arena-worker refuses to start if it
# can see any). Job leasing goes through the worker API above.
# Firecracker assets (kernel, rootfs, fc-runner image id) from deploy/images:
ARENA_FC_DEPS=/var/lib/arena/firecracker
ARENA_WORK_DIR=/var/lib/arena-worker/work
# Pinned build toolchain image (deploy/images/toolchain) and lean-checker images:
ARENA_IMAGES_DIR=/var/cache/arena-worker/toolchain-images
#ARENA_BUILD_TOOLCHAIN_IMAGE=sha256:...
ARENA_LEAN_CHECKER_IMAGES=/var/cache/arena-worker/lean-checker-images
# Formal checking (class formal): judge configs + the frozen trusted-tree store
# (`arena-admin freeze-trusted`; the reference is built only from the tree each
# challenge pins, re-hashed per job; docs/TCB.md). ARENA_FORMAL_REPO is refused.
#ARENA_FORMAL_CONFIGS_DIR=/var/lib/arena/repo/runners/formal-checker/challenges
#ARENA_TRUSTED_TREES=/var/lib/arena/trusted-trees
# Judge oracle and verifiers
#ARENA_NEAR_ORACLE=/usr/local/lib/arena/near-arena-oracle
#ARENA_WORKLOAD_GENERATORS=/var/lib/arena/repo/spec/workloads/near-transfer-receipt-v1
#ARENA_FIXTURES_DIRS=/var/lib/arena/repo/oracle/fixtures/public
#ARENA_NPAI_VERIFY=/usr/local/lib/arena/npai-verify   # static (musl) build
#ARENA_INTERP_REF=/usr/local/lib/arena/arena-interp-ref
RUST_LOG=info
