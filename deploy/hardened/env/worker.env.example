# /etc/arena/worker-<class>.env  (root:arena-worker 0640), one class per host.
# The unit forces ARENA_ENV=production and ARENA_SANDBOX=firecracker; arena-guard
# refuses ARENA_DEV_UNSAFE, bwrap-dev, report keys and admin tokens here.
ARENA_SERVER_URL=https://10.20.0.10:8472
ARENA_WORKER_TOKEN=CHANGE_ME
# Only if direct Postgres job leasing is kept (CONTRACTS.md §9):
#ARENA_WORKER_DATABASE_URL=postgres://arena_worker:CHANGE_ME@10.20.0.20:5432/arena?sslmode=verify-full
ARENA_FIRECRACKER_BIN=/usr/local/lib/arena/firecracker
ARENA_IMAGES_DIR=/var/cache/arena-worker/images   # rootfs/kernel by digest (deploy/images, runners-vm lane)
RUST_LOG=info
