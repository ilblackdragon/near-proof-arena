# /etc/arena/server.env  (root:arena-server 0640). Never commit real values.
# ARENA_ENV is forced to "production" by the unit; arena-guard verifies.
ARENA_BIND_ADDR=127.0.0.1:8471                # public traffic arrives via the TLS reverse proxy
ARENA_WORKER_API_BIND_ADDR=10.20.0.10:8472    # internal worker API (workers' only reachable endpoint)
ARENA_DATABASE_URL=postgres://arena_api:CHANGE_ME@10.20.0.20:5432/arena?sslmode=verify-full
ARENA_OBJECT_STORE_DIR=/var/lib/arena/objects
ARENA_CHALLENGES_DIR=/opt/arena/challenges
# Frozen trusted trees (arena-admin freeze-trusted): REQUIRED in production; a
# non-demo challenge registers only if the tree it pins is published here.
ARENA_TRUSTED_TREES=/var/lib/arena/trusted-trees
# Token variable names: see docs/DEPLOYMENT.md "Environment contract".
ARENA_ADMIN_TOKEN_SHA256=CHANGE_ME           # server stores/compares hashes only
ARENA_WORKER_TOKEN_SHA256=CHANGE_ME
RUST_LOG=info
# ARENA_REPORT_SIGNING_KEY_FILE is set by the unit from a systemd credential.
