# Nightly snapshot of the content-addressed object store (control-plane host).
# Runs as arena-server (the store owner) with the store mounted read-only.
[Unit]
Description=NEAR Proof Arena object store backup
After=arena-server.service

[Service]
Type=oneshot
User=arena-server
Group=arena-server
EnvironmentFile=/etc/arena/backup.env
ExecStart=/usr/local/lib/arena/arena-backup objects
StateDirectory=arena-backup
UMask=0077
Nice=10
IOSchedulingClass=idle

NoNewPrivileges=yes
CapabilityBoundingSet=
ProtectSystem=strict
ReadOnlyPaths=/var/lib/arena/objects
ReadWritePaths=/var/backups/arena
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
IPAddressDeny=169.254.0.0/16 fd00:ec2::254/128
