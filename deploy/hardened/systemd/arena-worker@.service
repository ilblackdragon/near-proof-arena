# NEAR Proof Arena worker. Instance name = worker class:
#   arena-worker@build  arena-worker@formal  arena-worker@oracle
#   arena-worker@bench  arena-worker@gpu
# One class per host (no co-tenancy across classes; see docs/DEPLOYMENT.md).
# Untrusted code runs only inside the firecracker microVM sandbox.
#
# Network: IPAddressDeny=any below; each host adds exactly the control plane's
# internal worker API in /etc/systemd/system/arena-worker@.service.d/10-network.conf
# (see 10-network.conf.example). Without that drop-in the worker cannot reach
# anything, i.e. it fails closed.
[Unit]
Description=NEAR Proof Arena worker (%i)
Wants=network-online.target
After=network-online.target nftables.service
Requires=nftables.service
ConditionPathExists=/etc/arena/worker-%i.env

[Service]
Type=simple
User=arena-worker
Group=arena-worker
SupplementaryGroups=kvm
EnvironmentFile=/etc/arena/worker-%i.env
Environment=ARENA_ENV=production
Environment=ARENA_SANDBOX=firecracker
Environment=ARENA_WORKER_CLASS=%i
# Refuses ARENA_DEV_UNSAFE, bwrap-dev, dev secrets, report keys, admin tokens.
ExecStartPre=/usr/local/lib/arena/arena-guard worker
ExecStart=/usr/local/bin/arena-worker --class %i
Restart=on-failure
RestartSec=5s

StateDirectory=arena-worker/%i
StateDirectoryMode=0700
CacheDirectory=arena-worker/%i
RuntimeDirectory=arena-worker-%i
WorkingDirectory=/var/lib/arena-worker/%i
UMask=0077

# --- hardening -----------------------------------------------------------
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
# /dev/kvm is the only device node beyond the pseudo devices.
PrivateDevices=no
DevicePolicy=closed
DeviceAllow=/dev/kvm rw
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
# AF_UNIX: firecracker API / vsock sockets. AF_INET*: control plane only (IPAddressAllow).
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
# If the runners-vm lane adopts the firecracker jailer, it ships a drop-in
# that relaxes exactly what the jailer needs (namespaces, chroot); never
# relax these on a host-wide basis.
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
KeyringMode=private
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @mount @debug @cpu-emulation @obsolete
SystemCallErrorNumber=EPERM
IPAddressDeny=any

LimitNOFILE=65536
TasksMax=8192

[Install]
WantedBy=multi-user.target
