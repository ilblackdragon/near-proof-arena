# NEAR Proof Arena control plane (API + internal worker API + report signing).
# Runs ONLY on the control-plane host. See docs/DEPLOYMENT.md.
[Unit]
Description=NEAR Proof Arena control plane (arena-server)
Documentation=file:///opt/arena/docs/DEPLOYMENT.md
Wants=network-online.target
After=network-online.target nftables.service
Requires=nftables.service

[Service]
Type=simple
User=arena-server
Group=arena-server
EnvironmentFile=/etc/arena/server.env
Environment=ARENA_ENV=production
# The report signing key exists only on this host and is handed to the
# service as a systemd credential (0400, owned by the service user, never in
# the environment). Source file: /etc/arena/credentials/report-signing-key.pem (root 0400).
LoadCredential=report-signing-key:/etc/arena/credentials/report-signing-key.pem
Environment=ARENA_REPORT_SIGNING_KEY_FILE=%d/report-signing-key
ExecStartPre=/usr/local/lib/arena/arena-guard server
ExecStart=/usr/local/bin/arena-server serve
Restart=on-failure
RestartSec=2s

StateDirectory=arena arena/objects
StateDirectoryMode=0700
RuntimeDirectory=arena-server
WorkingDirectory=/var/lib/arena
UMask=0077

# --- hardening -----------------------------------------------------------
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
DevicePolicy=closed
PrivateUsers=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
KeyringMode=private
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources @mount @debug @cpu-emulation @obsolete
SystemCallErrorNumber=EPERM
# Cloud metadata endpoints are never reachable (defence in depth with nftables).
IPAddressDeny=169.254.0.0/16 fd00:ec2::254/128
ReadOnlyPaths=/etc/arena
InaccessiblePaths=-/etc/arena/credentials

LimitNOFILE=65536
TasksMax=4096
MemoryMax=8G

[Install]
WantedBy=multi-user.target
