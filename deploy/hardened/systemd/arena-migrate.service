# One-shot schema migration as the schema owner role, followed by the
# least-privilege table grants. Run explicitly on deploy:
#   systemctl start arena-migrate.service && systemctl restart arena-server
# The running server (arena-server.service) never holds owner credentials.
[Unit]
Description=NEAR Proof Arena database migrations (owner role)
Wants=network-online.target
After=network-online.target nftables.service
Before=arena-server.service

[Service]
Type=oneshot
User=arena-migrate
Group=arena-migrate
EnvironmentFile=/etc/arena/migrate.env
Environment=ARENA_ENV=production
ExecStart=/usr/local/bin/arena-server migrate
ExecStart=/usr/bin/psql --no-psqlrc -v ON_ERROR_STOP=1 -d ${ARENA_MIGRATE_DATABASE_URL} -f /usr/local/share/arena/sql/grants.sql
UMask=0077

NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
DevicePolicy=closed
PrivateUsers=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources @mount @debug @cpu-emulation @obsolete
IPAddressDeny=169.254.0.0/16 fd00:ec2::254/128
