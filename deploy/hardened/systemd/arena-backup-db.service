# Nightly logical backup of the arena database (runs on the DB host).
[Unit]
Description=NEAR Proof Arena database backup
After=postgresql.service

[Service]
Type=oneshot
User=arena-backup
Group=arena-backup
EnvironmentFile=/etc/arena/backup.env
ExecStart=/usr/local/lib/arena/arena-backup db
StateDirectory=arena-backup
UMask=0077
Nice=10
IOSchedulingClass=idle

NoNewPrivileges=yes
CapabilityBoundingSet=
ProtectSystem=strict
ReadWritePaths=/var/backups/arena
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
IPAddressDeny=169.254.0.0/16 fd00:ec2::254/128
