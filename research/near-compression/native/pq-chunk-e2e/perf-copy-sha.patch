+    /// Same message encoding as the flat path, without a temporary field buffer.
+    fn hash_leaves_rows<'a, R>(&self, n: usize, row_len: usize, rows_per_leaf: usize, row: R) -> Vec<Digest>
+    where R: Fn(usize, usize) -> &'a [F] {
+        let per = row_len * rows_per_leaf;
+        if !crate::sha384::mb::mb_enabled() || per == 0 {
+            let leaves: Vec<Vec<Vec<F>>> = (0..n)
+                .map(|leaf| (0..rows_per_leaf).map(|r| row(leaf, r).to_vec()).collect()).collect();
+            return self.hash_coset_batch(&leaves);
