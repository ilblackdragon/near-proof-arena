+
+    /// Hash leaves directly from borrowed rows, in the same leaf/row order as
+    /// `hash_leaves_flat`. The default preserves compatibility with other hashers.
+    fn hash_leaves_rows<'a, R>(&self, n: usize, row_len: usize, rows_per_leaf: usize, row: R) -> Vec<Self::Digest>
+    where R: Fn(usize, usize) -> &'a [Self::F] {
+        let mut flat = Vec::with_capacity(n * row_len * rows_per_leaf);
+        for leaf in 0..n {
+            for r in 0..rows_per_leaf {
+                let values = row(leaf, r);
+                assert_eq!(values.len(), row_len);
+                flat.extend_from_slice(values);
+            }
+        }
+        self.hash_leaves_flat(&flat, row_len, rows_per_leaf)
     }
