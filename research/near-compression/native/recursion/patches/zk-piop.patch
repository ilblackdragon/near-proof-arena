+                        wm[x] += prover.eq_ns[round - 1] * mu_zc[t] * zc
+                            + prover.eq_sharp_ns[round - 1] * (num + mu * den);
+                    }
+                } else {
+                    for i in 0..d {
+                        u_zc[i] += mu_zc[t] * sp_round_evals[zc_idx][i];
+                        u_lg[i] += sp_round_evals[numer_idx][i] + mu * sp_round_evals[denom_idx][i];
+                    }
+                }
+            } else {
+                sp_tail += mu_zc[t] * sp_round_evals[zc_idx][0]
+                    + sp_round_evals[numer_idx][0]
+                    + mu * sp_round_evals[denom_idx][0];
+            }
+        }
+        // U (unmasked head, degree d) at 1..=d; head(0) from the claim; U(0) = head(0) - Wm(0)
+        let mut u = vec![EF::<SC>::ZERO; d + 1];
+        for i in 0..d {
+            u[i + 1] = prover.eq_ns[round - 1] * u_zc[i] + prover.eq_sharp_ns[round - 1] * u_lg[i];
+        }
+        let xi_cur = xi_r(round);
+        let head1 = u[1] + wm[1];
+        let head0 = (prover.prev_s_eval - xi_cur * head1 - sp_tail) * (one - xi_cur).inverse();
+        u[0] = head0 - wm[0];
+        let head_evals: Vec<EF<SC>> = (0..=deg)
+            .map(|x| {
+                let ux = if x <= d { u[x] } else { interpolate_at(&u, EF::<SC>::from_usize(x)) };
+                ux + if doubled { wm[x] } else { EF::<SC>::ZERO }
+            })
+            .collect();
+        let sp_head = UnivariatePoly::lagrange_interpolate(
+            &(0..=deg).map(SC::F::from_usize).collect_vec(),
+            &head_evals,
+        );
+        let batch_s = {
+            let mut coeffs = sp_head.into_coeffs();
+            coeffs.resize(deg + 1, EF::<SC>::ZERO);
+            coeffs.push(EF::<SC>::ZERO);
+            let b = one - xi_cur;
+            let a = xi_cur - b;
+            for i in (0..=deg).rev() {
+                coeffs[i + 1] = a * coeffs[i] + b * coeffs[i + 1];
+            }
+            coeffs[0] *= b;
+            coeffs[1] += sp_tail;
+            UnivariatePoly::new(coeffs)
+        };
+        // Libra mask round polynomial (eq1 factor kept, so Gruen still applies)
+        let hi = &hs[ri];
+        let c0 = rho_b * h0_r0 + e0 * (rho_b * (hpre + suffix[ri + 1]) + m_k);
+        let mask_at = |x: EF<SC>| eqpre * eq1(xi_cur, x) * (c0 + e0 * rho_b * horner(hi, x));
+        let mut evals = (1..=s_deg_r)
+            .map(|i| {
+                let x = EF::<SC>::from_usize(i);
+                batch_s.eval_at_point(x) + mask_at(x)
+            })
+            .collect_vec();
