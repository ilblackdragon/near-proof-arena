+        let (_, deg) = lay.h[ri];
+        let doubled = lay.doubled[ri];
+        let s_deg_r = deg + 1;
+        let sp_round_evals = prover.sumcheck_polys_eval(round, r[round - 1]);
+        let tail_start = prover
+            .n_per_trace
+            .iter()
+            .find_position(|&&n| round as isize > n)
+            .map(|(i, _)| i)
