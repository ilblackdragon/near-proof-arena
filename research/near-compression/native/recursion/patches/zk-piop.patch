+//! [E2E-D zk-piop] PIOP-level masking of a proof (`WhirLevers::zk >= 4`): definitions shared by
+//! the prover and the verifier. Construction, simulator and error bounds:
+//! `research/near-compression/e2e/ZK-ARGUMENT.md` (§4).
+//!
+//! Every mask is an extension-field coefficient stored in `D = [EF : F]` base-field cells of the
+//! last mask column `M_s` of the common-main stacked matrix (cells are uniform: `zk_fill`).
+//! Coefficient `k` occupies stacked rows `COEF_STRIDE * k + b`, `b < D`. A *sparse claim* is a
+//! linear relation `Σ w_i · coef[c_i] = value` that the stacking reduction proves together with
+//! the column-opening claims (the extra weight on `M_s` is `Σ w_i Σ_b β_b δ_{row(c_i, b)}`).
+//!
+//! Masks (all coefficients uniform, fixed by the commitment, i.e. before every challenge):
+//! * GKR (`GkrZkLayout`): root sumcheck mask `g_R` (degree 4), level-1 masks `α_1 = (α^p, α^q)`,
+//!   layer-1 Libra mask `h_1` (degree 5), level masks `α_k` (4 coefficients: `p(b=0), q(b=0),
+//!   p(b=1), q(b=1)`) for `k = 2..=K`, layer Libra masks `h_k = Σ_i h_{k,i}(y_i)` (`deg h_{k,i} =
+//!   2`, last variable 4) for `k = 2..K`.
+//! * Batch sumcheck (`BatchZkLayout`): `h_0` (uni-skip round, degree `s_0_deg`), `h_i` per
+//!   multilinear round (degree `d` or `2d` in rounds where some AIR binds its last variable), and
+//!   one column mask `A` per column opening (main and rotated).
+//! * Stacking: two whole mask columns `M_1, M_2` weighted by `eq_prism(τ_j, ·)` (Libra mask with
+//!   committed-column masks; their openings at `u` are ordinary stacked openings).
+use itertools::Itertools;
+use p3_field::{BasedVectorSpace, ExtensionField, Field, PrimeCharacteristicRing, TwoAdicField};
+
+use crate::poly_common::{eval_eq_mle, eval_eq_uni};
+
+/// Rows per mask coefficient in `M_s` (`>= [EF : F]`, a power of two).
+pub const COEF_STRIDE: usize = 16;
+pub const LOG_COEF_STRIDE: usize = 4;
+
+/// `(M_s, M_1, M_2)`: indices of the mask columns used by the PIOP masks in a common-main stacked
+/// layout of `width` columns (the last three of the `ZK_MASK_COLS` appended columns).
+pub fn mask_columns(width: usize) -> (usize, usize, usize) {
+    (width - 1, width - 2, width - 3)
+}
+
+/// [E2E-D zk-batch] `zk = 6`: `(M_s, M_1, M_2)` with `M_1`, `M_2` extension-field columns, each
+/// the `D = [EF : F]` consecutive base columns starting at the returned index
+/// (`M_j = Σ_b e_b · col[start_j + b]`, `e_b` the basis of [`BasedVectorSpace`]). Appended order:
+/// `ZK_MASK_COLS` pure pad columns, `M_2`, `M_1`, `M_s` (`config::WhirLevers::zk_shape`).
+pub fn mask_columns_ef(width: usize, d: usize) -> (usize, usize, usize) {
+    (width - 1, width - 1 - d, width - 1 - 2 * d)
+}
+
+/// [E2E-D zk-batch] The extension-field column `Σ_b e_b · cols[b]` (`cols.len() = [EF : F]`).
+pub fn ef_column<F: Field, EF: BasedVectorSpace<F> + Send + Sync>(cols: &[&[F]]) -> Vec<EF>
+where
+    F: Send + Sync,
+{
+    use p3_maybe_rayon::prelude::*;
+    assert_eq!(cols.len(), <EF as BasedVectorSpace<F>>::DIMENSION);
+    let n = cols[0].len();
+    (0..n).into_par_iter().map(|x| EF::from_basis_coefficients_fn(|b| cols[b][x])).collect()
+}
+
+/// `Σ w_i · coef[c_i] = value`.
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub struct SparseClaim<EF> {
+    pub terms: Vec<(usize, EF)>,
+    pub value: EF,
+}
+
+/// `(start + j, scale · x^j)` for `j = 0..=deg`: the weights of `scale · h(x)` for the univariate
+/// `h` with coefficients `coef[start..=start + deg]` (ascending powers).
+pub fn poly_terms<EF: Field>(start: usize, deg: usize, x: EF, scale: EF) -> Vec<(usize, EF)> {
+    let mut out = Vec::with_capacity(deg + 1);
+    let mut p = scale;
+    for j in 0..=deg {
+        out.push((start + j, p));
+        p *= x;
+    }
+    out
+}
+
+pub fn horner<EF: Field>(coefs: &[EF], x: EF) -> EF {
+    coefs.iter().rev().fold(EF::ZERO, |acc, &c| acc * x + c)
+}
+
+/// Value at `x` of the polynomial through `(k, evals[k])`, `k = 0..evals.len()`.
+pub fn interpolate_at<EF: Field>(evals: &[EF], x: EF) -> EF {
+    let n = evals.len();
+    let mut acc = EF::ZERO;
+    for (i, &v) in evals.iter().enumerate() {
+        let mut num = EF::ONE;
+        let mut den = EF::ONE;
+        for j in 0..n {
+            if j != i {
+                num *= x - EF::from_usize(j);
+                den *= EF::from_usize(i) - EF::from_usize(j);
+            }
+        }
+        acc += v * num * den.inverse();
+    }
+    acc
+}
+
+/// `eq1(a, x) = (1 - a)(1 - x) + a x`.
+pub fn eq1<EF: Field>(a: EF, x: EF) -> EF {
+    (EF::ONE - a) * (EF::ONE - x) + a * x
+}
+
+/// Mask coefficients of the GKR (`K = total_rounds >= 2`).
+#[derive(Clone, Debug)]
+pub struct GkrZkLayout {
+    pub total_rounds: usize,
+    pub g_root: usize,
+    pub alpha1: usize,
+    pub h1: usize,
+    /// `alpha[k]`: start of `α_k` (4 coefficients), `k = 2..=K` (entries 0, 1 unused).
+    pub alpha: Vec<usize>,
+    /// `h[k]`: start of `h_k`, `k = 2..K` (entries 0, 1 unused).
+    pub h: Vec<usize>,
+    pub end: usize,
+}
+
+impl GkrZkLayout {
+    pub const ROOT_DEG: usize = 4;
+    pub const H1_DEG: usize = 5;
+
+    pub fn new(start: usize, total_rounds: usize) -> Self {
+        assert!(total_rounds >= 2, "zk GKR needs at least two layers");
+        let mut next = start;
+        let mut take = |n: usize| {
+            let s = next;
+            next += n;
+            s
+        };
+        let g_root = take(Self::ROOT_DEG + 1);
+        let alpha1 = take(2);
+        let h1 = take(Self::H1_DEG + 1);
+        let mut alpha = vec![0; total_rounds + 1];
+        let mut h = vec![0; total_rounds];
+        alpha[2] = take(4);
+        for k in 2..total_rounds {
+            h[k] = take(Self::h_len(k));
+            alpha[k + 1] = take(4);
+        }
+        Self { total_rounds, g_root, alpha1, h1, alpha, h, end: next }
+    }
+
+    /// Degree of `h_{k,i}` (variable `i` of layer `k`'s sumcheck, `k >= 2`).
+    pub fn h_deg(k: usize, i: usize) -> usize {
+        if i + 1 == k {
+            4
+        } else {
+            2
+        }
+    }
+
+    pub fn h_len(k: usize) -> usize {
+        (0..k).map(|i| Self::h_deg(k, i) + 1).sum()
+    }
+
+    /// Start of `h_{k,i}`.
+    pub fn h_start(&self, k: usize, i: usize) -> usize {
+        self.h[k] + 3 * i
+    }
+
+    /// Length of `GkrProof::zk`: `[G_R, s_R(1..=4)]`, layer 1 `[H_1, s(3), s(4), s(5)]`, layers
+    /// `k >= 2` `[H_k, s_last(3), s_last(4)]`.
+    pub fn tail_len(total_rounds: usize) -> usize {
+        5 + 4 + 3 * (total_rounds - 2)
+    }
+
+    pub fn tail_layer(k: usize) -> usize {
+        if k == 1 {
+            5
+        } else {
+            9 + 3 * (k - 2)
+        }
+    }
+}
+
+/// Mask coefficients of the batch sumcheck.
+#[derive(Clone, Debug)]
+pub struct BatchZkLayout {
+    pub h0: usize,
+    pub s0_deg: usize,
+    /// Per multilinear round `1..=n_max` (index `round - 1`): `(start, degree)` of `h_round`.
+    pub h: Vec<(usize, usize)>,
+    /// Per round: true if some trace binds its last variable there (degree `2d`).
+    pub doubled: Vec<bool>,
+    /// Start of the column masks: one coefficient per entry of `column_openings[t][0]`, in order.
+    pub cols: usize,
+    pub end: usize,
+}
+
+impl BatchZkLayout {
+    /// `n_lift_per_trace`: `max(n, 0)` per present trace (sorted order); `d` the max constraint
+    /// degree; `num_openings`: entries of `column_openings[t][0]` summed over traces.
+    pub fn new(
+        start: usize,
+        s0_deg: usize,
+        n_max: usize,
+        d: usize,
+        n_lift_per_trace: &[usize],
+        num_openings: usize,
+    ) -> Self {
+        let mut next = start;
+        let h0 = next;
+        next += s0_deg + 1;
+        let doubled = (1..=n_max).map(|i| n_lift_per_trace.contains(&i)).collect_vec();
+        let h = doubled
+            .iter()
+            .map(|&dbl| {
+                let deg = if dbl { 2 * d } else { d };
+                let s = next;
+                next += deg + 1;
+                (s, deg)
+            })
+            .collect_vec();
+        let cols = next;
+        next += num_openings;
+        Self { h0, s0_deg, h, doubled, cols, end: next }
+    }
+
+    /// Length of `BatchConstraintProof::zk`: `G_b` then `d` evaluations per doubled round.
+    pub fn tail_len(&self, d: usize) -> usize {
+        1 + d * self.doubled.iter().filter(|&&b| b).count()
+    }
+}
+
+/// Prover view of the mask coefficients: the base-field cells of `M_s`.
+pub struct MaskCoefs<'a, F> {
+    pub col: &'a [F],
+}
+
+impl<F: Field> MaskCoefs<'_, F> {
+    pub fn get<EF: BasedVectorSpace<F>>(&self, k: usize) -> EF {
+        EF::from_basis_coefficients_fn(|b| self.col[COEF_STRIDE * k + b])
+    }
+
+    pub fn poly<EF: BasedVectorSpace<F>>(&self, start: usize, deg: usize) -> Vec<EF> {
+        (start..=start + deg).map(|k| self.get(k)).collect()
+    }
+
+    /// `Σ w · coef` of a claim's terms.
+    pub fn eval_terms<EF: BasedVectorSpace<F> + Field>(&self, terms: &[(usize, EF)]) -> EF {
+        terms.iter().map(|&(k, w)| w * self.get::<EF>(k)).sum()
+    }
+}
+
+/// Stacked row of base cell `b` of coefficient `k`.
+pub fn coef_row(k: usize, b: usize) -> usize {
+    COEF_STRIDE * k + b
+}
+
+/// Accumulate per-coefficient weights `Σ scale · w_i` of a claim list into `acc`.
+pub fn accumulate_terms<EF: Field>(acc: &mut Vec<EF>, terms: &[(usize, EF)], scale: EF) {
+    for &(k, w) in terms {
+        if k >= acc.len() {
+            acc.resize(k + 1, EF::ZERO);
+        }
+        acc[k] += scale * w;
+    }
+}
+
+/// Verifier: the stacking-reduction coefficient of `M_s` at the stacking point `u` (`u[0]` the
+/// skip variable, `u[1..]` the cube variables, low row bits first) for per-coefficient weights
+/// `w`: `Σ_k w_k Σ_{b < D} β_b δ_{coef_row(k, b)}(u)`, where `δ_row(u) = eq_D(u_0, ω^z)·eq(u_cube,
+/// bits(row >> l_skip))`, `z = row mod 2^l_skip`.
+pub fn ms_coefficient<F, EF>(l_skip: usize, u: &[EF], w: &[EF]) -> EF
+where
+    F: TwoAdicField,
+    EF: ExtensionField<F> + TwoAdicField,
+{
+    assert!(l_skip <= LOG_COEF_STRIDE);
+    let omega = F::two_adic_generator(l_skip);
+    let d = <EF as BasedVectorSpace<F>>::DIMENSION;
+    let lo_bits = LOG_COEF_STRIDE - l_skip;
+    // Γ = Σ_{b<D} β_b · L_{b mod 2^l}(u_0) · eq(u[1..=lo_bits], b >> l)
+    let mut gamma = EF::ZERO;
+    for b in 0..d {
+        let z = b & ((1 << l_skip) - 1);
+        let hi = b >> l_skip;
+        let bits = (0..lo_bits).map(|j| EF::from_bool((hi >> j) & 1 == 1)).collect_vec();
+        let lz = eval_eq_uni(l_skip, u[0], EF::from(omega.exp_u64(z as u64)));
+        let e = eval_eq_mle(&u[1..=lo_bits], &bits);
+        gamma += EF::ith_basis_element(b).unwrap() * lz * e;
+    }
+    // Σ_k w_k eq(u[lo_bits+1..], bits(k))
+    let hi_vars = &u[lo_bits + 1..];
+    let nbits = (usize::BITS - w.len().saturating_sub(1).leading_zeros()) as usize;
+    assert!(nbits <= hi_vars.len(), "mask coefficients exceed the mask column");
+    let table = crate::poly_common::evals_eq_hypercube_serial(&hi_vars[..nbits]);
+    let tail = hi_vars[nbits..].iter().fold(EF::ONE, |a, &x| a * (EF::ONE - x));
+    let s: EF = w.iter().zip(&table).map(|(&a, &b)| a * b).sum();
+    gamma * s * tail
+}
