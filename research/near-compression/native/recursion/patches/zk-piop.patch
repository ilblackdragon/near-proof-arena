+        r.push(r_round);
+        prover.prev_s_eval = batch_s.eval_at_point(r_round);
+        hpre += horner(hi, r_round);
+        eqpre *= eq1(xi_cur, r_round);
+        prover.fold_mle_evals(round, r_round);
+        if doubled {
+            let z = r_round * (one - r_round);
+            for t in (0..num_traces).filter(|&t| n_lifts[t] == round) {
+                for (mat, mask) in prover.mat_evals_per_trace[t].iter_mut().zip(&mat_masks[t]) {
+                    debug_assert_eq!(mat.values.len(), mask.len());
+                    for (v, &a) in mat.values.iter_mut().zip(mask) {
+                        *v += z * a;
+                    }
+                }
+            }
+        }
+    }
+    assert_eq!(r.len(), n_max + 1);
+    let column_openings = prover.into_column_openings();
+    for (helper, openings) in prover.eval_helpers.iter().zip(column_openings.iter()) {
+        for (claim, claim_rot) in column_openings_by_mask(&openings[0], &helper.rot_masks[0]) {
+            transcript.observe_ext(claim);
+            transcript.observe_ext(claim_rot);
+        }
+    }
+    // sparse claim V_b and the column masks
+    let e_y = eqpre;
+    let mut terms = poly_terms(lay.h0, s_0_deg, r_0, rho_b * e_y);
+    for (i, &(start, deg)) in lay.h.iter().enumerate() {
+        terms.extend(poly_terms(start, deg, r[i + 1], rho_b * e_y * e0));
+    }
+    let w = e_y * e0 * gkr_out.z;
+    terms.extend([
+        (gkr_out.alpha, w * (one - gkr_out.mu)),
+        (gkr_out.alpha + 1, w * (one - gkr_out.mu) * mu),
+        (gkr_out.alpha + 2, w * gkr_out.mu),
+        (gkr_out.alpha + 3, w * gkr_out.mu * mu),
+    ]);
+    let value = e_y * (rho_b * h0_r0 + e0 * (rho_b * hpre + m_k));
+    debug_assert_eq!(value, coefs.eval_terms(&terms), "zk V_b");
+    let mut claims = gkr_out.claims;
+    claims.push(SparseClaim { terms, value });
+    for (t, ks) in col_coefs.iter().enumerate() {
+        let z = r[n_lifts[t]] * (one - r[n_lifts[t]]);
+        col_masks.push(ks.iter().map(|&(k, masked)| (k, if masked { z } else { EF::<SC>::ZERO })).collect());
+    }
+    ZK_HANDOFF.with(|c| *c.borrow_mut() = Some(Box::new(ZkHandoff::<EF<SC>> { claims, col_masks })));
+
+    let batch_constraint_proof = BatchConstraintProof::<SC> {
+        numerator_term_per_air: vec![],
+        denominator_term_per_air: vec![],
+        univariate_round_coeffs: s_0_total,
+        sumcheck_round_polys,
+        column_openings,
+        zk: zk_tail,
+    };
+    let gkr_proof = GkrProof::<SC> {
+        logup_pow_witness,
+        q0_claim: EF::<SC>::ZERO,
+        claims_per_layer: frac_sum_proof.claims_per_layer,
+        sumcheck_polys: frac_sum_proof.sumcheck_polys,
+        zk: gkr_out.tail,
+    };
+    Ok((gkr_proof, batch_constraint_proof, r))
+}
