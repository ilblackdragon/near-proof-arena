+#[allow(clippy::too_many_arguments)]
+fn finish_zerocheck_and_logup_zk<'a, SC: StarkProtocolConfig, TS>(
+    transcript: &mut TS,
+    mpk: &'a DeviceMultiStarkProvingKey<CpuBackend<SC>>,
+    ctx: &'a ProvingContext<CpuBackend<SC>>,
+    mut prover: LogupZerocheckRowMajor<'a, SC>,
