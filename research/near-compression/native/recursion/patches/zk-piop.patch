+        let mut terms = vec![
+            (lay.alpha[round], z_k * (EF::<SC>::ONE - mu0)),
+            (lay.alpha[round] + 1, z_k * (EF::<SC>::ONE - mu0) * lambda),
+            (lay.alpha[round] + 2, z_k * mu0),
+            (lay.alpha[round] + 3, z_k * mu0 * lambda),
+        ];
