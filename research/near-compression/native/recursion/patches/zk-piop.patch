+impl<'a, SC: StarkProtocolConfig> LogupZerocheckRowMajor<'a, SC>
+where
+    SC::F: TwoAdicField,
+    SC::EF: TwoAdicField + ExtensionField<SC::F>,
+    CpuBackend<SC>: ProverBackend<Val = SC::F, Matrix = RowMajorMatrix<SC::F>>,
+{
+    /// [E2E-D zk-piop] Trace `t` in the round that binds its last variable, with every column
+    /// masked by `X(1 - X) mask`: `(zerocheck, LogUp numerator (normalised), denominator)` sums at
+    /// `X = 0..=npts`, from its two-row tables.
+    fn zk_masked_last_round(&self, t: usize, masks: &[Vec<SC::EF>], npts: usize) -> Vec<(SC::EF, SC::EF, SC::EF)> {
+        let helper = &self.eval_helpers[t];
+        let sels = &self.sels_per_trace[t];
+        let mats = &self.mat_evals_per_trace[t];
+        assert_eq!(sels.values.len(), 2 * sels.width, "zk last round: two-row tables");
+        let eq = self.eq_xi_per_trace[t][0];
+        let n = self.n_per_trace[t];
+        let norm = SC::F::from_usize(1 << (-n).max(0)).inverse();
+        let row = |m: &RowMajorMatrix<SC::EF>, x: SC::EF, mask: Option<&Vec<SC::EF>>| -> Vec<SC::EF> {
+            let w = m.width;
+            (0..w)
+                .map(|j| {
+                    let (a, b) = (m.values[j], m.values[w + j]);
+                    let v = a + (b - a) * x;
+                    match mask {
+                        Some(mk) => v + x * (SC::EF::ONE - x) * mk[j],
+                        None => v,
+                    }
+                })
+                .collect()
+        };
+        (0..=npts)
+            .map(|xi| {
+                let x = SC::EF::from_usize(xi);
+                let mut parts = vec![row(sels, x, None)];
+                for (m, mk) in mats.iter().zip(masks) {
+                    parts.push(row(m, x, Some(mk)));
+                }
+                let zc = eq * helper.acc_constraints(&parts, &self.lambda_pows);
+                let (num, den) = if helper.interactions.is_empty() {
+                    (SC::EF::ZERO, SC::EF::ZERO)
+                } else {
+                    let [nu, de] = helper.acc_interactions(&parts, &self.beta_pows, &self.eq_3b_per_trace[t]);
+                    (eq * nu * norm, eq * de)
+                };
+                (zc, num, den)
+            })
+            .collect()
+    }
+}
