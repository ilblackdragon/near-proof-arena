+            terms.extend(poly_terms(lay.h_start(round, i), GkrZkLayout::h_deg(round, i), ri, rho));
+        }
+        out.claims.push(SparseClaim { terms, value: m_k + rho * prefix.get() });
+        for v in [c[0], c[1], c[2], c[3]] {
+            transcript.observe_ext(v);
+        }
+        let mu = transcript.sample_ext();
+        xi_prev = [vec![mu], r_vec].concat();
+        sumcheck_polys.push(round_polys_eval);
+    }
+    let k = total_rounds;
+    out.z = xi_prev[k - 1] * (EF::<SC>::ONE - xi_prev[k - 1]);
+    out.mu = xi_prev[0];
+    out.alpha = lay.alpha[k];
+    Ok((
+        FracSumcheckProof { fractional_sum: (EF::<SC>::ZERO, EF::<SC>::ZERO), claims_per_layer, sumcheck_polys },
+        xi_prev,
+        Some(out),
+    ))
