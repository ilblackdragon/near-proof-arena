+        let mut u_zc = vec![EF::<SC>::ZERO; d];
+        let mut u_lg = vec![EF::<SC>::ZERO; d];
+        let mut sp_tail = EF::<SC>::ZERO;
+        let mut wm = vec![EF::<SC>::ZERO; 2 * d + 1];
