+//! [E2E-D review #1/#2] Regression tests for the zk stacked layout under prover-chosen heights
+//! (`verify_proof_shape` builds the layout from heights read off the proof). Template: the
+//! independent review's `review_zk_layout.rs`. Every call must return (Ok or Err) within a time
+//! bound and never panic.
+use openvm_stark_backend::prover::stacked_pcs::StackedLayout;
+
+type Meta = Vec<(usize, usize, Option<usize>)>;
+
+/// `(width, #slices)` or the error, or `None` on a timeout.
+fn run(meta: Meta, zk: u8) -> Option<Result<(usize, usize), String>> {
+    let (tx, rx) = std::sync::mpsc::channel();
+    std::thread::spawn(move || {
+        let r = std::panic::catch_unwind(|| {
+            StackedLayout::new_tight_zk(2, 21, meta, zk)
+                .map(|l| (l.width(), l.sorted_cols.len()))
+                .map_err(|e| format!("{e:?}"))
+        });
+        let _ = tx.send(r.unwrap_or_else(|_| Err("PANIC".into())));
+    });
+    rx.recv_timeout(std::time::Duration::from_secs(20)).ok()
+}
+
+/// FINAL-like shape of chunk d1_00-h10006-s3 (widths 83, 76, 9, 5; zk = 5 FINAL).
+fn honest() -> Meta {
+    vec![(83, 21, Some(1056768)), (76, 20, Some(284408)), (9, 7, Some(128)), (5, 4, Some(16))]
+}
+
+#[test]
+fn honest_layouts_unchanged() {
+    // zk = 5: 53 data columns + 15 mask columns, 1,536 slices (README §0 / D-2 log)
+    assert_eq!(run(honest(), 5), Some(Ok((68, 1536))));
+    // zk = 6: the same packing, 37 mask columns
+    assert_eq!(run(honest(), 6), Some(Ok((90, 1536))));
+}
+
+#[test]
+fn full_height_tight_chunk_terminates() {
+    // review #1: used to loop forever (a half re-queued in front of its twin)
+    for zk in [3u8, 5, 6] {
+        let mut m = honest();
+        m[0].2 = Some(1 << 21);
+        let r = run(m, zk);
+        assert!(r.is_some(), "zk={zk}: timeout");
+        assert_ne!(r, Some(Err("PANIC".into())), "zk={zk}: panic");
+    }
+}
+
+#[test]
+fn full_height_without_split_is_an_error() {
+    // review #2: zk 1, 2, 4 reserve 256 rows of every stacked column, so a 2^21-row chunk has no
+    // layout: an Err (mapped to a ProofShapeError by the verifier), not a panic
+    for zk in [1u8, 2, 4] {
+        let r = run(vec![(83, 21, Some(1 << 21))], zk);
+        assert!(matches!(r, Some(Err(ref e)) if e.contains("LayoutHeightExceeded")), "zk={zk}: {r:?}");
+    }
+}
+
+#[test]
+fn adversarial_heights_terminate() {
+    // review #3: the worst shape the review's fuzzer found (5,108 slices) still terminates
+    let r = run(
+        vec![(76, 21, Some(2097148)), (83, 21, Some(2097148)), (5, 21, Some(2096892)), (9, 20, Some(1048316))],
+        5,
+    );
+    assert!(matches!(r, Some(Ok(_)) | Some(Err(_))) && r != Some(Err("PANIC".into())), "{r:?}");
+}
