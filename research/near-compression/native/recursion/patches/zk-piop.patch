+        let (e0, e1) = (cur[0], cur[1]);
+        let at = |x: EF<SC>| -> [EF<SC>; 4] {
+            core::array::from_fn(|j| (EF::<SC>::ONE - x) * e0[j] + x * e1[j] + x * (EF::<SC>::ONE - x) * al[j])
+        };
+        let i_last = n - 1;
+        let pre = prefix.get();
+        let t_of = |x: EF<SC>| -> EF<SC> {
+            let c = at(x);
+            c[0] * c[3] + c[2] * c[1] + lambda * c[1] * c[3] + rho * (pre + horner(&hk[i_last], x)) + m_k
+        };
