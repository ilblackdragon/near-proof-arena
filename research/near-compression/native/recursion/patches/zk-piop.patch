+#[derive(Clone, Debug)]
+pub struct GkrZkOut<EF> {
+    /// Masked input-layer claims `p̃(ξ), q̃(ξ)` and `ξ`.
+    pub p: EF,
+    pub q: EF,
+    pub xi: Vec<EF>,
+    /// Sparse claims `V_R, V_1, .., V_{K-1}` (values derived from the transcript).
+    pub claims: Vec<crate::zk::SparseClaim<EF>>,
+    /// Input-level mask: `p̃ = p + z α^p(μ)`, `q̃ = q + z α^q(μ)` with `z = ξ_{K-1}(1 - ξ_{K-1})`,
+    /// `μ = ξ_0`, `α_K` at coefficient `alpha`.
+    pub z: EF,
+    pub mu: EF,
+    pub alpha: usize,
