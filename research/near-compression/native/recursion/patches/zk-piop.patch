+            let (zc_idx, numer_idx, denom_idx) = (2 * num_traces + t, 2 * t, 2 * t + 1);
+            if t < tail_start {
+                if masked_here(t) {
+                    let v = prover.zk_masked_last_round(t, &mat_masks[t], 2 * d);
