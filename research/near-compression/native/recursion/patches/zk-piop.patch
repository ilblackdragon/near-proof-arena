+        out.tail.push(sv[3]);
+        let r_last = transcript.sample_ext();
+        prefix.set(pre + horner(&hk[i_last], r_last));
+        r_vec.push(r_last);
+        let c = at(r_last);
+        claims_per_layer.push(GkrLayerClaims::<SC> { p_xi_0: c[0], q_xi_0: c[1], p_xi_1: c[2], q_xi_1: c[3] });
