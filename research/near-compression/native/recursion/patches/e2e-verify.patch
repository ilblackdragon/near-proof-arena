+pub const TAPE_EVAL_MARKER: u32 = 0x5441_5045 % 0x7800_0001;
+
+/// The tape-eval lever (`NEARPROOF_TAPE_EVAL=1`), read once.
+pub fn tape_eval_lever() -> bool {
+    static L: std::sync::OnceLock<bool> = std::sync::OnceLock::new();
+    *L.get_or_init(|| std::env::var("NEARPROOF_TAPE_EVAL").map(|v| v == "1").unwrap_or(false))
+}
+
+/// The base-field cells hashed for the tape-eval statement part: marker, |u|, |openings|, then the
+/// 12 coefficients of every u_i and every opening.
+pub fn tape_eval_cells(u: &[crate::sha384::config::EF], ys: &[crate::sha384::config::EF]) -> Vec<F> {
+    let mut cells = vec![F::from_u32(TAPE_EVAL_MARKER), F::from_usize(u.len()), F::from_usize(ys.len())];
+    for &x in u.iter().chain(ys) {
+        cells.extend(super::builder::coeffs(x));
+    }
+    cells
+}
+
+/// SHA-384 (tag 8, digest width per the levers) of `tape_eval_cells`.
+pub fn tape_eval_digest(u: &[crate::sha384::config::EF], ys: &[crate::sha384::config::EF]) -> Digest {
+    use crate::sha384::config::{digest_from_bytes, felt_bytes, hash_parts, truncate_digest, TAG_STATEMENT};
+    digest_from_bytes(truncate_digest(hash_parts(TAG_STATEMENT, &[&felt_bytes(&tape_eval_cells(u, ys))])))
 }
 
