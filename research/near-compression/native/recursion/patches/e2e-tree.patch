+fn must_fail(name: &str, f: impl FnOnce()) {
+    let r = std::panic::catch_unwind(std::panic::AssertUnwindSafe(f));
+    assert!(r.is_err(), "tamper not rejected: {name}");
+    println!("AGG_TAMPER rejected: {name}");
+}
