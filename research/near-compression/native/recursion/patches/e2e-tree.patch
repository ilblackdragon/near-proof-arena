+//! [E2E-D D-5] Chunk-independent aggregation tree and the ZK wrap (plan §5.0.1).
+//!
+//! Every proof in the tree is an NV proof over the same AIR set, parameters and pinned trace
+//! heights, so the tree has ONE vk and every node runs ONE program `P_node`, whatever the chunk:
+//!
+//! * **leaf (level 1)**: a per-template *normaliser* (`build_norm`): a one-child NV program that
+//!   verifies a template proof (here: a D0a chain proof at its converged level M), binds the child
+//!   program by the template's anchor constant (child level forced to M), and exposes the
+//!   canonical range statement `D = H9(ctx, a, a+1, s_in, s_out)` with `ctx` = the template's
+//!   statement digest. Or a **PAD** leaf (`build_pad`): no child; `s_in = s_out`,
+//!   `s_in.phase = done` (the identity template of plan §5.0.1 item 2, admissible only after the
+//!   chunk is done).
+//! * **node (level >= 2)**: `agg::build_agg` with `ChildKind::Node`, fixed arity. Children at
+//!   level 1 are bound by the template set (`Builder::anchor_set`: the cached program root is one
+//!   of the pinned `C_t`); children at level >= 2 by BIND (child 0) and `root_i = root_0`.
+//! * **wrap (FINAL domain, zk-masked)**: `build_wrap`. Verifies the root at the pinned root level
+//!   `1 + depth` (child level forced), binds the root's program to the pinned `C_node`, witnesses
+//!   the root's range statement and checks it hashes to the root's `D`, asserts `a = 0`,
+//!   `s_in.phase = init`, `s_out.phase = done`, and exposes `[LEVEL_WRAP, D_wrap]` with
+//!   `D_wrap = H8(WRAP_MARKER, n_ctx, ctx)`. Nothing else leaves the tree: not the depth, the
+//!   segment count, a boundary, or any template value.
+//!
+//! The boundary state here is `[phase, class]` (`N_STATE = 2`): `class` is the template class of
+//! the chunk's statement (for D0a: its shape class, whose base parameters V_d needs to recompute
+//! `ctx`). The template leaf sets it as a program constant, PAD carries it, and the wrap folds the
+//! root's `B_0.class` into `D_wrap`, so V_d's choice of base parameters is bound to the template
+//! the tree used. Lane E's full boundary record enters through its digest (plan §5.0.1 blocker 5),
+//! which this prototype does not have.
+use p3_field::{PrimeCharacteristicRing, PrimeField32};
+
+use super::{
+    agg::{hash_range, pack, RangeStmt, StmtCells},
+    builder::{coeffs, Builder, V},
+    fmt::limbs_digest,
+    verifier::build_verifier,
+};
+use crate::sha384::config::{digest_from_bytes, felt_bytes, hash_parts, truncate_digest, Digest, Sha384Config, F, TAG_STATEMENT};
+use openvm_stark_backend::{keygen::types::MultiStarkVerifyingKey, proof::Proof};
+
+pub const PHASE_INIT: u32 = 1;
+pub const PHASE_DONE: u32 = 2;
+/// boundary state cells: [phase, class]
+pub const N_STATE: usize = 2;
+/// statement digest limbs (the NV public values 1..19)
+pub const N_CTX: usize = 18;
+/// level of every leaf (normaliser or PAD)
+pub const LEVEL_LEAF: u32 = 1;
+/// the wrap's exposed level (a setup constant; the tree depth is not exposed)
+pub const LEVEL_WRAP: u32 = 64;
+/// Leading cell of the wrap statement message ("WRAP" reduced into BabyBear); domain-separates it
+/// from the G1 statement message (leading cell = the AIR count) and the tape-eval message under
+/// the same tag 8.
+pub const WRAP_MARKER: u32 = 0x5752_4150 % 0x7800_0001;
+
+/// The wrap statement message `[WRAP_MARKER, n_ctx, ctx.., class]`.
+pub fn wrap_values(ctx: &[F], class: u32) -> Vec<F> {
+    let mut v = vec![F::from_u32(WRAP_MARKER), F::from_usize(ctx.len())];
+    v.extend_from_slice(ctx);
+    v.push(F::from_u32(class));
+    v
+}
+/// `D_wrap = SHA-384(tag 8, wrap_values(ctx, class))`, truncated like every statement digest.
+pub fn wrap_digest(ctx: &[F], class: u32) -> Digest {
+    digest_from_bytes(truncate_digest(hash_parts(TAG_STATEMENT, &[&felt_bytes(&wrap_values(ctx, class))])))
+}
+/// The ctx limbs of a statement digest (what a normaliser exposes as ctx: the template child's
+/// public values 1..19).
+pub fn ctx_of_digest(d: Digest) -> Vec<F> {
+    let (lo, hi) = super::builder::digest_cells(d);
+    let mut v = lo.to_vec();
+    v.extend_from_slice(&hi[..6]);
+    v
+}
+
+fn consts(b: &mut Builder, xs: &[u32]) -> Vec<V> {
+    xs.iter().map(|&x| b.c(F::from_u32(x))).collect()
+}
+
+fn expose(b: &mut Builder, s: &StmtCells, level: u32) -> Digest {
+    let dc = hash_range(b, s);
+    let l = b.c(F::from_u32(level));
+    b.pv_level(l);
+    b.pv_digest(&dc);
+    dc.digest
+}
+
+/// Leaf: the normaliser of an NV template proof (child level forced to `anchor.0`, program root
+/// = `anchor.1`). Exposes `(ctx = child's statement digest, a, a + 1, [init, class], [done,
+/// class])`: the template proves a whole chunk, so it takes the init boundary to the done
+/// boundary; `class` is a program constant of this template.
+pub fn build_norm(b: &mut Builder, vk: &MultiStarkVerifyingKey<Sha384Config>, proof: &Proof<Sha384Config>, anchor: (u32, Digest), a: F, class: u32) -> RangeStmt {
+    b.agg = true;
+    b.anchor = Some(anchor);
+    b.force_anchor = true;
+    b.bind_child = true;
+    b.bind_child_index = 0;
+    let pv = build_verifier(b, vk, proof);
+    b.bind_child = false;
+    b.force_anchor = false;
+    let v = &pv[0];
+    assert_eq!(v.len(), super::uair::NV_NUM_PVS, "template child exposes [level, D]");
+    let ctx = v[1..1 + N_CTX].to_vec();
+    let av = b.load_f(a);
+    let one = b.c(F::ONE);
+    let e = b.add(av, one);
+    let s = StmtCells { ctx, a: av, e, s_a: consts(b, &[PHASE_INIT, class]), s_e: consts(b, &[PHASE_DONE, class]) };
+    let val = |c: &V| coeffs(c.val)[0];
+    let stmt = RangeStmt {
+        ctx: s.ctx.iter().map(val).collect(),
+        a,
+        e: a + F::ONE,
+        s_a: vec![F::from_u32(PHASE_INIT), F::from_u32(class)],
+        s_e: vec![F::from_u32(PHASE_DONE), F::from_u32(class)],
+    };
+    expose(b, &s, LEVEL_LEAF);
+    stmt
+}
