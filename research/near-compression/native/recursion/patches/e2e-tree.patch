+        let lr = env_usize(&format!("AGG_LOG_ROWS{d}"), 20);
+        let kp = p1.k_whir();
+        let mut next: Vec<(Vk, Pf)> = Vec::new();
+        let mut nxt: Vec<RangeStmt> = Vec::new();
+        for i in 0..(cur.len() / 2) {
+            let kids = [cur[2 * i].clone(), cur[2 * i + 1].clone()];
+            let pre = [stmts[2 * i].clone(), stmts[2 * i + 1].clone()];
+            let (_v, p, _b) = level(&format!("L{d}_{i}"), pp.clone(), lr, kp, &kids, node, &pre);
+            let s = RangeStmt::compose(&pre).unwrap();
+            next.push((_v, p));
+            nxt.push(s);
+        }
+        cur = next;
+        stmts = nxt;
+    }
+    assert_eq!(cur.len(), 1, "one root");
+    let all = RangeStmt::compose(&segs.iter().map(|s| s.stmt()).collect::<Vec<_>>()).unwrap();
+    assert!(check_range_statement(&cur[0].1.public_values[0], &all), "depth-{depth} final statement");
+    println!("AGG_DEPTH{depth}_OK leaves={leaves} final statement = segments [0, {leaves})");
+}
