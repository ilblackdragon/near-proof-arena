+/// Leaf: PAD, the identity on a done boundary. Witness `(ctx, a, s)`; asserts `s.phase = done`;
+/// exposes `(ctx, a, a + 1, s, s)`. No child proof.
+pub fn build_pad(b: &mut Builder, ctx: &[F], a: F, s: &[F]) -> RangeStmt {
+    assert_eq!((ctx.len(), s.len()), (N_CTX, N_STATE));
+    b.agg = true;
+    let ctx_c: Vec<V> = ctx.iter().map(|&x| b.load_f(x)).collect();
+    let av = b.load_f(a);
+    let one = b.c(F::ONE);
+    let e = b.add(av, one);
+    let sc: Vec<V> = s.iter().map(|&x| b.load_f(x)).collect();
+    let done = b.c(F::from_u32(PHASE_DONE));
+    b.assert_eq(sc[0], done, "PAD: boundary phase = done");
+    let cells = StmtCells { ctx: ctx_c, a: av, e, s_a: sc.clone(), s_e: sc };
+    expose(b, &cells, LEVEL_LEAF);
+    RangeStmt { ctx: ctx.to_vec(), a, e: a + F::ONE, s_a: s.to_vec(), s_e: s.to_vec() }
+}
+
+/// Node: `agg::build_agg` over NV children of the tree, with the level-1 template set.
+pub fn build_node(
+    b: &mut Builder,
+    children: &[(&MultiStarkVerifyingKey<Sha384Config>, &Proof<Sha384Config>)],
+    preimages: &[RangeStmt],
+    template_set: &[Digest],
+) -> RangeStmt {
+    b.anchor_set = Some((LEVEL_LEAF, template_set.to_vec()));
+    super::agg::build_agg(b, children, super::agg::ChildKind::Node { n_ctx: N_CTX, n_state: N_STATE }, preimages)
+}
+
+/// Wrap: verifies the root (level forced to `root_level`, program root = `c_node`), checks the
+/// root statement preimage, Init / done / `a = 0`, and exposes `[LEVEL_WRAP, D_wrap(ctx)]`.
+pub fn build_wrap(
+    b: &mut Builder,
+    vk: &MultiStarkVerifyingKey<Sha384Config>,
+    proof: &Proof<Sha384Config>,
+    root_level: u32,
+    c_node: Digest,
+    pre: &RangeStmt,
+) -> Digest {
+    assert_eq!((pre.ctx.len(), pre.s_a.len()), (N_CTX, N_STATE));
+    b.agg = true;
+    b.anchor = Some((root_level, c_node));
+    b.force_anchor = true;
+    b.bind_child = true;
+    b.bind_child_index = 0;
+    let pv = build_verifier(b, vk, proof);
+    b.bind_child = false;
+    b.force_anchor = false;
+    let v = &pv[0];
+    assert_eq!(v.len(), super::uair::NV_NUM_PVS, "root exposes [level, D]");
+    let ld = |b: &mut Builder, xs: &[F]| -> Vec<V> { xs.iter().map(|&x| b.load_f(x)).collect() };
+    let s = StmtCells { ctx: ld(b, &pre.ctx), a: b.load_f(pre.a), e: b.load_f(pre.e), s_a: ld(b, &pre.s_a), s_e: ld(b, &pre.s_e) };
+    // the preimage hashes to the root's exposed digest
+    let dc = hash_range(b, &s);
+    let mut basis = vec![];
+    let lo = pack(b, &mut basis, &v[1..13]);
+    let hi = pack(b, &mut basis, &v[13..19]);
+    let limbs: Vec<F> = v[1..19].iter().map(|c| coeffs(c.val)[0]).collect();
+    if limbs_digest(&limbs) != dc.digest {
+        b.failures.push("wrap: root statement preimage".into());
+    }
+    b.assert_eq(dc.lo, lo, "root statement digest lo");
+    b.assert_eq(dc.hi, hi, "root statement digest hi");
+    // the root covers the chunk from its first segment, init to done
+    b.zero(s.a, "wrap: a = 0");
+    let init = b.c(F::from_u32(PHASE_INIT));
+    let done = b.c(F::from_u32(PHASE_DONE));
+    b.assert_eq(s.s_a[0], init, "wrap: B_0.phase = init");
+    b.assert_eq(s.s_e[0], done, "wrap: B_N.phase = done");
+    // D_wrap = H8(WRAP_MARKER, n_ctx, ctx, B_0.class)
+    let mut cells = consts(b, &[WRAP_MARKER, N_CTX as u32]);
+    cells.extend(&s.ctx);
+    cells.push(s.s_a[1]);
+    let job = b.job_start(TAG_STATEMENT, 4 * cells.len());
+    for (i, &x) in cells.iter().enumerate() {
+        b.unit1(x, job, 2 + i as u32);
+    }
+    let d = wrap_digest(&pre.ctx, pre.s_a[1].as_canonical_u32());
+    let dw = b.dig(job, d);
+    let l = b.c(F::from_u32(LEVEL_WRAP));
+    b.pv_level(l);
+    b.pv_digest(&dw);
+    d
+}
+
+/// Native check of a wrap proof's public values: `[LEVEL_WRAP, D_wrap(ctx, class)]`.
+pub fn check_wrap_statement(nv_public_values: &[F], ctx: &[F], class: u32) -> bool {
+    let (lo, hi) = super::builder::digest_cells(wrap_digest(ctx, class));
+    nv_public_values.len() == super::uair::NV_NUM_PVS
+        && nv_public_values[0] == F::from_u32(LEVEL_WRAP)
+        && nv_public_values[1..13] == lo[..]
+        && nv_public_values[13..19] == hi[..6]
+}
