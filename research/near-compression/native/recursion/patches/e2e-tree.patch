+fn parent() -> openvm_stark_backend::SystemParams {
+    let mut p = crate::sha384::e2e_tests::params_from_env("PARENT", [16, 3, 20, 3]);
+    p.max_constraint_degree = NvCircuit::new(3, 16, 1).layout().degree().max(6);
+    p
