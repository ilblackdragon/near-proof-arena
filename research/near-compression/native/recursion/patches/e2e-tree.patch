+    let airs = circ.airs::<Sha384Config>();
+    let (mut mats, b) = circ.generate_with(body);
+    mutate(&mut mats);
+    let ctxs: Vec<AirProvingContext<CpuBackend<Sha384Config>>> = super::circuit::nv_contexts(circ, engine.config(), mats, b.public_values());
+    engine.debug(&airs, &ProvingContext::new(ctxs.into_iter().enumerate().collect()));
+    b
