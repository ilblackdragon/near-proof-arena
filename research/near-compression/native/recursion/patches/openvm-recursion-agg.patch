+    children: &[(Vk, Pf)],
+    kind: ChildKind,
+    pre: &[RangeStmt],
+    log_rows: usize,
+    k: usize,
+    mutate: impl FnOnce(&mut Vec<RowMajorMatrix<F>>),
+) -> Builder {
