+        for (mat_idx, (width, log_ht, tight)) in sorted.into_iter().enumerate() {
+            mat_starts.push(entries.len());
+            if log_ht > log_stacked_height {
+                return Err(StackedPcsError::LayoutHeightExceeded { log_height: log_ht, log_stacked_height });
+            }
+            let chunks: Vec<(usize, usize)> = match tight {
+                Some(h) if log_ht >= l_skip => {
+                    assert!(h > 0 && h <= 1 << log_ht && h % (1 << l_skip) == 0, "tight height");
+                    let mut out = Vec::new();
