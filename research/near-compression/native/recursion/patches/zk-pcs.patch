+/// [E2E-D zk-pcs] Fill the cells the `zk` layout leaves outside every slice — the last
+/// `ZK_RESERVE_ROWS` rows of each slice-bearing column and every appended mask column — with fresh
+/// uniform field elements (rejection sampling of /dev/urandom words). Holes left by the packing
+/// stay zero; hiding does not need them.
+pub fn zk_fill<F: p3_field::PrimeField64>(q: &mut ColMajorMatrix<F>, layout: &StackedLayout, zk: u8) {
+    if zk == 0 {
+        return;
+    }
+    let (reserve, mask_cols) = crate::WhirLevers { zk, ..Default::default() }.zk_shape();
+    let height = layout.height();
+    let width = layout.width();
+    assert_eq!(q.width(), width, "zk layout width");
+    let used = width - mask_cols;
+    let p = F::ORDER_U64;
+    assert!(p < 1 << 31, "zk_fill samples 31-bit fields");
+    // Uniform elements by rejection sampling of 31-bit words read from the OS CSPRNG (no PRG of
+    // our own; each column reads its own buffer).
+    q.values.par_chunks_exact_mut(height).enumerate().for_each(|(c, col)| {
+        use std::io::Read;
+        let cells = if c < used { &mut col[height - reserve..] } else { &mut col[..] };
+        let mut f = std::fs::File::open("/dev/urandom").expect("zk: /dev/urandom");
+        let mut buf = vec![0u8; 4 * cells.len() + 64];
+        let mut i = 0usize;
+        let mut pos = buf.len();
+        while i < cells.len() {
+            if pos + 4 > buf.len() {
+                f.read_exact(&mut buf).expect("zk: /dev/urandom");
+                pos = 0;
+            }
+            let v = (u32::from_le_bytes(buf[pos..pos + 4].try_into().unwrap()) & 0x7fff_ffff) as u64;
+            pos += 4;
+            if v < p {
+                cells[i] = F::from_u64(v);
+                i += 1;
+            }
+        }
+    });
+}
