+                    entries.push((
+                        mat_idx,
+                        j,
+                        StackedSlice { col_idx: 0, row_idx: 0, log_height: e, src_row: off, col_log_height: log_ht },
+                    ));
+                }
+            }
+        }
+        entries.sort_by_key(|(_, _, s)| std::cmp::Reverse(s.log_height));
+        // First-fit decreasing (no splitting: halving a slice so two 2^(h-1) slices can share a
