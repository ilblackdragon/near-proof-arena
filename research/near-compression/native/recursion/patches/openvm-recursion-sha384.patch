+pub fn build(
+    vk: &MultiStarkVerifyingKey<Sha384Config>,
+    proof: &Proof<Sha384Config>,
+    parent: &Sha384CpuEngine,
+) -> (Vec<AirRef<Sha384Config>>, Ctxs) {
+    let circuit = VerifierSubCircuit::<1>::new(Arc::new(vk.clone()));
+    let airs = circuit.airs::<Sha384Config>();
+    let commit = circuit.commit_child_vk(parent, vk);
+    let ctxs = circuit.generate_proving_ctxs_base(
+        vk,
+        CachedTraceCtx::PcsData(commit),
+        std::slice::from_ref(proof),
+        &(),
+        ShaTranscriptRecorder::default(),
+    );
+    (airs, ctxs)
+}
+
+pub fn report(tag: &str, airs: &[AirRef<Sha384Config>], ctxs: &Ctxs) -> usize {
+    let mut total = 0;
+    for (i, (air, ctx)) in airs.iter().zip(ctxs).enumerate() {
+        let h = ctx.common_main.height();
+        let w = ctx.common_main.width();
+        let cached: usize = ctx
+            .cached_mains
+            .iter()
+            .map(|c| c.trace.width() * c.trace.height())
+            .sum();
+        let cells = h * w + cached;
+        total += cells;
+        println!("{tag}_AIR {i} {} {h} {w} {cells}", air.name());
+    }
+    println!("{tag}_TOTAL_CELLS {total}");
+    total
+}
