+/// SHA jobs of one proof: replayed transcript jobs and the global job numbering.
+#[derive(Clone, Debug, Default)]
+pub struct ShaPreflight {
+    pub transcript_jobs: Vec<TrJob>,
+    pub layout: ShaJobLayout,
+}
+
+/// Replays each proof's transcript into SHA jobs and assigns global job ids.
+pub fn finalize_sha_preflights(
+    preflights: &mut [Preflight],
+    proofs: &[Proof<Sha384Config>],
+    child_vk: &MultiStarkVerifyingKey<Sha384Config>,
+) {
+    let mut base = 0;
+    for (preflight, proof) in preflights.iter_mut().zip(proofs) {
+        let jobs = replay_transcript(&preflight.transcript);
+        let layout = ShaJobLayout::new(base, jobs.len(), proof, &child_vk.inner.params);
+        base = layout.end();
+        preflight.sha = ShaPreflight {
+            transcript_jobs: jobs,
+            layout,
+        };
+    }
 }
 
