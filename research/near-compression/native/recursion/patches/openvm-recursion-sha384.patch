+fn must_fail(name: &str, f: impl FnOnce()) {
+    let r = std::panic::catch_unwind(AssertUnwindSafe(f));
+    assert!(r.is_err(), "mutation `{name}` was accepted by the verifier circuit");
+    println!("E2E_MUTATION_REJECTED {name}");
+}
