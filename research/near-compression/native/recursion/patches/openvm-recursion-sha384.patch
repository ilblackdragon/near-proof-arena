+            mats[0].values[r * w + g_off + cst / OP_LO] = F::ZERO;
+            mats[0].values[r * w + h_off + ld % OP_LO] = F::ONE;
+            mats[0].values[r * w + g_off + ld / OP_LO] = F::ONE;
+            mats[0].values[r * w + base + 24] += F::ONE;
