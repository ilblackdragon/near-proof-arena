+//! Trace generation for the SHA subsystem (`airs.rs` + `compress_air.rs`).
+use core::borrow::BorrowMut;
+
+use p3_field::{Field, PrimeCharacteristicRing};
+use p3_matrix::dense::RowMajorMatrix;
+use p3_maybe_rayon::prelude::*;
+
+use super::{
+    airs::{ShaBlockCols, ShaMsgCols, BLOCK_WIDTH, MSG_WIDTH},
+    compress_air::{ROWS, WIDTH as COMPRESS_WIDTH},
+    compress_trace::{gen_main, gen_table, main_height, sha2_compress, Comp, SHA384_IV},
+    config::{word_limbs, F, PREFIX},
+};
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum Unit {
+    /// canonical field element, little-endian bytes
+    Felt(u32),
+    /// two 16-bit limbs, big-endian bytes (hi first)
+    Pair(u32, u32),
+}
+impl Unit {
+    pub fn bytes(self) -> [u8; 4] {
+        match self {
+            Unit::Felt(x) => x.to_le_bytes(),
+            Unit::Pair(hi, lo) => [(hi >> 8) as u8, hi as u8, (lo >> 8) as u8, lo as u8],
+        }
+    }
+    pub fn kind(self) -> u32 {
+        matches!(self, Unit::Pair(..)) as u32
+    }
+    pub fn values(self) -> (u32, u32) {
+        match self {
+            Unit::Felt(x) => (x, 0),
+            Unit::Pair(hi, lo) => (hi, lo),
+        }
+    }
+}
+
+/// Units of a 48-byte digest/state given as SHA words H0..H5.
+pub fn word_units(h: &[u64; 6]) -> Vec<Unit> {
+    h.iter()
+        .flat_map(|&w| {
+            let l = word_limbs(w);
+            [Unit::Pair(l[3], l[2]), Unit::Pair(l[1], l[0])]
+        })
+        .collect()
+}
+/// Length prefix (le8) as two units.
+pub fn len_units(bytes: usize) -> [Unit; 2] {
+    [Unit::Felt(bytes as u32), Unit::Felt(0)]
+}
+
+#[derive(Clone, Debug)]
+pub struct ShaJob {
+    pub tag: u8,
+    pub units: Vec<Unit>,
+}
+impl ShaJob {
+    pub fn message(&self) -> Vec<u8> {
+        let mut m = PREFIX.to_vec();
+        m.push(self.tag);
+        for u in &self.units {
+            m.extend(u.bytes());
+        }
+        m
+    }
+    pub fn num_blocks(&self) -> usize {
+        (self.message().len() + 17).div_ceil(128)
+    }
+}
+
+/// SHA-384 digest words H0..H5 and the per-block (state in, block) of a message.
+pub fn sha384_blocks(msg: &[u8]) -> (Vec<Comp>, [u64; 6]) {
+    let blocks = super::compress_trace::pad_message(msg);
+    let mut h = SHA384_IV;
+    let mut comps = Vec::with_capacity(blocks.len());
+    for b in blocks {
+        let c = Comp { h, block: b };
+        h = sha2_compress(&c);
+        comps.push(c);
+    }
+    (comps, std::array::from_fn(|i| h[i]))
+}
+
+/// Everything the SHA subsystem hashes: generic jobs (ids 0..) and direct compressions
+/// (used by the Merkle node AIR; they occupy compression ids 0..nodes.len()).
+#[derive(Default)]
+pub struct ShaWork {
+    pub jobs: Vec<ShaJob>,
+    pub nodes: Vec<Comp>,
+}
+
+/// Split of the compressions over the two compression AIR instances.
+#[derive(Clone, Copy, Debug)]
+pub struct CompressSplit {
+    pub n0: usize,
+}
+impl CompressSplit {
+    /// Instance 0 takes the largest power-of-two number of rows not exceeding the total
+    /// (so neither instance pads by more than the other's size); both are non-empty.
+    pub fn single(n: usize) -> Self {
+        Self { n0: n }
+    }
+    pub fn new(n: usize) -> Self {
+        assert!(n >= 2);
+        let rows = n * ROWS;
+        let h0 = if rows.is_power_of_two() { rows / 2 } else { 1 << (usize::BITS - 1 - rows.leading_zeros()) };
+        let n0 = (h0 / ROWS).clamp(1, n - 1);
+        Self { n0 }
+    }
+    pub fn cid(&self, idx: usize) -> usize {
+        if idx < self.n0 {
+            idx * ROWS
+        } else {
+            super::compress_air::CID_OFFSET_1 as usize + (idx - self.n0) * ROWS
+        }
+    }
+}
+
+pub struct ShaTraces {
+    /// one matrix per compression AIR instance
+    pub compress: Vec<RowMajorMatrix<F>>,
+    pub split: CompressSplit,
+    pub table: RowMajorMatrix<F>,
+    pub block: RowMajorMatrix<F>,
+    pub msg: RowMajorMatrix<F>,
+    /// byte-table multiplicities from the packer
+    pub byte_counts: Vec<u32>,
+    pub job_digests: Vec<[u64; 6]>,
+}
+
+fn to_f(v: Vec<u32>, width: usize) -> RowMajorMatrix<F> {
+    RowMajorMatrix::new(v.into_par_iter().map(F::from_u32).collect(), width)
+}
+
+pub fn generate(work: &ShaWork, instances: usize) -> ShaTraces {
+    generate_with_heights(work, instances, None)
+}
+
+/// As `generate`, with minimum heights (compress instance 0, block, msg).
+pub fn generate_with_heights(
+    work: &ShaWork,
+    instances: usize,
+    heights: Option<(usize, usize, usize)>,
+) -> ShaTraces {
+    let job_blocks: Vec<(Vec<Comp>, [u64; 6])> = work
+        .jobs
+        .par_iter()
+        .map(|j| sha384_blocks(&j.message()))
+        .collect();
+    let n_blocks: usize = job_blocks.iter().map(|b| b.0.len()).sum();
+    let mut comps = work.nodes.clone();
+    comps.extend(job_blocks.iter().flat_map(|b| b.0.iter().copied()));
+
+    // Compression AIR instances.
+    let split = if instances == 2 {
+        CompressSplit::new(comps.len())
+    } else {
+        CompressSplit::single(comps.len())
+    };
+    let (c0, c1) = comps.split_at(split.n0);
+    let h0 = heights.map_or(main_height(c0.len()), |h| h.0.max(main_height(c0.len())));
+    let main0 = gen_main(c0, h0);
+    let mut table = gen_table(&main0, h0);
+    let (main1, t1) = if instances == 2 {
+        let h1 = main_height(c1.len());
+        let m = gen_main(c1, h1);
+        let t = gen_table(&m, h1);
+        (Some(m), t)
+    } else {
+        (None, vec![0u32; table.len()])
+    };
+    for r in 0..64 {
+        for c in [super::compress_air::T_MC, super::compress_air::T_MR] {
+            table[r * super::compress_air::T_WIDTH + c] += t1[r * super::compress_air::T_WIDTH + c];
+        }
+    }
+
+    // Block AIR.
+    let bh = heights.map_or(n_blocks.next_power_of_two().max(1), |h| {
+        h.1.max(n_blocks.next_power_of_two().max(1))
+    });
+    assert!(bh >= n_blocks);
+    let mut block = F::zero_vec(bh * BLOCK_WIDTH);
+    {
+        let mut row = 0usize;
+        for (job, (cs, _)) in job_blocks.iter().enumerate() {
+            for (k, c) in cs.iter().enumerate() {
+                let out = sha2_compress(c);
+                let r: &mut ShaBlockCols<F> =
+                    block[row * BLOCK_WIDTH..(row + 1) * BLOCK_WIDTH].borrow_mut();
+                r.valid = F::ONE;
+                r.job = F::from_usize(job);
+                r.blk = F::from_usize(k);
+                r.first = F::from_bool(k == 0);
+                r.last = F::from_bool(k + 1 == cs.len());
+                r.cid = F::from_usize(split.cid(work.nodes.len() + row));
+                for q in 0..8 {
+                    let (li, lo) = (word_limbs(c.h[q]), word_limbs(out[q]));
+                    for t in 0..4 {
+                        r.input[4 * q + t] = F::from_u32(li[t]);
+                        r.output[4 * q + t] = F::from_u32(lo[t]);
+                    }
+                }
+                for q in 0..16 {
+                    let lw = word_limbs(c.block[q]);
+                    for t in 0..4 {
+                        r.words[4 * q + t] = F::from_u32(lw[t]);
+                    }
+                }
+                row += 1;
+            }
+        }
+    }
+
+    // Packer.
+    let n_words = 16 * n_blocks;
+    let mh = heights.map_or(n_words.next_power_of_two().max(1), |h| {
+        h.2.max(n_words.next_power_of_two().max(1))
+    });
+    assert!(mh >= n_words);
+    let mut msg = F::zero_vec(mh * MSG_WIDTH);
+    let mut byte_counts = vec![0u32; 256];
+    {
+        let mut row = 0usize;
+        for (job, j) in work.jobs.iter().enumerate() {
+            let m = j.message();
+            let nb = job_blocks[job].0.len();
+            let padded: Vec<u8> = job_blocks[job]
+                .0
+                .iter()
+                .flat_map(|c| c.block.iter().flat_map(|w| w.to_be_bytes()))
+                .collect();
+            debug_assert_eq!(&padded[..m.len()], &m[..]);
+            let total_units = j.units.len();
+            let mut phase = false;
+            let mut uidx = 0usize;
+            for w in 0..16 * nb {
+                let blk = w / 16;
+                let pos = w % 16;
+                let last_blk = blk + 1 == nb;
+                let r: &mut ShaMsgCols<F> =
+                    msg[row * MSG_WIDTH..(row + 1) * MSG_WIDTH].borrow_mut();
+                r.valid = F::ONE;
+                r.start = F::from_bool(w == 0);
+                r.job = F::from_usize(job);
+                r.w = F::from_usize(w);
+                r.tag = F::from_u8(j.tag);
+                r.oh[pos] = F::ONE;
+                r.blk0 = F::from_bool(blk == 0);
+                r.last_blk = F::from_bool(last_blk);
+                r.is_end = F::from_bool(last_blk && pos == 15);
+                let bytes = &padded[8 * w..8 * w + 8];
+                for k in 0..8 {
+                    r.b[k] = F::from_u8(bytes[k]);
+                    byte_counts[bytes[k] as usize] += 1;
+                }
+                let carry = if 8 * w + 8 < padded.len() {
+                    padded[8 * w + 8]
+                } else {
+                    0
+                };
+                r.carry = F::from_u8(carry);
+                r.phase = F::from_bool(phase);
+                r.uidx = F::from_usize(uidx);
+                let hdr = blk == 0 && pos < 4;
+                let lenw = last_blk && pos >= 14;
+                let slot_bytes = [
+                    [bytes[1], bytes[2], bytes[3], bytes[4]],
+                    [bytes[5], bytes[6], bytes[7], carry],
+                ];
+                for s in 0..2 {
+                    let a = slot_bytes[s];
+                    let gap = 0x78i64 - a[3] as i64;
+                    let gapf = F::from_i64(gap);
+                    r.zmax[s] = F::from_bool(gap == 0);
+                    r.inv[s] = if gap == 0 { F::ZERO } else { gapf.inverse() };
+                    if hdr || lenw {
+                        continue;
+                    }
+                    if !phase && uidx < total_units {
+                        let u = j.units[uidx];
+                        debug_assert_eq!(u.bytes(), a);
+                        r.d[s] = F::ONE;
+                        r.kind[s] = F::from_u32(u.kind());
+                        if u.kind() == 0 {
+                            assert!(gap >= 0, "non-canonical field element unit");
+                            byte_counts[gap as usize] += 1;
+                        }
+                        uidx += 1;
+                    } else if !phase {
+                        debug_assert_eq!(a, [0x80, 0, 0, 0]);
+                        r.p[s] = F::ONE;
+                        phase = true;
+                    } else {
+                        debug_assert_eq!(a, [0, 0, 0, 0]);
+                    }
+                }
+                if pos == 13 {
+                    assert_eq!(phase, last_blk, "padding/final-block mismatch");
+                }
+                row += 1;
+            }
+            assert_eq!(uidx, total_units);
+        }
+        // padding rows: all zero except the is-zero gadget inverses
+        let inv78 = F::from_u32(0x78).inverse();
+        for r in row..mh {
+            let c: &mut ShaMsgCols<F> = msg[r * MSG_WIDTH..(r + 1) * MSG_WIDTH].borrow_mut();
+            c.inv = [inv78; 2];
+        }
+    }
+    ShaTraces {
+        compress: core::iter::once(main0)
+            .chain(main1)
+            .map(|m| to_f(m, COMPRESS_WIDTH))
+            .collect(),
+        split,
+        table: to_f(table, super::compress_air::T_WIDTH),
+        block: RowMajorMatrix::new(block, BLOCK_WIDTH),
+        msg: RowMajorMatrix::new(msg, MSG_WIDTH),
+        byte_counts,
+        job_digests: job_blocks.iter().map(|b| b.1).collect(),
+    }
+}
+
+/// Byte table trace from accumulated multiplicities.
+pub fn byte_table(counts: &[u32]) -> RowMajorMatrix<F> {
+    let mut v = F::zero_vec(256 * 2);
+    for i in 0..256 {
+        v[2 * i] = F::from_usize(i);
+        v[2 * i + 1] = F::from_u32(counts[i]);
+    }
+    RowMajorMatrix::new(v, 2)
+}
diff --git a/crates/recursion/src/sha384/layout.rs b/crates/recursion/src/sha384/layout.rs
new file mode 100644
index 0000000..f254df0
--- /dev/null
+++ b/crates/recursion/src/sha384/layout.rs
@@ -0,0 +1,92 @@
+//! Global numbering of SHA jobs across modules (all deterministic from proofs/preflights).
+//!
+//! Per proof p, in order: transcript jobs, initial-round leaf jobs ordered
+//! (query, coset, commit), then non-initial leaf jobs ordered (round, query, coset).
+//! Proofs are concatenated.  Merkle node compressions use compression ids 0..N in
+//! MerkleVerifyAir row order and are not jobs.
+use openvm_stark_backend::{proof::Proof, SystemParams};
+use p3_field::{BasedVectorSpace, PrimeField32};
+
+use super::{
+    config::{Sha384Config, F},
+    jobs::{len_units, ShaJob, Unit},
+};
+
+#[derive(Clone, Copy, Debug, Default)]
+pub struct ShaJobLayout {
+    pub base: usize,
+    pub n_transcript: usize,
+    pub n_initial: usize,
+    pub n_noninit: usize,
+    pub num_commits: usize,
+    pub k: usize,
+}
+
+impl ShaJobLayout {
+    pub fn new(base: usize, n_transcript: usize, proof: &Proof<Sha384Config>, params: &SystemParams) -> Self {
+        let k = params.k_whir();
+        let num_commits = proof.whir_proof.initial_round_opened_rows.len();
+        let q0 = params.whir.rounds[0].num_queries;
+        let n_initial = q0 * (1 << k) * num_commits;
+        let n_noninit = params.whir.rounds[1..]
+            .iter()
+            .map(|r| r.num_queries << k)
+            .sum();
+        Self {
+            base,
+            n_transcript,
+            n_initial,
+            n_noninit,
+            num_commits,
+            k,
+        }
+    }
+    pub fn total(&self) -> usize {
+        self.n_transcript + self.n_initial + self.n_noninit
+    }
+    pub fn end(&self) -> usize {
+        self.base + self.total()
+    }
+    pub fn transcript_job(&self, i: usize) -> usize {
+        self.base + i
+    }
+    pub fn initial_job(&self, query: usize, coset: usize, commit: usize) -> usize {
+        self.base + self.n_transcript + ((query << self.k) + coset) * self.num_commits + commit
+    }
+    /// `row` = row index within the proof in NonInitialOpenedValuesAir order.
+    pub fn noninit_job(&self, row: usize) -> usize {
+        self.base + self.n_transcript + self.n_initial + row
+    }
+}
+
+pub fn leaf_job(values: &[F]) -> ShaJob {
+    let mut units = len_units(4 * values.len()).to_vec();
+    units.extend(values.iter().map(|x| Unit::Felt(x.as_canonical_u32())));
+    ShaJob {
+        tag: super::config::TAG_LEAF,
+        units,
+    }
+}
+
+/// Leaf jobs of one proof, in layout order (initial, then non-initial).
+pub fn leaf_jobs(proof: &Proof<Sha384Config>, params: &SystemParams) -> Vec<ShaJob> {
+    let k = params.k_whir();
+    let w = &proof.whir_proof;
+    let mut out = Vec::new();
+    let q0 = params.whir.rounds[0].num_queries;
+    for q in 0..q0 {
+        for c in 0..(1 << k) {
+            for rows in &w.initial_round_opened_rows {
+                out.push(leaf_job(&rows[q][c]));
+            }
+        }
+    }
+    for round in &w.codeword_opened_values {
+        for query in round {
+            for v in query {
+                out.push(leaf_job(v.as_basis_coefficients_slice()));
+            }
+        }
+    }
+    out
+}
