+#[test]
+#[ignore = "legacy chained-transcript path; predates T*, superseded by nv::"]
+fn e2e_mutations_rejected() {
+    let (vk, proof) = child_fib(5);
+    let parent = Sha384CpuEngine::new(parent_params_debug());
+    let native = Sha384CpuEngine::new(child_params_small());
+
+    // 1. One flipped digest: a Merkle sibling of the first initial-round query.
+    {
+        let mut bad = proof.clone();
+        bad.whir_proof.initial_round_merkle_proofs[0][0][1][2] ^= 1;
+        assert!(native.verify(&vk, &bad).is_err());
+        must_fail("merkle-sibling-digest", || {
+            let (airs, ctxs) = build(&vk, &bad, &parent);
+            debug(&parent, &airs, ctxs);
+        });
+    }
+    // 2. One flipped opened value (initial round, query 0, coset 1, column 0).
+    {
+        let mut bad = proof.clone();
+        bad.whir_proof.initial_round_opened_rows[0][0][1][0] += F::ONE;
+        assert!(native.verify(&vk, &bad).is_err());
+        must_fail("opened-value", || {
+            let (airs, ctxs) = build(&vk, &bad, &parent);
+            debug(&parent, &airs, ctxs);
+        });
+    }
+    // 3. One flipped transcript sample: change the first state word read by the
+    //    in-circuit transcript (TranscriptSampleAir row 0) to another accepted word and
+    //    recompute that row's gadget columns, so only the buses can catch it.
+    {
+        use core::borrow::BorrowMut;
+        use p3_field::PrimeField32;
+
+        use crate::transcript::sha_transcript::{fill_sample_row, TranscriptSampleCols};
+        let (airs, mut ctxs) = build(&vk, &proof, &parent);
+        let idx = airs
+            .iter()
+            .position(|a| a.name() == "TranscriptSampleAir")
+            .unwrap();
+        let m = &mut ctxs[idx].common_main;
+        let w = m.width;
+        let row: &mut TranscriptSampleCols<F> = m.values[..w].borrow_mut();
+        let n: u32 = (0..4).map(|k| row.c[k].as_canonical_u32() << (8 * k)).sum();
+        let n2 = n ^ 0x100; // flip a bit of byte 1; stays below 2p
+        assert!((n2 as u64) < SAMPLE_BOUND && (n as u64) < SAMPLE_BOUND);
+        let mut dummy = vec![0u32; 256];
+        fill_sample_row(row, n2, true, &mut dummy);
+        must_fail("transcript-sample", || debug(&parent, &airs, ctxs));
+    }
+    // 4. One flipped commitment limb on the transcript (TranscriptHashAir payload).
+    {
+        let (airs, mut ctxs) = build(&vk, &proof, &parent);
+        let idx = airs
+            .iter()
+            .position(|a| a.name() == "TranscriptHashAir")
+            .unwrap();
+        let m = &mut ctxs[idx].common_main;
+        // row 0 is the commit of the child VK pre-hash; payload starts at column 9 + 48
+        m.values[9 + 48] += F::ONE;
+        must_fail("transcript-commit-limb", || debug(&parent, &airs, ctxs));
+    }
+}
