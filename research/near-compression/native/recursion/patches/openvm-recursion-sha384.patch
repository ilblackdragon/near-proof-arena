+
+/// SWIRL params from `{PREFIX}_*` env vars (defaults: native PQ profile shape).
+/// Load a DKT certificate set (lane/pq-dkt-verify calc/dkt_certs_o2.json): the TOP-LEVEL keys
+/// "n,k,A,1" only (metadata objects such as `_no_certificate` / `_shapes` hold code keys that are
+/// NOT certificates).  Soundness rule: only kernel-proved entries count, so `exclude` (a file of
+/// "n,k,A,ell" lines, e.g. lean/DKTCertsO2_big.keys: engine / #eval!-checked only) is removed.
+pub fn load_dkt_certs(path: &str) -> openvm_stark_backend::CertSet {
+    load_dkt_certs_excluding(path, None)
+}
+
+pub fn load_dkt_certs_excluding(path: &str, exclude: Option<&str>) -> openvm_stark_backend::CertSet {
+    let text = std::fs::read_to_string(path).unwrap_or_else(|e| panic!("DKT certificates {path}: {e}"));
+    let parse = |key: &str| -> Option<(u64, u64, u64)> {
+        let f: Vec<&str> = key.trim().split(',').collect();
+        if f.len() == 4 && f.iter().all(|x| !x.is_empty() && x.bytes().all(|c| c.is_ascii_digit())) && f[3] == "1" {
+            Some((f[0].parse().ok()?, f[1].parse().ok()?, f[2].parse().ok()?))
+        } else {
+            None
+        }
+    };
+    // top-level object keys: strings at brace depth 1 followed by ':'
+    let mut out = openvm_stark_backend::CertSet::new();
+    let b = text.as_bytes();
+    let (mut depth, mut i) = (0i32, 0usize);
+    while i < b.len() {
+        match b[i] {
+            b'{' | b'[' => depth += 1,
+            b'}' | b']' => depth -= 1,
+            b'"' => {
+                let start = i + 1;
+                let mut j = start;
+                while j < b.len() && b[j] != b'"' {
+                    if b[j] == b'\\' {
+                        j += 1;
+                    }
+                    j += 1;
+                }
+                let key = &text[start..j];
+                let mut k = j + 1;
+                while k < b.len() && (b[k] as char).is_whitespace() {
+                    k += 1;
+                }
+                if depth == 1 && k < b.len() && b[k] == b':' {
+                    if let Some(c) = parse(key) {
+                        out.insert(c);
+                    }
+                }
+                i = j;
+            }
+            _ => {}
+        }
+        i += 1;
+    }
+    if let Some(ex) = exclude {
+        let t = std::fs::read_to_string(ex).unwrap_or_else(|e| panic!("DKT exclusion list {ex}: {e}"));
+        for line in t.lines() {
+            if let Some(c) = parse(line) {
+                out.remove(&c);
+            }
+        }
+    }
+    out
+}
