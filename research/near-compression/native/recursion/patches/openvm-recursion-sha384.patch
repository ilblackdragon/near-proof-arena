+fn e2e_measure() {
+    use openvm_stark_backend::prover::DeviceDataTransporter;
+    let child_spec = std::env::var("E2E_CHILD").unwrap_or("fib:10".into());
+    let levels = env_usize("E2E_LEVELS", 1);
