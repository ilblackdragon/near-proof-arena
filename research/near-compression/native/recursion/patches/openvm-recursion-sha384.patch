+// ---------------------------------------------------------------------------------------
+// Trace generation
+// ---------------------------------------------------------------------------------------
+
+/// Per-proof transcript jobs with their global SHA job ids.
+pub struct TranscriptTraceInput<'a> {
+    pub proof_jobs: Vec<(&'a [TrJob], usize)>,
+}
+
+pub struct TranscriptTraces {
+    pub hash: RowMajorMatrix<F>,
+    pub obs: RowMajorMatrix<F>,
+    pub sample: RowMajorMatrix<F>,
+    pub byte_counts: Vec<u32>,
+}
+
+fn pad_height(n: usize) -> usize {
+    n.next_power_of_two().max(1)
+}
+
+pub fn generate_transcript_traces(input: &TranscriptTraceInput) -> TranscriptTraces {
+    generate_transcript_traces_h(input, None)
+}
+
+/// With minimum heights (hash, obs, sample).
+pub fn generate_transcript_traces_h(
+    input: &TranscriptTraceInput,
+    min_h: Option<(usize, usize, usize)>,
+) -> TranscriptTraces {
+    let mh = min_h.unwrap_or((1, 1, 1));
+    let n_jobs: usize = input.proof_jobs.iter().map(|(j, _)| j.len()).sum();
+    let n_obs: usize = input
+        .proof_jobs
+        .iter()
+        .flat_map(|(j, _)| j.iter())
+        .map(|j| j.obs.len())
+        .sum();
+    let n_reads: usize = input
+        .proof_jobs
+        .iter()
+        .flat_map(|(j, _)| j.iter())
+        .map(|j| j.reads.len())
+        .sum();
+    let mut hash = F::zero_vec(pad_height(n_jobs).max(mh.0) * HASH_WIDTH);
+    let mut obs = F::zero_vec(pad_height(n_obs).max(mh.1) * OBS_WIDTH);
+    let sh = pad_height(n_reads).max(mh.2);
+    let mut sample = F::zero_vec(sh * SAMPLE_WIDTH);
+    let mut byte_counts = vec![0u32; 256];
+    let (mut hr, mut or, mut sr) = (0usize, 0usize, 0usize);
+    let fu = |x: usize| F::from_usize(x);
+    for (proof_idx, (jobs, base)) in input.proof_jobs.iter().enumerate() {
+        for (k, j) in jobs.iter().enumerate() {
+            let job = base + k;
+            let r: &mut TranscriptHashCols<F> = hash[hr * HASH_WIDTH..(hr + 1) * HASH_WIDTH].borrow_mut();
+            hr += 1;
+            r.valid = F::ONE;
+            r.proof_idx = fu(proof_idx);
+            r.is_first = F::from_bool(k == 0);
+            r.op_f = F::from_bool(j.op == TrOp::Flush);
+            r.op_c = F::from_bool(j.op == TrOp::Commit);
+            r.op_s = F::from_bool(j.op == TrOp::Squeeze);
+            r.job = fu(job);
+            r.t_start = fu(j.t_start);
+            r.cnt = fu(j.cnt);
+            let (si, so) = (state_limbs(&j.state_in), state_limbs(&j.state_out));
+            for i in 0..DIGEST_SIZE {
+                r.state_in[i] = F::from_u32(si[i]);
+                r.state_out[i] = F::from_u32(so[i]);
+            }
+            if j.op == TrOp::Commit {
+                r.payload = j.payload;
+            }
+            if j.op == TrOp::Squeeze {
+                for rd in &j.reads {
+                    r.rd[rd.wi] = F::ONE;
+                }
+                let last = j.reads.last().unwrap();
+                r.last_wi = fu(last.wi);
+                r.last_acc = F::from_bool(last.acc);
+            }
+            // Observe rows.
+            for (i, &v) in j.obs.iter().enumerate() {
+                let o: &mut TranscriptObsCols<F> = obs[or * OBS_WIDTH..(or + 1) * OBS_WIDTH].borrow_mut();
+                or += 1;
+                o.valid = F::ONE;
+                o.proof_idx = fu(proof_idx);
+                o.job = fu(job);
+                o.tidx = fu(j.t_start + i);
+                o.t_first = fu(j.t_start);
+                o.value = v;
+                o.is_first = F::from_bool(i == 0);
+                o.is_last = F::from_bool(i + 1 == j.obs.len());
+            }
+            // Sample rows.
+            let mut macc = 0usize;
+            for (i, rd) in j.reads.iter().enumerate() {
+                let s: &mut TranscriptSampleCols<F> =
+                    sample[sr * SAMPLE_WIDTH..(sr + 1) * SAMPLE_WIDTH].borrow_mut();
+                sr += 1;
+                macc += rd.acc as usize;
+                fill_sample_row(s, rd.n, rd.acc, &mut byte_counts);
+                s.valid = F::ONE;
+                s.proof_idx = fu(proof_idx);
+                s.job = fu(job);
+                s.wi = fu(rd.wi);
+                s.t_job = fu(j.t_start);
+                s.macc = fu(macc);
+                s.is_first = F::from_bool(i == 0);
+                s.is_last = F::from_bool(i + 1 == j.reads.len());
+            }
+        }
+    }
+    // Sample padding rows: acc = 1 with all gadgets satisfied (no lookups: valid = 0).
+    for r in sr..sh {
+        let s: &mut TranscriptSampleCols<F> = sample[r * SAMPLE_WIDTH..(r + 1) * SAMPLE_WIDTH].borrow_mut();
+        let mut dummy = vec![0u32; 256];
+        fill_sample_row(s, 0, true, &mut dummy);
+    }
+    TranscriptTraces {
+        hash: RowMajorMatrix::new(hash, HASH_WIDTH),
+        obs: RowMajorMatrix::new(obs, OBS_WIDTH),
+        sample: RowMajorMatrix::new(sample, SAMPLE_WIDTH),
+        byte_counts,
+    }
+}
+
+pub(crate) fn fill_sample_row(s: &mut TranscriptSampleCols<F>, n: u32, acc: bool, counts: &mut [u32]) {
+    let b = n.to_le_bytes();
+    for k in 0..4 {
+        s.c[k] = F::from_u8(b[k]);
+        counts[b[k] as usize] += 1;
+    }
+    let g = b[3] >= 0xF0;
+    s.g = F::from_bool(g);
+    let u = if g { b[3] - 0xF0 } else { 0xEF - b[3] };
+    counts[u as usize] += 1;
+    let d3 = F::from_u8(b[3]) - F::from_u32(0xF0);
+    s.z = F::from_bool(d3 == F::ZERO);
+    s.inv_z = if d3 == F::ZERO { F::ZERO } else { d3.inverse() };
+    let v = F::from_u32((b[1] as u32) << 8 | (b[2] as u32) << 16);
+    s.zv = F::from_bool(v == F::ZERO);
+    s.inv_v = if v == F::ZERO { F::ZERO } else { v.inverse() };
+    let w = F::from_u32(b[0] as u32 * b[0] as u32) - F::from_u8(b[0]);
+    s.zc = F::from_bool(w == F::ZERO);
+    s.inv_c = if w == F::ZERO { F::ZERO } else { w.inverse() };
+    let acc_expr = !g || (b[3] == 0xF0 && b[1] == 0 && b[2] == 0 && b[0] <= 1);
+    assert_eq!(acc_expr, acc);
+    assert_eq!(acc, (n as u64) < SAMPLE_BOUND);
+    s.acc = F::from_bool(acc);
+}
+
+#[allow(dead_code)]
+fn _assert_matrix(m: &RowMajorMatrix<F>) -> usize {
+    m.width()
+}
