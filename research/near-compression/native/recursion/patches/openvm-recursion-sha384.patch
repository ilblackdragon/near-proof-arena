+// ---------------------------------------------------------------------------------------
+// Sample AIR
+// ---------------------------------------------------------------------------------------
+
+#[repr(C)]
+#[derive(AlignedBorrow, Debug)]
+pub struct TranscriptSampleCols<T> {
+    pub valid: T,
+    pub proof_idx: T,
+    pub job: T,
+    pub wi: T,
+    pub t_job: T,
+    /// accepted samples in this run up to and including this row
+    pub macc: T,
+    pub is_first: T,
+    pub is_last: T,
+    /// state word bytes in state order: n = c0 + 2^8 c1 + 2^16 c2 + 2^24 c3
+    pub c: [T; 4],
+    /// c3 >= 0xF0
+    pub g: T,
+    /// is_zero(c3 - 0xF0)
+    pub z: T,
+    pub inv_z: T,
+    /// is_zero(2^8 c1 + 2^16 c2)
+    pub zv: T,
+    pub inv_v: T,
+    /// is_zero(c0 (c0 - 1))
+    pub zc: T,
+    pub inv_c: T,
+    /// n < 2p
+    pub acc: T,
+}
+pub const SAMPLE_WIDTH: usize = TranscriptSampleCols::<u8>::width();
+
+pub struct TranscriptSampleAir {
+    pub transcript_bus: TranscriptBus,
+    /// NV: emit transcript events on this slot bus as (0, tidx, 0, kind, value, 0).
+    pub slot_bus: Option<BusIndex>,
+    pub sha: ShaBusInventory,
+    pub internal: TranscriptInternalBuses,
+}
+impl<F> BaseAir<F> for TranscriptSampleAir {
+    fn width(&self) -> usize {
+        SAMPLE_WIDTH
+    }
+}
+impl<F> BaseAirWithPublicValues<F> for TranscriptSampleAir {}
+impl<F> PartitionedBaseAir<F> for TranscriptSampleAir {}
+
+impl<AB: AirBuilder + InteractionBuilder> Air<AB> for TranscriptSampleAir {
+    fn eval(&self, builder: &mut AB) {
+        let main = builder.main();
+        let (local, next) = (main.row_slice(0).unwrap(), main.row_slice(1).unwrap());
+        let l: &TranscriptSampleCols<AB::Var> = (*local).borrow();
+        let n: &TranscriptSampleCols<AB::Var> = (*next).borrow();
+        let one = AB::Expr::ONE;
+        let c = |v: u64| AB::Expr::from_u64(v);
+        run_sequencing::<AB>(builder, l.valid.into(), l.is_first.into(), l.is_last.into(), n.valid.into(), n.is_first.into());
+        builder.assert_bool(l.g);
+        builder.when(l.is_first).assert_zero(l.wi);
+        builder.when(l.is_first).assert_eq(l.macc, l.acc);
+        {
+            let mut t = builder.when_transition();
+            let mut s = t.when(n.valid - n.is_first);
+            s.assert_eq(n.job, l.job);
+            s.assert_eq(n.proof_idx, l.proof_idx);
+            s.assert_eq(n.wi, l.wi + one.clone());
+            s.assert_eq(n.t_job, l.t_job);
+            s.assert_eq(n.macc, l.macc + n.acc);
+        }
+        // Acceptance n < 0xF0000002.
+        let d3 = l.c[3] - c(0xF0);
+        builder.assert_zero(l.z * d3.clone());
+        builder.assert_eq(d3 * l.inv_z, one.clone() - l.z);
+        let v = l.c[1] * c(1 << 8) + l.c[2] * c(1 << 16);
+        builder.assert_zero(l.zv * v.clone());
+        builder.assert_eq(v * l.inv_v, one.clone() - l.zv);
+        let w = l.c[0] * l.c[0] - l.c[0];
+        builder.assert_zero(l.zc * w.clone());
+        builder.assert_eq(w * l.inv_c, one.clone() - l.zc);
+        builder.assert_eq(l.acc, one.clone() - l.g + l.g * l.z * l.zv * l.zc);
+        let byte = self.sha.byte_bus();
+        for k in 0..4 {
+            byte.lookup_key(builder, [l.c[k]], l.valid);
+        }
+        let u = l.g * (l.c[3] - c(0xF0)) + (one.clone() - l.g) * (c(0xEF) - l.c[3]);
+        byte.lookup_key(builder, [u], l.valid);
+
+        let value = l.c[0] + l.c[1] * c(1 << 8) + l.c[2] * c(1 << 16) + l.c[3] * c(1 << 24);
+        emit_tr(
+            &self.transcript_bus,
+            self.slot_bus,
+            builder,
+            l.proof_idx,
+            l.t_job + l.macc - l.acc,
+            value,
+            c(KIND_SAMPLE as u64),
+            l.acc * l.valid,
+        );
+        PermutationCheckBus::new(self.internal.word).receive(
+            builder,
+            [
+                l.job.into(),
+                l.wi.into(),
+                l.c[0] * c(256) + l.c[1],
+                l.c[2] * c(256) + l.c[3],
+            ],
+            l.valid,
+        );
+        PermutationCheckBus::new(self.internal.sample).send(
+            builder,
+            [l.proof_idx, l.job, l.t_job, l.macc, l.wi, l.acc],
+            l.is_last,
+        );
+    }
+}
