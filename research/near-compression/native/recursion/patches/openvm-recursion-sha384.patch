+//! NV hashing subsystem, word format v2 (air2 limbs).  Same job model as
+//! `sha384/airs.rs` (framed messages `PREFIX || tag || units`), with:
+//! * units: a canonical felt (4 LE bytes) or a whole 64-bit word (8 BE bytes, e.g. a
+//!   digest/state word given as air2 limbs; it occupies two unit indices);
+//! * words to the compression AIR as air2 limbs, interface messages as word pairs;
+//! * framing, packing and block chaining live in the GLUE role (glue.rs).
+use core::borrow::{Borrow, BorrowMut};
+
+use openvm_recursion_circuit_derive::AlignedBorrow;
+use openvm_stark_backend::{
+    interaction::{BusIndex, InteractionBuilder, LookupBus, PermutationCheckBus},
+    BaseAirWithPublicValues, PartitionedBaseAir,
+};
+use p3_air::{Air, AirBuilder, BaseAir};
+use p3_field::{Field, PrimeCharacteristicRing};
+use p3_matrix::{dense::RowMajorMatrix, Matrix};
+use p3_maybe_rayon::prelude::*;
+
+use super::fmt::{limbs_from_bytes, split_bits, wl, NV_DIGEST};
+use crate::sha384::{
+    compress4_air::{Layout, ROWS},
+    compress4_trace::{gen_main, gen_table, main_height, sha2_compress, Comp, SHA384_IV},
+    config::{sha_levers, F},
+};
+
+#[derive(Clone, Copy, Debug)]
+pub struct HashBuses {
+    pub ctl: BusIndex,
+    pub k: BusIndex,
+    pub lb: BusIndex,
+    pub iface: BusIndex,
+    pub word: BusIndex,
+    /// slot bus: units carry channel 1, transcript events channel 0
+    pub slot: BusIndex,
+    pub job: BusIndex,
+    pub digest: BusIndex,
+    pub byte: BusIndex,
+}
+
+pub const UNIT_FELT: u32 = 0;
+pub const UNIT_WORD: u32 = 2;
+/// kind of a 42-byte digest tail unit (top 2 bytes of word 5)
+pub const UNIT_HALF: u32 = 3;
+/// job-bus tag of Merkle node jobs (outside the byte range of prefix-job tags)
+pub const NODE_TAG: u32 = 256;
+
+impl HashBuses {
+    pub fn sha(&self) -> crate::sha384::compress2_air::Sha2Buses {
+        crate::sha384::compress2_air::Sha2Buses {
+            ctl: self.ctl,
+            k: self.k,
+            lb: self.lb,
+            iface: self.iface,
+        }
+    }
+    /// Producer: felt unit.
+    pub fn send_felt<AB: InteractionBuilder>(
+        &self,
+        b: &mut AB,
+        job: impl Into<AB::Expr>,
+        idx: impl Into<AB::Expr>,
+        v: impl Into<AB::Expr>,
+        en: impl Into<AB::Expr>,
+    ) {
+        PermutationCheckBus::new(self.slot).send(
+            b,
+            [
+                AB::Expr::ONE,
+                job.into(),
+                idx.into(),
+                AB::Expr::from_u32(UNIT_FELT),
+                v.into(),
+                AB::Expr::ZERO,
+                AB::Expr::ZERO,
+            ],
+            en,
+        );
+    }
+    /// Producer: word unit (3 limbs), occupies unit indices idx, idx + 1.
+    pub fn send_word<AB: InteractionBuilder>(
+        &self,
+        b: &mut AB,
+        job: impl Into<AB::Expr>,
+        idx: impl Into<AB::Expr>,
+        l: [AB::Expr; 3],
+        en: impl Into<AB::Expr>,
+    ) {
+        let [l0, l1, l2] = l;
+        PermutationCheckBus::new(self.slot).send(
+            b,
+            [
+                AB::Expr::ONE,
+                job.into(),
+                idx.into(),
+                AB::Expr::from_u32(UNIT_WORD),
+                l0,
+                l1,
+                l2,
+            ],
+            en,
+        );
+    }
+    pub fn send_job<AB: InteractionBuilder>(
+        &self,
+        b: &mut AB,
+        job: impl Into<AB::Expr>,
+        tag: impl Into<AB::Expr>,
+        en: impl Into<AB::Expr>,
+    ) {
+        self.send_job_tr(b, job, tag, AB::Expr::ZERO, en);
+    }
+    /// Job start (job, tag, tr): tr = 1 for Merkle jobs (leaf / node; truncated 42-byte digest).
+    pub fn send_job_tr<AB: InteractionBuilder>(
+        &self,
+        b: &mut AB,
+        job: impl Into<AB::Expr>,
+        tag: impl Into<AB::Expr>,
+        tr: impl Into<AB::Expr>,
+        en: impl Into<AB::Expr>,
+    ) {
+        PermutationCheckBus::new(self.job).send(b, [job.into(), tag.into(), tr.into()], en);
+    }
+    /// Consumer: digest pair j (words 2j, 2j+1 as 6 limbs) of `job`.
+    pub fn receive_digest_pair<AB: InteractionBuilder>(
+        &self,
+        b: &mut AB,
+        job: impl Into<AB::Expr>,
+        j: usize,
+        limbs: &[AB::Expr],
+        en: impl Into<AB::Expr>,
+    ) {
+        assert_eq!(limbs.len(), 6);
+        let msg: Vec<AB::Expr> = [job.into(), AB::Expr::from_usize(j)]
+            .into_iter()
+            .chain(limbs.iter().cloned())
+            .collect();
+        PermutationCheckBus::new(self.digest).receive(b, msg, en);
+    }
+    /// Consumer: the 18-limb digest of `job` (3 pairs).
+    pub fn receive_digest<AB: InteractionBuilder>(
+        &self,
+        b: &mut AB,
+        job: impl Into<AB::Expr>,
+        limbs: &[AB::Expr],
+        en: impl Into<AB::Expr>,
+    ) {
+        let (job, en): (AB::Expr, AB::Expr) = (job.into(), en.into());
+        for j in 0..3 {
+            self.receive_digest_pair(b, job.clone(), j, &limbs[6 * j..6 * j + 6], en.clone());
+        }
+    }
+}
+
+pub fn iv_limbs18() -> [u32; 24] {
+    std::array::from_fn(|i| wl(SHA384_IV[i / 3])[i % 3])
+}
+
+/// Byte-pair table: one row per (x, y) in [0, 256)^2 (x fastest); the byte bus carries
+/// pairs (x, y); a single byte v is looked up as (v, 0).
+/// Columns: x, y, z = [x = 255], inv = (x - 255)^-1 (0 if x = 255), multiplicity.
+#[derive(Clone, Copy, Debug)]
+pub struct ByteAir {
+    pub buses: HashBuses,
+}
+pub const BYTE_W: usize = 5;
+impl<T> BaseAir<T> for ByteAir {
+    fn width(&self) -> usize {
+        BYTE_W
+    }
+}
+impl<T> BaseAirWithPublicValues<T> for ByteAir {}
+impl<T> PartitionedBaseAir<T> for ByteAir {}
+impl<AB: AirBuilder + InteractionBuilder> Air<AB> for ByteAir {
+    fn eval(&self, builder: &mut AB) {
+        let main = builder.main();
+        let (local, next) = (main.row_slice(0).unwrap(), main.row_slice(1).unwrap());
+        let (x, y, z, inv) = (local[0], local[1], local[2], local[3]);
+        let one = AB::Expr::ONE;
+        let top = AB::Expr::from_u32(255);
+        builder.assert_bool(z);
+        builder.assert_zero(z * (x - top.clone()));
+        builder.assert_eq((x - top.clone()) * inv, one.clone() - z);
+        builder.when_first_row().assert_zero(x);
+        builder.when_first_row().assert_zero(y);
+        builder.when_transition().assert_eq(next[0], (x + one.clone()) * (one.clone() - z));
+        builder.when_transition().assert_eq(next[1], y + z);
+        builder.when_last_row().assert_eq(x, top.clone());
+        builder.when_last_row().assert_eq(y, top);
+        LookupBus::new(self.buses.byte).add_key_with_lookups(builder, [x, y], local[4]);
+    }
+}
+
+/// Byte-pair lookup (both entries must be bytes).
+pub fn lookup_pair<AB: InteractionBuilder>(b: &mut AB, bus: BusIndex, x: impl Into<AB::Expr>, y: impl Into<AB::Expr>, en: impl Into<AB::Expr>) {
+    LookupBus::new(bus).lookup_key(b, [x.into(), y.into()], en);
+}
+/// Single byte lookup, as the pair (v, 0).
+pub fn lookup_byte<AB: InteractionBuilder>(b: &mut AB, bus: BusIndex, v: impl Into<AB::Expr>, en: impl Into<AB::Expr>) {
+    LookupBus::new(bus).lookup_key(b, [v.into(), AB::Expr::ZERO], en);
+}
+/// Count a pair lookup in the 65536-entry table counts.
+#[inline]
+pub fn cnt2(counts: &mut [u32], x: usize, y: usize) {
+    counts[x + 256 * y] += 1;
+}
+pub const BYTE_TABLE: usize = 1 << 16;
+
+// ---------------------------------------------------------------------------------------
+// Trace generation
+// ---------------------------------------------------------------------------------------
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum U2 {
+    Felt(u32),
+    Word(u64),
+    /// the top 2 bytes of a word (tail of a 42-byte digest); occupies 2 unit indices and is
+    /// carried as a word unit whose low 6 bytes are zero
+    Half(u64),
+}
+impl U2 {
+    pub fn nunits(self) -> usize {
+        match self {
+            U2::Felt(_) => 1,
+            U2::Word(_) | U2::Half(_) => 2,
+        }
+    }
+    pub fn bytes(self) -> Vec<u8> {
+        match self {
+            U2::Felt(x) => x.to_le_bytes().to_vec(),
+            U2::Word(w) => w.to_be_bytes().to_vec(),
+            U2::Half(w) => w.to_be_bytes()[..2].to_vec(),
+        }
+    }
+}
+/// A digest as word units: 6 words (48 B) or 5 words + a 2-byte tail (42 B).
+pub fn digest_units(words: [u64; 6]) -> Vec<U2> {
+    let mut v: Vec<U2> = words[..5].iter().map(|&w| U2::Word(w)).collect();
+    v.push(if crate::sha384::config::sha_levers().digest_bytes == 42 { U2::Half(words[5]) } else { U2::Word(words[5]) });
+    v
+}
+
+#[derive(Clone, Debug)]
+pub struct Job2 {
+    /// job id (unit / digest key)
+    pub id: u32,
+    /// Merkle node job: message NODE_WORD || 12 word units (no prefix / tag / lengths)
+    pub node: bool,
+    pub tag: u8,
+    pub units: Vec<U2>,
+    /// transcript blocks: output words read by the sample role (bit w = word w); GLUE sends
+    /// each such word once more on the digest bus
+    pub wread: u8,
+}
+impl Job2 {
+    pub fn message(&self) -> Vec<u8> {
+        if self.node {
+            let mut m = sha_levers().node_prefix().to_vec();
+            for u in &self.units {
+                assert!(matches!(u, U2::Word(_) | U2::Half(_)));
+                m.extend(u.bytes());
+            }
+            assert_eq!(m.len(), 8 + 2 * sha_levers().digest_bytes);
+            return m;
+        }
+        let mut m = sha_levers().prefix().to_vec();
+        m.push(self.tag);
+        for u in &self.units {
+            m.extend(u.bytes());
+        }
+        m
+    }
+    pub fn num_blocks(&self) -> usize {
+        (self.message().len() + 17).div_ceil(128)
+    }
+}
+
+pub fn sha384_blocks(msg: &[u8]) -> (Vec<Comp>, [u64; 6]) {
+    let blocks = crate::sha384::compress2_trace::pad_message(msg);
+    let mut h = SHA384_IV;
+    let mut comps = Vec::with_capacity(blocks.len());
+    for b in blocks {
+        let c = Comp { h, block: b };
+        h = sha2_compress(&c);
+        comps.push(c);
+    }
+    (comps, std::array::from_fn(|i| h[i]))
+}
+
+#[derive(Default)]
+pub struct Work2 {
+    pub jobs: Vec<Job2>,
+    /// direct compressions (Merkle nodes): compression ids 0..nodes.len()
+    pub nodes: Vec<Comp>,
+}
+
+pub struct Traces2 {
+    pub compress: RowMajorMatrix<F>,
+    pub table: RowMajorMatrix<F>,
+    /// GLUE rows (pair rows, see glue.rs), GLUE_W wide, unpadded
+    pub glue_rows: Vec<[F; super::glue::GLUE_W]>,
+    pub byte_counts: Vec<u32>,
+    pub job_digests: Vec<[u64; 6]>,
+    pub n_compressions: usize,
+}
+
+fn to_f(v: Vec<u32>, width: usize) -> RowMajorMatrix<F> {
+    RowMajorMatrix::new(v.into_par_iter().map(F::from_u32).collect(), width)
+}
+
+/// Compression trace (node compressions first, then the job blocks) and the GLUE rows.
+pub fn generate2(work: &Work2, lay: Layout, min_compress_h: Option<usize>) -> Traces2 {
+    let job_blocks: Vec<(Vec<Comp>, [u64; 6])> = work
+        .jobs
+        .par_iter()
+        .map(|j| sha384_blocks(&j.message()))
+        .collect();
+    let mut comps = work.nodes.clone();
+    comps.extend(job_blocks.iter().flat_map(|b| b.0.iter().copied()));
+    let ch = main_height(comps.len()).max(min_compress_h.unwrap_or(1));
+    let main = gen_main(&comps, ch);
+    let table = gen_table(&main, ch);
+    let mut byte_counts = vec![0u32; BYTE_TABLE];
+    let glue_rows = super::glue::glue_rows(&work.jobs, &job_blocks, work.nodes.len(), &mut byte_counts);
+    Traces2 {
+        compress: to_f(main, lay.width),
+        table: to_f(table, crate::sha384::compress4_air::T_WIDTH),
+        glue_rows,
+        byte_counts,
+        job_digests: job_blocks.iter().map(|b| b.1).collect(),
+        n_compressions: comps.len(),
+    }
+}
+
+pub fn byte_table2(counts: &[u32]) -> RowMajorMatrix<F> {
+    assert_eq!(counts.len(), BYTE_TABLE);
+    let mut v = F::zero_vec(BYTE_TABLE * BYTE_W);
+    let inv255 = |x: usize| {
+        let d = F::from_usize(x) - F::from_u32(255);
+        if d == F::ZERO { F::ZERO } else { d.inverse() }
+    };
+    for r in 0..BYTE_TABLE {
+        let (x, y) = (r % 256, r / 256);
+        let row = &mut v[r * BYTE_W..(r + 1) * BYTE_W];
+        row[0] = F::from_usize(x);
+        row[1] = F::from_usize(y);
+        row[2] = F::from_bool(x == 255);
+        row[3] = inv255(x);
+        row[4] = F::from_u32(counts[r]);
+    }
+    RowMajorMatrix::new(v, BYTE_W)
+}
+
+#[allow(dead_code)]
+fn _w(m: &RowMajorMatrix<F>) -> usize {
+    m.width()
+}
diff --git a/crates/recursion/src/nv/hash_tests.rs b/crates/recursion/src/nv/hash_tests.rs
new file mode 100644
index 0000000..ddcb0ca
--- /dev/null
+++ b/crates/recursion/src/nv/hash_tests.rs
@@ -0,0 +1,221 @@
+//! Standalone test of the NV v2 hashing subsystem on the air2 compression AIR.
+use std::sync::Arc;
+
+use openvm_cpu_backend::CpuBackend;
+use openvm_stark_backend::{
+    interaction::{InteractionBuilder, PermutationCheckBus},
+    prover::{AirProvingContext, ProvingContext},
+    test_utils::test_system_params_small,
+    AirRef, BaseAirWithPublicValues, PartitionedBaseAir, StarkEngine,
+};
+use p3_air::{Air, AirBuilder, BaseAir};
+use p3_field::PrimeCharacteristicRing;
+use p3_matrix::{dense::RowMajorMatrix, Matrix};
+
+use super::{fmt::*, glue::{glue_matrix, GlueAir}, hash::*};
+use crate::sha384::{
+    compress4_air::{Layout, Sha512Air4, TableAir4, ROWS},
+    compress2_trace::{sha2_compress, Comp, Rng},
+    config::*,
+};
+
+fn buses() -> HashBuses {
+    HashBuses { ctl: 0, k: 1, lb: 2, iface: 3, word: 4, slot: 5, job: 6, digest: 7, byte: 8 }
+}
+
+// producer row: [m_felt, m_word, m_job, m_dig, m_if, job, idx, v0, v1, v2, tag, d[18], cid, l[6]]
+const PW: usize = 11 + 18 + 7 + 1 + 1; // + half flag (42-B digest tail, kind UNIT_HALF)
+#[derive(Clone, Copy)]
+struct Prod(HashBuses);
+impl<T> BaseAir<T> for Prod {
+    fn width(&self) -> usize {
+        PW
+    }
+}
+impl<T> BaseAirWithPublicValues<T> for Prod {}
+impl<T> PartitionedBaseAir<T> for Prod {}
+impl<AB: AirBuilder + InteractionBuilder> Air<AB> for Prod {
+    fn eval(&self, b: &mut AB) {
+        let main = b.main();
+        let l: Vec<AB::Expr> = main.row_slice(0).unwrap().iter().map(|&v| v.into()).collect();
+        for k in 0..5 {
+            b.assert_bool(l[k].clone());
+        }
+        self.0.send_felt(b, l[5].clone(), l[6].clone(), l[7].clone(), l[0].clone());
+        b.assert_bool(l[37].clone());
+        let kind = AB::Expr::from_u32(UNIT_WORD) + l[37].clone() * AB::Expr::from_u32(UNIT_HALF - UNIT_WORD);
+        PermutationCheckBus::new(self.0.slot).send(
+            b,
+            [AB::Expr::ONE, l[5].clone(), l[6].clone(), kind, l[7].clone(), l[8].clone(), l[9].clone()],
+            l[1].clone(),
+        );
+        self.0.send_job_tr(b, l[5].clone(), l[10].clone(), l[1].clone() * AB::Expr::ZERO + l[36].clone(), l[2].clone());
+        self.0.receive_digest(b, l[5].clone(), &l[11..29], l[3].clone());
+        let mut msg = vec![l[29].clone(), l[6].clone()];
+        msg.extend(l[30..36].iter().cloned());
+        PermutationCheckBus::new(self.0.iface).receive(b, msg, l[4].clone());
+    }
+}
+
+fn jobs(rng: &mut Rng) -> Vec<Job2> {
+    let mut out = vec![];
+    for (i, n) in [0usize, 1, 2, 5, 13, 14, 15, 16, 17, 20, 21, 22, 23, 40, 47, 48, 49, 80, 81, 200].into_iter().enumerate() {
+        let mut units = vec![];
+        let mut cnt = 0;
+        while cnt < n {
+            if rng.next() % 3 == 0 && cnt + 2 <= n && cnt % 2 == 0 {
+                units.push(U2::Word(rng.next()));
+                cnt += 2;
+            } else {
+                let x = match rng.next() % 4 { 0 => 2013265920u32, 1 => 0x78000000 - 1, _ => (rng.next() % 2013265921) as u32 };
+                units.push(U2::Felt(x));
+                cnt += 1;
+            }
+        }
+        out.push(Job2 { id: i as u32, node: false, tag: [0u8, 3, 4, 5, 6][i % 5], units, wread: 0 });
+    }
+    // Merkle-node jobs: 12 aligned word units
+    for t in 0..3 {
+        let mut units = digest_units(std::array::from_fn(|_| rng.next()));
+        units.extend(digest_units(std::array::from_fn(|_| rng.next())));
+        out.insert(2 * t + 1, Job2 { id: 100 + t as u32, node: true, tag: 0, units, wread: 0 });
+    }
+    // commit-shaped transcript jobs (48 B: 6 word units; 42 B: 5 words + 2-byte tail)
+    for t in 0..2 {
+        let mut units = vec![U2::Felt(48), U2::Felt(0)];
+        units.extend((0..6).map(|_| U2::Word(rng.next())));
+        units.push(U2::Felt(crate::sha384::config::sha_levers().digest_bytes as u32));
+        units.push(U2::Felt(0));
+        units.extend(digest_units(std::array::from_fn(|_| rng.next())));
+        out.push(Job2 { id: 200 + t as u32, node: false, tag: 4, units, wread: 0 });
+    }
+    out
+}
+
+fn prod_trace(work: &Work2, dig: &[[u64; 6]]) -> RowMajorMatrix<F> {
+    let mut rows: Vec<[u32; PW]> = vec![];
+    for (job, j) in work.jobs.iter().enumerate() {
+        let mut r = [0u32; PW];
+        r[2] = 1;
+        r[5] = j.id;
+        r[10] = if j.node { NODE_TAG } else { j.tag as u32 };
+        r[36] = (j.node || j.tag == 0 || j.tag == crate::sha384::config::TAG_COSET_LEAF) as u32;
+        rows.push(r);
+        let mut idx = 0;
+        for u in &j.units {
+            let mut r = [0u32; PW];
+            r[5] = j.id;
+            r[6] = idx;
+            match *u {
+                U2::Felt(x) => {
+                    r[0] = 1;
+                    r[7] = x;
+                }
+                U2::Word(w) => {
+                    r[1] = 1;
+                    let l = wl(w);
+                    r[7..10].copy_from_slice(&l);
+                }
+                U2::Half(w) => {
+                    r[1] = 1;
+                    // prefix-job tails are UNIT_HALF; node-job tails ride the fixed node framing (kind word)
+                    r[37] = (!j.node) as u32;
+                    let l = wl(w & 0xffff_0000_0000_0000);
+                    r[7..10].copy_from_slice(&l);
+                }
+            }
+            idx += u.nunits() as u32;
+            rows.push(r);
+        }
+        let mut r = [0u32; PW];
+        r[3] = 1;
+        r[5] = j.id;
+        let trunc = crate::sha384::config::sha_levers().digest_bytes == 42
+            && (j.node || j.tag == 0 || j.tag == crate::sha384::config::TAG_COSET_LEAF);
+        for q in 0..6 {
+            let w = if trunc && q == 5 { dig[job][q] & 0xffff_0000_0000_0000 } else { dig[job][q] };
+            let l = wl(w);
+            r[11 + 3 * q..14 + 3 * q].copy_from_slice(&l);
+        }
+        rows.push(r);
+    }
+    for (s, c) in work.nodes.iter().enumerate() {
+        let out = sha2_compress(c);
+        let ws: Vec<u64> = c.h.iter().chain(c.block.iter()).chain(out.iter()).copied().collect();
+        for m in 0..16 {
+            let mut r = [0u32; PW];
+            r[4] = 1;
+            r[6] = m as u32;
+            r[29] = (s * ROWS) as u32;
+            r[30..33].copy_from_slice(&wl(ws[2 * m]));
+            r[33..36].copy_from_slice(&wl(ws[2 * m + 1]));
+            rows.push(r);
+        }
+    }
+    let h = rows.len().next_power_of_two();
+    rows.resize(h, [0; PW]);
+    RowMajorMatrix::new(rows.into_iter().flatten().map(F::from_u32).collect(), PW)
+}
+
+fn run(work: &Work2, mutate: Option<(usize, usize, usize)>) {
+    let b = buses();
+    let lay = Layout::new(sha_k());
+    let t = generate2(work, lay, None);
+    for (j, d) in work.jobs.iter().zip(&t.job_digests) {
+        use sha2::Digest as _;
+        let native: [u8; 48] = sha2::Sha384::digest(j.message()).into();
+        assert_eq!(digest_bytes(digest_from_words(*d)), native);
+    }
+    let airs: Vec<AirRef<Sha384Config>> = vec![
+        Arc::new(Sha512Air4 { lay, buses: b.sha(), cid_offset: 0 }),
+        Arc::new(TableAir4 { lay, buses: b.sha() }),
+        Arc::new(GlueAir { buses: b }),
+        Arc::new(ByteAir { buses: b }),
+        Arc::new(Prod(b)),
+    ];
+    let mut mats = vec![t.compress, t.table, glue_matrix(&t.glue_rows, 1), byte_table2(&t.byte_counts), prod_trace(work, &t.job_digests)];
+    if let Some((m, r, c)) = mutate {
+        let w = mats[m].width();
+        mats[m].values[r * w + c] += F::ONE;
+    }
+    let ctxs: Vec<AirProvingContext<CpuBackend<Sha384Config>>> = mats.into_iter().map(AirProvingContext::simple_no_pis).collect();
+    let mut params = test_system_params_small(2, 18, 3);
+    params.max_constraint_degree = lay.degree().max(4);
+    let engine = Sha384CpuEngine::new(params);
+    engine.debug(&airs, &ProvingContext::new(ctxs.into_iter().enumerate().collect()));
+}
+
+#[test]
+fn nv_hash2_random_jobs() {
+    let mut rng = Rng(0x5eed_1234_abcd_0001);
+    let jobs = jobs(&mut rng);
+    let nodes: Vec<Comp> = (0..3).map(|_| rng.comp()).collect();
+    run(&Work2 { jobs, nodes }, None);
+}
+
+#[test]
+fn nv_hash2_rejects_mutations() {
+    let mut rng = Rng(0x0dd5_eed0_0000_0002);
+    let jobs = jobs(&mut rng)[..10].to_vec();
+    let work = Work2 { jobs, nodes: vec![] };
+    run(&work, None);
+    // GLUE bytes / flags / splits / state pairs (column 0 = role flag)
+    let gc = |name: &str| -> usize {
+        match name {
+            "cid" => 6, "act" => 10, "uidx" => 12, "b1" => 14, "b5" => 18, "b7" => 20, "b9" => 22,
+            "carry" => 29, "lo0" => 30, "ulo0" => 34, "p0" => 38, "wd0" => 42, "s0" => 48,
+            _ => unreachable!(),
+        }
+    };
+    let mut cases = vec![];
+    for r in [2usize, 3, 5, 9, 12, 14] {
+        for n in ["cid", "act", "uidx", "b1", "b5", "b7", "b9", "carry", "lo0", "ulo0", "p0", "wd0", "s0"] {
+            cases.push((2usize, r, gc(n)));
+        }
+    }
+    cases.push((4, 3, 7));
+    for case in cases {
+        let res = std::panic::catch_unwind(std::panic::AssertUnwindSafe(|| run(&work, Some(case))));
+        assert!(res.is_err(), "mutation {case:?} accepted");
+    }
+}
diff --git a/crates/recursion/src/nv/isa.rs b/crates/recursion/src/nv/isa.rs
new file mode 100644
index 0000000..e5491de
--- /dev/null
+++ b/crates/recursion/src/nv/isa.rs
@@ -0,0 +1,162 @@
+//! NV ALU instruction set.  One instruction per ALU row; every row writes its result
+//! `c` (an Ext12 value) to memory address = its row index.  Program words:
+//!   P0 = A  (operand address, or base-field immediate)
+//!   P1 = B + 2^17 * op   (operand address, or small immediate)
+//!   P2 = key1 (transcript index / SHA job id / key id)
+//!   P3 = key2 (unit index / key id)
+//! These four columns are the program; NV binds a child's program to its own by an
+//! in-circuit multilinear evaluation (see DESIGN.md §2.1).
+
+/// Address bits available for operand `B` in `P1`.
+/// Address / B-field width: 24 bits (NvAir up to 2^24 rows; L1 over a real base needs > 2^20).
+/// P1 = B + op * 2^24 < 40 * 2^24 < p, so the decomposition stays unique.
+pub const ADDR_BITS: u32 = 24;
+pub const MAX_ROWS: usize = 1 << ADDR_BITS;
+
+#[repr(u32)]
+#[derive(Clone, Copy, Debug, PartialEq, Eq, Hash, PartialOrd, Ord)]
+pub enum Op {
+    /// padding: c = 0, no reads (opcode 0 so padding contributes nothing to the binding sum)
+    Nop = 0,
+    /// c = a * b (Ext12)
+    Mul = 1,
+    /// c = a + b
+    Add = 2,
+    /// c = a - b
+    Sub = 3,
+    /// c = A (base immediate in coefficient 0)
+    Const = 4,
+    /// c = A * X (coefficient 1)
+    ConstX = 5,
+    /// c = free witness (bound by later uses)
+    Load = 6,
+    /// c = a; push c0 as felt unit of job P2 at unit index P3 (transcript observe)
+    Unit1 = 7,
+    /// anchor transcript job P2: send (2, P2, 0, 0, A = t_start, B = count, 0); c = 0
+    Anchor = 8,
+    /// c = a; push B (2 or 4) word units (limbs c[3i..3i+3]) of job P2 at unit index P3 + 2i
+    UnitW = 9,
+    /// c0 = sample at tidx P2 (c1..c11 = 0)
+    Smp1 = 10,
+    /// c = 12 samples at tidx P2..P2+11
+    Smp12 = 11,
+    /// c = a; push c0..c11 as felt units of SHA job P2 at unit index P3..P3+11
+    Unit12 = 12,
+    /// c = a * b + wit; push wit as felt unit of job P2 at unit index P3
+    Horn = 13,
+    /// start SHA job P2 with tag A; push length units (B bytes, 0) at unit index 0, 1
+    Job = 14,
+    /// c = a, a0 in {0,1}, a1..a11 = 0
+    Bit = 15,
+    /// assert a == 0; c = 0
+    Zero = 16,
+    /// c = digest pairs P3 .. P3 + B - 1 (B in {1, 2}) of job P2, received from the digest
+    /// bus (6 limbs per pair; c[6..12] = 0 if B = 1)
+    Dig = 17,
+    /// start a Merkle-node job P2 (tag A = NODE_TAG; 12 word units pushed by UnitW); c = 0
+    NodeJob = 18,
+    /// c = binding accumulator total (last row)
+    Acc = 19,
+    /// c = 2a + b
+    DblAdd = 20,
+    /// c = a * b + a
+    MulAddA = 21,
+    /// c = a; a0 == public value 0 (the recursion level)
+    Pv = 22,
+    /// c = a; push 4 word units of job P2 at unit index P3 + 2i + 12 b0 (Merkle L/R by bit b)
+    UnitWS4 = 23,
+    /// c = a; push 2 word units of job P2 at unit index P3 + 2i + 12 b0
+    UnitWS2 = 24,
+    /// c = PoW output word 0 limbs of transcript job P2 (from the hash chain, slot chan 3)
+    PowChk = 25,
+    /// Reserved (was `Data`, the app-table data row; removed with G2): no semantics beyond c = 0
+    /// (like Nop); never emitted.
+    Rsv26 = 26,
+    /// Reserved (was `Acc2`, the app-binding total; removed with G2): c = 0; never emitted.
+    Rsv27 = 27,
+    /// c = free witness bit: c0 in {0, 1}, c1..c11 = 0 (one row instead of Load + Bit)
+    LoadBit = 28,
+    /// c = free base-field witness: c1..c11 = 0 (a plain `Load` leaves all 12 coefficients
+    /// free; base-field loads must use this op, FAITHFUL.md bug B3)
+    LoadF = 29,
+    /// c = a; push word unit c[0..3] (kind word) at unit index P3 and the 42-byte digest tail
+    /// c[3..6] (kind UNIT_HALF) at P3 + 2 of job P2 (42-B commitment words 4, 5)
+    UnitWT = 30,
+    /// c = a; expose the statement digest: a's coefficients = public values 1..13 (P2 = 0, lo
+    /// cell) or 13..19 with c6..c11 = 0 (P2 = 1, hi cell)  (final-soundness G1)
+    PvD = 31,
+    /// Merkle sibling, low digest cell: c = free witness (the sibling's 12 limbs); push word units
+    /// c[0..12] at unit index P3 + 12 (1 - B) of job P2 (B = the path bit read at the B field).
+    /// Replaces Load + one_minus + UnitWS4 (3 rows) for the sibling.  Also starts node job P2
+    /// with tag P0 (= NODE_TAG) on the job bus, replacing the level's NodeJob row.
+    SibWS4 = 32,
+    /// Merkle sibling, high digest cell: as SibWS4 for 2 word units (c[0..6]; c[6..12] = 0).
+    SibWS2 = 33,
+    /// Merkle path, current digest, low cell: c = digest pairs 0, 1 of the child job P0 (digest
+    /// bus), pushed as word units c[0..12] at P3 + 12 B of job P2 (B = the path bit). Replaces
+    /// Dig + UnitWS4 (2 rows).
+    DigWS4 = 34,
+    /// As DigWS4 for the high cell: digest pair 2 of job P0, 2 word units (c[6..12] = 0).
+    DigWS2 = 35,
+    /// Horner start: c = a; the next row's c = a (the leading coefficient).
+    HornS = 36,
+    /// Horner step: c free (set by the previous row); the next row's c = c * b + a
+    /// (b = the evaluation point, a = the next coefficient).
+    HornR = 37,
+    /// Horner end: c free (set by the previous HornR row); no transition.
+    HornE = 38,
+    /// Two Horner steps over base witnesses: c = a b^2 + w1 b + w2 (w1 = wit, w2 = wit2),
+    /// pushing w2, w1 as felt units P3, P3 + 1 of job P2 (degree 3: NvAir stays within the SHA
+    /// AIR's degree 9).
+    Horn2 = 39,
+}
+
+pub const NUM_OPS: usize = 40;
+/// Op code = 8 * hi + lo, hi < OP_HI (UAIR one-hot selector halves).
+pub const OP_LO: usize = 8;
+pub const OP_HI: usize = 5;
+
+impl Op {
+    pub fn all() -> [Op; NUM_OPS] {
+        use Op::*;
+        [
+            Nop, Mul, Add, Sub, Const, ConstX, Load, Unit1, Anchor, UnitW, Smp1, Smp12, Unit12,
+            Horn, Job, Bit, Zero, Dig, NodeJob, Acc, DblAdd, MulAddA, Pv, UnitWS4, UnitWS2, PowChk, Rsv26, Rsv27, LoadBit, LoadF, UnitWT, PvD, SibWS4, SibWS2, DigWS4, DigWS2, HornS, HornR, HornE, Horn2,
+        ]
+    }
+    pub fn reads_a(self) -> bool {
+        use Op::*;
+        matches!(
+            self,
+            Mul | Add | Sub | Unit1 | UnitW | Unit12 | Horn | Bit | Zero | DblAdd
+                | MulAddA | Pv | UnitWS4 | UnitWS2 | UnitWT | PvD | HornS | HornR | Horn2
+        )
+    }
+    pub fn reads_b(self) -> bool {
+        use Op::*;
+        matches!(self, Mul | Add | Sub | Horn | DblAdd | MulAddA | UnitWS4 | UnitWS2 | SibWS4 | SibWS2 | DigWS4 | DigWS2 | HornR | Horn2)
+    }
+}
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq, Hash)]
+pub struct Instr {
+    pub op: Op,
+    pub a: u32,
+    pub b: u32,
+    pub k1: u32,
+    pub k2: u32,
+}
+
+impl Instr {
+    pub const NOP: Instr = Instr {
+        op: Op::Nop,
+        a: 0,
+        b: 0,
+        k1: 0,
+        k2: 0,
+    };
+    pub fn words(&self) -> [u32; 4] {
+        assert!(self.b < (1 << ADDR_BITS), "B field overflow");
+        [self.a, self.b + ((self.op as u32) << ADDR_BITS), self.k1, self.k2]
+    }
+}
