+    let prove_levels = env_usize("E2E_PROVE_LEVELS", usize::MAX);
+    let check = env_usize("E2E_DEBUG", 0) == 1;
+    let child_params = params_from_env("CHILD", [8, 3, 100, 0]);
+    let parent_params = params_from_env("PARENT", [20, 3, 268, 64]);
+    describe("CHILD", &child_params);
+    describe("PARENT", &parent_params);
+    let child_engine = Sha384CpuEngine::new(child_params);
+    let t = std::time::Instant::now();
+    let (mut vk, mut proof) = match child_spec.split_once(':') {
+        Some(("fib", log)) => FibFixture::new(0, 1, 1 << log.parse::<usize>().unwrap())
+            .keygen_and_prove(&child_engine),
+        _ => InteractionsFixture11.keygen_and_prove(&child_engine),
+    };
+    child_engine.verify(&vk, &proof).unwrap();
+    soundness("L0", &vk);
+    println!("L0_PROVE_S {:.2}", t.elapsed().as_secs_f64());
+    println!("L0_PROOF_BYTES {}", proof_sizes(&proof));
+    let parent = Sha384CpuEngine::new(parent_params);
+    for level in 1..=levels {
+        let tag = format!("L{level}");
+        let t = std::time::Instant::now();
+        let config = crate::system::VerifierConfig {
+            sha_instances: env_usize("E2E_SHA_INSTANCES", 1),
+            ..Default::default()
+        };
+        let circuit = VerifierSubCircuit::<1>::new_with_options(Arc::new(vk.clone()), config);
+        let airs = circuit.airs::<Sha384Config>();
+        let (pk, pvk) = parent.keygen(&airs);
+        let commit = circuit.commit_child_vk(&parent, &vk);
+        let ctxs = circuit.generate_proving_ctxs_base(
+            &vk,
+            CachedTraceCtx::PcsData(commit),
+            std::slice::from_ref(&proof),
+            &(),
+            ShaTranscriptRecorder::default(),
+        );
+        println!("{tag}_TRACEGEN_S {:.2}", t.elapsed().as_secs_f64());
+        let cells = report(&tag, &airs, &ctxs);
+        let (nodes, blocks, tjobs) = sha_counts(&airs, &ctxs);
+        println!(
+            "{tag}_SHA_COMPRESSIONS total={} merkle_nodes={} job_blocks={} transcript_jobs={}",
+            nodes + blocks,
+            nodes,
+            blocks,
+            tjobs
+        );
+        let _ = cells;
+        {
+            let (mut cols, mut opened) = (0usize, 0usize);
+            for a in &pvk.inner.per_air {
+                let w = &a.params.width;
+                let total = w.common_main + w.cached_mains.iter().sum::<usize>() + w.preprocessed.unwrap_or(0);
+                cols += total;
+                opened += total * (1 + a.params.need_rot as usize);
+            }
+            println!(
+                "{tag}_COLUMNS airs={} columns={} opened_columns={} opened_bytes~{}",
+                pvk.inner.per_air.len(),
+                cols,
+                opened,
+                opened * 48
+            );
+        }
+        {
+            // Per-AIR columns, next-row use, interactions; SHA vs other cells.
+            let (mut total_int, mut sha_cells, mut other_cells) = (0usize, 0usize, 0usize);
+            println!("{tag}_AIRTAB idx name height width need_rot interactions_per_row rows_x_interactions cells");
+            for (i, (air, ctx)) in airs.iter().zip(ctxs.iter()).enumerate() {
+                let a = &pvk.inner.per_air[i];
+                let w = &a.params.width;
+                let width = w.common_main + w.cached_mains.iter().sum::<usize>() + w.preprocessed.unwrap_or(0);
+                let h = ctx.common_main.height();
+                let ni = a.symbolic_constraints.interactions.len();
+                let dag_nodes = a.symbolic_constraints.constraints.nodes.len();
+                let n_constraints = a.symbolic_constraints.constraints.constraint_idx.len();
+                let n_msg: usize = a.symbolic_constraints.interactions.iter().map(|i| i.message.len()).sum();
+                println!("{tag}_DAG {} nodes={dag_nodes} constraints={n_constraints} interactions={ni} msg_fields={n_msg}", air.name().replace(' ', ""));
+                total_int += h * ni;
+                let cells = h * width;
+                let name = air.name();
+                if name.starts_with("Sha512Air") || name.starts_with("TableAir") {
+                    sha_cells += cells;
+                } else {
+                    other_cells += cells;
+                }
+                println!(
+                    "{tag}_AIRTAB {i} {} {h} {width} {} {ni} {} {cells}",
+                    name.replace(' ', ""),
+                    a.params.need_rot as usize,
+                    h * ni
+                );
+            }
+            let l = (usize::BITS - (total_int - 1).leading_zeros()) as usize;
+            println!(
+                "{tag}_INTERACTIONS total={total_int} L={l} gkr_model_bytes={}",
+                72 * l * l + 264 * l + 248
+            );
+            println!("{tag}_CELLS_SPLIT sha_compress={sha_cells} other={other_cells}");
+        }
+        let ctx = ProvingContext::new(ctxs.into_iter().enumerate().collect());
+        if check {
+            parent.debug(&airs, &ctx);
+            println!("{tag}_DEBUG_OK");
+        }
+        if !prove || level > prove_levels {
+            return;
+        }
+        soundness(&tag, &pvk);
+        let d_pk = parent.device().transport_pk_to_device(&pk);
+        let t = std::time::Instant::now();
+        let p = parent.prove(&d_pk, ctx).unwrap();
+        println!("{tag}_PROVE_S {:.2}", t.elapsed().as_secs_f64());
+        let t = std::time::Instant::now();
+        parent.verify(&pvk, &p).unwrap();
+        println!("{tag}_VERIFY_S {:.3}", t.elapsed().as_secs_f64());
+        println!("{tag}_PROOF_BYTES {}", proof_sizes(&p));
+        vk = pvk;
+        proof = p;
+    }
+}
