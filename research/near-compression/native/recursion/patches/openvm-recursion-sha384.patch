+    // public value: the Pv row asserts a0 == level
+    {
+        let (airs, mats, mut pvs) = honest(&vk, &proof, 16);
+        pvs[0][0] += F::ONE;
+        must_fail("alu public value (level)", || debug_check(&airs, mats, &pvs));
+    }
+}
