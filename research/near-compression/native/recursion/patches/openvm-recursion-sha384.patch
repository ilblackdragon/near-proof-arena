+// feed-forward carries at C1A+3q.
+pub const OUT_IV: usize = RV0;
+pub const OUT_FIN: usize = SA;
+pub const OUT_C: usize = C1A;
+
+/// Range table [0, 64) bounds every carry.
+pub const RANGE: usize = 64;
