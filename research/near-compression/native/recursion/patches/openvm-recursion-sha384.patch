index 0000000..0d32a4b
--- /dev/null
+++ b/crates/recursion/src/transcript/sha_transcript.rs
@@ -0,0 +1,799 @@
+//! In-circuit SHA-384 Fiat–Shamir transcript (`ShaTranscript` in `sha384/config.rs`).
+//!
+//! The native transcript is a chain of SHA-384 jobs on a 48-byte state:
+//! * flush   `H(P‖3‖le8(48)‖state‖le8(4n)‖pending)` before a sample/commit after observes,
+//! * commit  `H(P‖4‖le8(48)‖state‖le8(48)‖digest)`,
+//! * squeeze `H(P‖5‖le8(48)‖state)` when a sample finds no unused state word,
+//! and a sample reads the next little-endian 32-bit state word n, rejecting n ≥ 2p.
+//!
+//! * `TranscriptHashAir`: one row per job, in transcript order per proof.  Chains the
+//!   state, sends the job's framing units to the SHA packer, receives the new state,
+//!   emits commit limbs on the transcript bus, and enforces the job grammar:
+//!   a flush is followed by a commit or squeeze; a squeeze follows a squeeze only after
+//!   all 12 words were read; a rejected last word forces another squeeze.
+//!   `t_start` chains the transcript index: next.t_start = t_start + cnt.
+//! * `TranscriptObsAir`: one row per observed element, grouped in flush runs.
+//! * `TranscriptSampleAir`: one row per state word read by a squeeze run, with the
+//!   exact acceptance test n < 2p (byte decomposition + is-zero gadgets).
+use core::borrow::{Borrow, BorrowMut};
+
+use openvm_recursion_circuit_derive::AlignedBorrow;
+use openvm_stark_backend::{
+    interaction::{BusIndex, InteractionBuilder, PermutationCheckBus},
+    BaseAirWithPublicValues, PartitionedBaseAir,
+};
+use p3_air::{Air, AirBuilder, BaseAir};
+use p3_field::{Field, PrimeCharacteristicRing, PrimeField32};
+use p3_matrix::{dense::RowMajorMatrix, Matrix};
+
+use crate::{
+    bus::{TranscriptBus, TranscriptBusMessage},
+    sha384::{
+        airs::ShaBusInventory,
+        config::{
+            digest_bytes, hash_parts, initial_state, limbs_to_digest, word_limbs, ShaTranscriptLog,
+            DIGEST_SIZE, F, KIND_COMMIT, KIND_OBSERVE, KIND_SAMPLE, SAMPLE_BOUND, TAG_COMMIT,
+            TAG_FLUSH, TAG_SQUEEZE,
+        },
+        jobs::{len_units, word_units, ShaJob, Unit},
+    },
+};
+
+/// Internal buses of the transcript AIRs.
+#[derive(Clone, Copy, Debug)]
+pub struct TranscriptInternalBuses {
+    /// (proof, job, t_first, n): obs run -> hash row
+    pub obs: BusIndex,
+    /// (proof, job, t_job, m, last_wi, last_acc): sample run -> hash row
+    pub sample: BusIndex,
+    /// (job, wi, hi, lo): squeeze state words -> sample rows
+    pub word: BusIndex,
+}
+
+/// Emit one transcript event (sender side).
+#[allow(clippy::too_many_arguments)]
+fn emit_tr<AB: InteractionBuilder>(
+    tb: &TranscriptBus,
+    slot: Option<BusIndex>,
+    builder: &mut AB,
+    proof_idx: AB::Var,
+    tidx: AB::Expr,
+    value: AB::Expr,
+    kind: AB::Expr,
+    mult: AB::Expr,
+) {
+    match slot {
+        None => tb.send(
+            builder,
+            proof_idx,
+            TranscriptBusMessage {
+                tidx,
+                value,
+                is_sample: kind,
+            },
+            mult,
+        ),
+        Some(bus) => PermutationCheckBus::new(bus).send(
+            builder,
+            [AB::Expr::ZERO, tidx, AB::Expr::ZERO, kind, value, AB::Expr::ZERO],
+            mult,
+        ),
+    }
+}
+
+fn state_words(state: &[u8; 48]) -> [u64; 6] {
+    std::array::from_fn(|i| u64::from_be_bytes(state[8 * i..8 * i + 8].try_into().unwrap()))
+}
+fn state_limbs(state: &[u8; 48]) -> [u32; 24] {
+    let w = state_words(state);
+    std::array::from_fn(|i| word_limbs(w[i / 4])[i % 4])
+}
+
+// ---------------------------------------------------------------------------------------
+// Replay
+// ---------------------------------------------------------------------------------------
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum TrOp {
+    Flush,
+    Commit,
+    Squeeze,
+}
+
+#[derive(Clone, Debug)]
+pub struct SampleRead {
+    pub wi: usize,
+    pub n: u32,
+    pub acc: bool,
+}
+
+#[derive(Clone, Debug)]
+pub struct TrJob {
+    pub op: TrOp,
+    pub t_start: usize,
+    pub cnt: usize,
+    pub state_in: [u8; 48],
+    pub state_out: [u8; 48],
+    /// commit digest limbs (Commit)
+    pub payload: [F; DIGEST_SIZE],
+    /// observed values (Flush)
+    pub obs: Vec<F>,
+    /// words read (Squeeze)
+    pub reads: Vec<SampleRead>,
+}
+
+impl TrJob {
+    pub fn sha_job(&self) -> ShaJob {
+        let mut units: Vec<Unit> = len_units(48).to_vec();
+        units.extend(word_units(&state_words(&self.state_in)));
+        let tag = match self.op {
+            TrOp::Flush => {
+                units.extend(len_units(4 * self.obs.len()));
+                units.extend(self.obs.iter().map(|x| Unit::Felt(x.as_canonical_u32())));
+                TAG_FLUSH
+            }
+            TrOp::Commit => {
+                units.extend(len_units(48));
+                let d = limbs_to_digest(&self.payload);
+                units.extend(word_units(&crate::sha384::config::digest_words(d)));
+                TAG_COMMIT
+            }
+            TrOp::Squeeze => TAG_SQUEEZE,
+        };
+        ShaJob { tag, units }
+    }
+}
+
+/// Replays a recorded transcript log through the native SHA transcript, returning the
+/// hash jobs in order.  Panics if a recorded sample disagrees with the replay.
+pub fn replay_transcript(log: &ShaTranscriptLog) -> Vec<TrJob> {
+    let mut jobs: Vec<TrJob> = Vec::new();
+    let mut state = initial_state();
+    let mut next_word = 12usize;
+    let mut pending: Vec<F> = Vec::new();
+    let mut pending_start = 0usize;
+    let flush = |jobs: &mut Vec<TrJob>,
+                 state: &mut [u8; 48],
+                 next_word: &mut usize,
+                 pending: &mut Vec<F>,
+                 pending_start: usize| {
+        if !pending.is_empty() {
+            let bytes = crate::sha384::config::felt_bytes(pending);
+            let out = hash_parts(TAG_FLUSH, &[&state[..], &bytes]);
+            jobs.push(TrJob {
+                op: TrOp::Flush,
+                t_start: pending_start,
+                cnt: pending.len(),
+                state_in: *state,
+                state_out: out,
+                payload: [F::ZERO; DIGEST_SIZE],
+                obs: std::mem::take(pending),
+                reads: vec![],
+            });
+            *state = out;
+            *next_word = 12;
+        }
+    };
+    let mut i = 0;
+    let n = log.len();
+    while i < n {
+        match log.kinds[i] {
+            KIND_OBSERVE => {
+                if pending.is_empty() {
+                    pending_start = i;
+                }
+                pending.push(log.values[i]);
+                next_word = 12;
+                i += 1;
+            }
+            KIND_COMMIT => {
+                assert!(i + DIGEST_SIZE <= n);
+                assert!(log.kinds[i..i + DIGEST_SIZE].iter().all(|&k| k == KIND_COMMIT));
+                flush(&mut jobs, &mut state, &mut next_word, &mut pending, pending_start);
+                let payload: [F; DIGEST_SIZE] = log.values[i..i + DIGEST_SIZE].try_into().unwrap();
+                let d = limbs_to_digest(&payload);
+                let out = hash_parts(TAG_COMMIT, &[&state[..], &digest_bytes(d)]);
+                jobs.push(TrJob {
+                    op: TrOp::Commit,
+                    t_start: i,
+                    cnt: DIGEST_SIZE,
+                    state_in: state,
+                    state_out: out,
+                    payload,
+                    obs: vec![],
+                    reads: vec![],
+                });
+                state = out;
+                next_word = 12;
+                i += DIGEST_SIZE;
+            }
+            KIND_SAMPLE => {
+                flush(&mut jobs, &mut state, &mut next_word, &mut pending, pending_start);
+                loop {
+                    if next_word == 12 {
+                        let out = hash_parts(TAG_SQUEEZE, &[&state[..]]);
+                        jobs.push(TrJob {
+                            op: TrOp::Squeeze,
+                            t_start: i,
+                            cnt: 0,
+                            state_in: state,
+                            state_out: out,
+                            payload: [F::ZERO; DIGEST_SIZE],
+                            obs: vec![],
+                            reads: vec![],
+                        });
+                        state = out;
+                        next_word = 0;
+                    }
+                    let start = 4 * next_word;
+                    let w = u32::from_le_bytes(state[start..start + 4].try_into().unwrap());
+                    let acc = (w as u64) < SAMPLE_BOUND;
+                    let job = jobs.last_mut().unwrap();
+                    debug_assert_eq!(job.op, TrOp::Squeeze);
+                    job.reads.push(SampleRead {
+                        wi: next_word,
+                        n: w,
+                        acc,
+                    });
+                    next_word += 1;
+                    if acc {
+                        job.cnt += 1;
+                        assert_eq!(
+                            F::from_u32(w),
+                            log.values[i],
+                            "transcript replay disagrees with recorded sample at tidx {i}"
+                        );
+                        break;
+                    }
+                }
+                i += 1;
+            }
+            k => panic!("bad transcript kind {k}"),
+        }
+    }
+    assert!(pending.is_empty(), "transcript ends with unflushed observations");
+    jobs
+}
+
+// ---------------------------------------------------------------------------------------
+// Hash-chain AIR
+// ---------------------------------------------------------------------------------------
+
+#[repr(C)]
+#[derive(AlignedBorrow, Debug)]
+pub struct TranscriptHashCols<T> {
+    pub valid: T,
+    pub proof_idx: T,
+    pub is_first: T,
+    pub op_f: T,
+    pub op_c: T,
+    pub op_s: T,
+    pub job: T,
+    pub t_start: T,
+    pub cnt: T,
+    pub state_in: [T; DIGEST_SIZE],
+    pub state_out: [T; DIGEST_SIZE],
+    pub payload: [T; DIGEST_SIZE],
+    pub rd: [T; 12],
+    pub last_wi: T,
+    pub last_acc: T,
+}
+pub const HASH_WIDTH: usize = TranscriptHashCols::<u8>::width();
+
+pub struct TranscriptHashAir {
+    pub transcript_bus: TranscriptBus,
+    /// NV: emit transcript events on this slot bus as (0, tidx, 0, kind, value, 0).
+    pub slot_bus: Option<BusIndex>,
+    pub sha: ShaBusInventory,
+    pub internal: TranscriptInternalBuses,
+}
+impl<F> BaseAir<F> for TranscriptHashAir {
+    fn width(&self) -> usize {
+        HASH_WIDTH
+    }
+}
+impl<F> BaseAirWithPublicValues<F> for TranscriptHashAir {}
+impl<F> PartitionedBaseAir<F> for TranscriptHashAir {}
+
+impl<AB: AirBuilder + InteractionBuilder> Air<AB> for TranscriptHashAir {
+    fn eval(&self, builder: &mut AB) {
+        let main = builder.main();
+        let (local, next) = (main.row_slice(0).unwrap(), main.row_slice(1).unwrap());
+        let l: &TranscriptHashCols<AB::Var> = (*local).borrow();
+        let n: &TranscriptHashCols<AB::Var> = (*next).borrow();
+        let one = AB::Expr::ONE;
+        let c = |v: u64| AB::Expr::from_u64(v);
+
+        for x in [l.valid, l.is_first, l.op_f, l.op_c, l.op_s, l.last_acc] {
+            builder.assert_bool(x);
+        }
+        builder.assert_eq(l.op_f + l.op_c + l.op_s, l.valid);
+        builder.when(l.is_first).assert_one(l.valid);
+        builder.when_first_row().assert_eq(l.is_first, l.valid);
+        builder.when_first_row().assert_zero(l.proof_idx);
+        let s0 = state_limbs(&initial_state());
+        for i in 0..DIGEST_SIZE {
+            builder
+                .when(l.is_first)
+                .assert_eq(l.state_in[i], c(s0[i] as u64));
+        }
+        builder.when(l.is_first).assert_zero(l.t_start);
+        builder.when(l.op_c).assert_eq(l.cnt, c(DIGEST_SIZE as u64));
+
+        // Squeeze words read: a prefix of length last_wi + 1 (only on squeeze rows).
+        for i in 0..12 {
+            builder.assert_bool(l.rd[i]);
+        }
+        builder.assert_eq(l.rd[0], l.op_s);
+        for i in 0..11 {
+            builder.assert_zero(l.rd[i + 1] * (one.clone() - l.rd[i]));
+        }
+        let rd_sum = l.rd.iter().fold(AB::Expr::ZERO, |a, &x| a + x);
+        builder.assert_eq(rd_sum, l.last_wi + l.op_s);
+        builder.assert_zero(l.last_acc * (one.clone() - l.op_s));
+        let not_full = l.op_s - l.rd[11];
+        let rej = l.op_s - l.last_acc;
+        builder.assert_zero(rej.clone() * (one.clone() - l.rd[11]));
+
+        // Chain and grammar.
+        {
+            let mut t = builder.when_transition();
+            t.assert_zero((one.clone() - l.valid) * n.valid);
+            t.when(n.valid).assert_eq(n.proof_idx, l.proof_idx + n.is_first);
+            let same = n.valid - n.is_first;
+            for i in 0..DIGEST_SIZE {
+                t.when(same.clone()).assert_eq(n.state_in[i], l.state_out[i]);
+            }
+            t.when(same.clone()).assert_eq(n.t_start, l.t_start + l.cnt);
+            t.assert_zero(same.clone() * l.op_f * n.op_f);
+            t.assert_zero(l.op_f * (one.clone() - same.clone()));
+            t.assert_zero(same.clone() * n.op_s * not_full);
+            t.assert_zero(rej.clone() * (one.clone() - same * n.op_s));
+        }
+        builder.when_last_row().assert_zero(l.op_f);
+        builder.when_last_row().assert_zero(rej);
+
+        // SHA job.
+        let sha = self.sha;
+        let tag = l.op_f * c(TAG_FLUSH as u64) + l.op_c * c(TAG_COMMIT as u64) + l.op_s * c(TAG_SQUEEZE as u64);
+        sha.send_job(builder, l.job, tag, l.valid);
+        sha.send_unit(builder, l.job, c(0), 0, c(48), c(0), l.valid);
+        sha.send_unit(builder, l.job, c(1), 0, c(0), c(0), l.valid);
+        let sin: Vec<AB::Expr> = l.state_in.iter().map(|&x| x.into()).collect();
+        sha.send_digest_units(builder, l.job, 2, &sin, l.valid);
+        sha.send_unit(
+            builder,
+            l.job,
+            c(14),
+            0,
+            l.op_c * c(48) + l.op_f * l.cnt * c(4),
+            c(0),
+            l.op_c + l.op_f,
+        );
+        sha.send_unit(builder, l.job, c(15), 0, c(0), c(0), l.op_c + l.op_f);
+        let pay: Vec<AB::Expr> = l.payload.iter().map(|&x| x.into()).collect();
+        sha.send_digest_units(builder, l.job, 16, &pay, l.op_c);
+        let sout: Vec<AB::Expr> = l.state_out.iter().map(|&x| x.into()).collect();
+        sha.receive_digest(builder, l.job, &sout, l.valid);
+
+        // Commit limbs on the transcript bus.
+        for i in 0..DIGEST_SIZE {
+            emit_tr(
+                &self.transcript_bus,
+                self.slot_bus,
+                builder,
+                l.proof_idx,
+                l.t_start + c(i as u64),
+                l.payload[i].into(),
+                c(KIND_COMMIT as u64),
+                l.op_c.into(),
+            );
+        }
+        // Run summaries.
+        PermutationCheckBus::new(self.internal.obs).receive(
+            builder,
+            [l.proof_idx, l.job, l.t_start, l.cnt],
+            l.op_f,
+        );
+        PermutationCheckBus::new(self.internal.sample).receive(
+            builder,
+            [l.proof_idx, l.job, l.t_start, l.cnt, l.last_wi, l.last_acc],
+            l.op_s,
+        );
+        // State words for the sample rows.
+        let wbus = PermutationCheckBus::new(self.internal.word);
+        for wi in 0..12 {
+            let (hi, lo) = if wi % 2 == 0 {
+                (l.state_out[2 * wi + 3], l.state_out[2 * wi + 2])
+            } else {
+                (l.state_out[2 * wi - 1], l.state_out[2 * wi - 2])
+            };
+            wbus.send(
+                builder,
+                [l.job.into(), c(wi as u64), hi.into(), lo.into()],
+                l.rd[wi],
+            );
+        }
+    }
+}
+
+// ---------------------------------------------------------------------------------------
+// Observe AIR
+// ---------------------------------------------------------------------------------------
+
+#[repr(C)]
+#[derive(AlignedBorrow, Debug)]
+pub struct TranscriptObsCols<T> {
+    pub valid: T,
+    pub proof_idx: T,
+    pub job: T,
+    pub tidx: T,
+    pub t_first: T,
+    pub value: T,
+    pub is_first: T,
+    pub is_last: T,
+}
+pub const OBS_WIDTH: usize = TranscriptObsCols::<u8>::width();
+
+pub struct TranscriptObsAir {
+    pub transcript_bus: TranscriptBus,
+    /// NV: emit transcript events on this slot bus as (0, tidx, 0, kind, value, 0).
+    pub slot_bus: Option<BusIndex>,
+    pub sha: ShaBusInventory,
+    pub internal: TranscriptInternalBuses,
+}
+impl<F> BaseAir<F> for TranscriptObsAir {
+    fn width(&self) -> usize {
+        OBS_WIDTH
+    }
+}
+impl<F> BaseAirWithPublicValues<F> for TranscriptObsAir {}
+impl<F> PartitionedBaseAir<F> for TranscriptObsAir {}
+
+/// Run sequencing shared by the observe and sample AIRs: valid rows first, runs back to back.
+fn run_sequencing<AB: AirBuilder>(
+    builder: &mut AB,
+    valid: AB::Expr,
+    is_first: AB::Expr,
+    is_last: AB::Expr,
+    n_valid: AB::Expr,
+    n_is_first: AB::Expr,
+) {
+    let one = AB::Expr::ONE;
+    builder.assert_bool(valid.clone());
+    builder.assert_bool(is_first.clone());
+    builder.assert_bool(is_last.clone());
+    builder.when(is_first.clone()).assert_one(valid.clone());
+    builder.when(is_last.clone()).assert_one(valid.clone());
+    builder.when_first_row().assert_eq(is_first, valid.clone());
+    let mut t = builder.when_transition();
+    t.assert_zero((one.clone() - valid.clone()) * n_valid.clone());
+    t.when(n_valid.clone()).assert_eq(n_is_first, is_last.clone());
+    t.when(valid.clone())
+        .assert_zero((one.clone() - n_valid) * (one.clone() - is_last.clone()));
+    builder
+        .when_last_row()
+        .assert_zero(valid * (one - is_last));
+}
+
+impl<AB: AirBuilder + InteractionBuilder> Air<AB> for TranscriptObsAir {
+    fn eval(&self, builder: &mut AB) {
+        let main = builder.main();
+        let (local, next) = (main.row_slice(0).unwrap(), main.row_slice(1).unwrap());
+        let l: &TranscriptObsCols<AB::Var> = (*local).borrow();
+        let n: &TranscriptObsCols<AB::Var> = (*next).borrow();
+        let c = |v: u64| AB::Expr::from_u64(v);
+        run_sequencing::<AB>(builder, l.valid.into(), l.is_first.into(), l.is_last.into(), n.valid.into(), n.is_first.into());
+        builder.when(l.is_first).assert_eq(l.t_first, l.tidx);
+        {
+            let mut t = builder.when_transition();
+            let mut s = t.when(n.valid - n.is_first);
+            s.assert_eq(n.job, l.job);
+            s.assert_eq(n.proof_idx, l.proof_idx);
+            s.assert_eq(n.tidx, l.tidx + AB::Expr::ONE);
+            s.assert_eq(n.t_first, l.t_first);
+        }
+        emit_tr(
+            &self.transcript_bus,
+            self.slot_bus,
+            builder,
+            l.proof_idx,
+            l.tidx.into(),
+            l.value.into(),
+            c(KIND_OBSERVE as u64),
+            l.valid.into(),
+        );
+        self.sha.send_unit(
+            builder,
+            l.job,
+            c(16) + l.tidx - l.t_first,
+            0,
+            l.value,
+            c(0),
+            l.valid,
+        );
+        PermutationCheckBus::new(self.internal.obs).send(
+            builder,
+            [
+                l.proof_idx.into(),
+                l.job.into(),
+                l.t_first.into(),
+                l.tidx - l.t_first + AB::Expr::ONE,
+            ],
+            l.is_last,
+        );
+    }
+}
