+pub fn params_from_env(prefix: &str, d: [usize; 4]) -> SystemParams {
+    use openvm_stark_backend::{interaction::LogUpSecurityParameters, WhirProximityStrategy};
+    let e = |n: &str, dflt: usize| env_usize(&format!("{prefix}_{n}"), dflt);
+    let l_skip = e("L_SKIP", 2);
+    let n_stack = e("N_STACK", d[0]);
+    let k = e("K", 3);
+    let log_blowup = e("LOG_BLOWUP", d[1]);
+    let bits = e("BITS", d[2]);
+    let list_m = e("LIST_M", d[3]);
+    let proximity = if list_m > 0 {
+        WhirProximityStrategy::ListDecoding { m: list_m }
+    } else {
+        WhirProximityStrategy::UniqueDecoding
+    };
+    let logup = LogUpSecurityParameters {
+        // Production default: 2^30.  The D1-class base has N = 2^29.59 (D0a 2^29.55), so the
+        // old 2^28 default could not carry it.  Costs 2 LogUp bits (`logup_soundness`:
+        // 312.88 -> 310.88 at log_max_message_length = 7) and moves no WHIR query count.
+        // `*_INTERACTION_LOG=28` reproduces the pre-change (G2 gate) keys and proofs.
+        max_interaction_count: 1 << e("INTERACTION_LOG", 30),
+        log_max_message_length: 7,
+        pow_bits: e("LOGUP_POW", 0),
+    };
+    let log_final = e("LOG_FINAL", (l_skip + n_stack) % k);
+    let mut p = SystemParams::new(
+        log_blowup,
+        l_skip,
+        n_stack,
+        e("W_STACK", 1 << 12),
+        log_final,
+        e("FOLD_POW", 0),
+        e("MU_POW", 0),
+        proximity,
+        bits,
+        logup,
+        4,
+        e("QUERY_POW", 0),
+        k,
+    );
+    let mut p = env_levers(prefix, p, bits);
+    // O-2 (user decision U-13): per-round first-order agreement table, bound into the vk; the
+    // PQ default (with m = 64).  `{prefix}_O2=0` keeps the plain list-decoding query counts.
+    if list_m > 0 && e("O2", 1) == 1 {
+        // certificate-gated: a round uses its first-order threshold only if its codes are in the
+        // DKT certificate set (env `{prefix}_DKT_CERTS` or `NEARPROOF_DKT_CERTS`, a dkt_certs.json
+        // path); every other round falls back to Johnson m = 64 (O-1)
+        let path = std::env::var(format!("{prefix}_DKT_CERTS")).or_else(|_| std::env::var("NEARPROOF_DKT_CERTS")).ok();
+        // entries without a kernel proof (e.g. lean/DKTCertsO2_big.keys) are excluded
+        let excl = std::env::var(format!("{prefix}_DKT_EXCLUDE")).or_else(|_| std::env::var("NEARPROOF_DKT_EXCLUDE")).ok();
+        let certs = path.map(|p| load_dkt_certs_excluding(&p, excl.as_deref()));
+        p.whir = p.whir.clone().with_first_order(log_blowup, l_skip + n_stack, bits, e("O2_MARGIN_MILLI", 50) as u32, list_m as u32, certs.as_ref(), e("COMMITS", if prefix == "PARENT" { 2 } else { 1 }));
+    }
+    p
+}
+
+/// Rebuild the WHIR schedule of `p` with research levers / an odd-factor domain.
+pub fn with_levers(mut p: SystemParams, levers: openvm_stark_backend::WhirLevers, x15: usize, bits: usize) -> SystemParams {
+    let w = &p.whir;
+    let h = p.l_skip + p.n_stack;
+    let lf = if levers.k_first != 0 {
+        // (h - k1 - log_final) must be a multiple of k
+        let lf0 = p.log_final_poly_len();
+        lf0 + (h - levers.k_first - lf0) % w.k
+    } else {
+        p.log_final_poly_len()
+    };
+    let wp = openvm_stark_backend::WhirParams {
+        k: w.k,
+        log_final_poly_len: lf,
+        proximity: w.proximity,
+        query_phase_pow_bits: w.query_phase_pow_bits,
+        folding_pow_bits: w.folding_pow_bits,
+        mu_pow_bits: w.mu_pow_bits,
+    };
+    p.whir = openvm_stark_backend::WhirConfig::new_full(p.log_blowup, p.l_skip + p.n_stack, wp, bits, levers, x15);
+    p
+}
+
+pub fn describe(tag: &str, p: &SystemParams) {
+    println!(
+        "{tag}_PARAMS l_skip={} n_stack={} k={} log_blowup={} queries={:?} pow(mu,fold,query,logup)=({},{},{},{})",
+        p.l_skip,
+        p.n_stack,
+        p.k_whir(),
+        p.log_blowup,
+        p.whir.rounds.iter().map(|r| r.num_queries).collect::<Vec<_>>(),
+        p.whir.mu_pow_bits,
+        p.whir.folding_pow_bits,
+        p.whir.query_phase_pow_bits,
+        p.logup.pow_bits
+    );
+    if let Some(t) = &p.whir.agreement {
+        println!(
+            "{tag}_O2 target={} margin_milli={} m={} rounds(n,k,A,q,first_order)={:?}",
+            t.target_bits,
+            t.margin_milli,
+            t.m,
+            t.rounds.iter().map(|r| (r.n, r.kdim, r.agree, r.queries, r.first_order)).collect::<Vec<_>>()
+        );
+    }
+}
+
+pub fn soundness(tag: &str, vk: &MultiStarkVerifyingKey<Sha384Config>) {
+    let b = openvm_stark_backend::soundness::SoundnessCalculator::calculate_from_vk(vk);
+    println!(
+        "{tag}_SOUNDNESS total={:.1} logup={:.1} proximity={:.1} query={:.1}",
+        b.total_bits, b.logup_bits, b.whir_details.proximity_gaps_bits, b.whir_details.query_bits
+    );
+}
+
+pub fn proof_sizes(p: &Proof<Sha384Config>) -> String {
+    use openvm_stark_backend::codec::Encode;
+    fn size<T: Encode>(x: &T) -> usize {
+        let mut b = Vec::new();
+        x.encode(&mut b).unwrap();
+        b.len()
+    }
+    let lv = p.whir_proof.levers;
+    let (gkr, rel) = if lv.is_default() {
+        (size(&p.gkr_proof), size(&p.batch_constraint_proof))
+    } else {
+        let (mut g, mut r) = (Vec::new(), Vec::new());
+        p.gkr_proof.encode_levers(&lv, &mut g).unwrap();
+        p.batch_constraint_proof.encode_levers(&mut r).unwrap();
+        (g.len(), r.len())
+    };
+    format!(
+        "total={} gkr={} relations={} stacking={} whir={}",
+        size(p),
+        gkr,
+        rel,
+        size(&p.stacking_proof),
+        size(&p.whir_proof)
+    )
+}
+
+/// Number of SHA-512 compressions used (Merkle nodes + job blocks) from the traces.
+fn sha_counts(airs: &[AirRef<Sha384Config>], ctxs: &Ctxs) -> (usize, usize, usize) {
+    let find = |n: &str| airs.iter().position(|a| a.name() == n).unwrap();
+    let mv = &ctxs[find("MerkleVerifyAir")].common_main;
+    let w = mv.width;
+    // MerkleVerifyCols: proof_idx, query_idx, is_valid, is_last_merkle, ...
+    let nodes = (0..mv.height())
+        .filter(|&r| mv.values[r * w + 2] == F::ONE && mv.values[r * w + 3] == F::ZERO)
+        .count();
+    let bl = &ctxs[find("ShaBlockAir")].common_main;
+    let blocks = (0..bl.height())
+        .filter(|&r| bl.values[r * bl.width] == F::ONE)
+        .count();
+    let th = &ctxs[find("TranscriptHashAir")].common_main;
+    let tjobs = (0..th.height())
+        .filter(|&r| th.values[r * th.width] == F::ONE)
+        .count();
+    (nodes, blocks, tjobs)
+}
