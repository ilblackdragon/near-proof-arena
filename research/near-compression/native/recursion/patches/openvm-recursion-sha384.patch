+/// Apply research levers from env `{prefix}_K1`, `_MULTIPROOF`, `_KEEP_DOMAIN`, `_GRUEN_GKR`,
+/// `_GKR_DERIVE`, `_NEXT_MASK`, `_GRUEN_ZC`, `_WIDE_POW`, `_TIGHT`, `_WHIR_Y`, `_X15`.
+pub fn env_levers(prefix: &str, p: SystemParams, bits: usize) -> SystemParams {
+    let e = |n: &str, dflt: usize| env_usize(&format!("{prefix}_{n}"), dflt);
+    let levers = openvm_stark_backend::WhirLevers {
+        k_first: e("K1", 0),
+        multiproof: e("MULTIPROOF", 0) == 1,
+        keep_domain: e("KEEP_DOMAIN", 0) == 1,
+        gruen_gkr: e("GRUEN_GKR", 0) == 1,
+        gkr_derive_claims: e("GKR_DERIVE", 0) == 1,
+        next_mask: e("NEXT_MASK", 0) == 1,
+        gruen_zerocheck: e("GRUEN_ZC", 0) == 1,
+        wide_query_pow: e("WIDE_POW", 0) == 1,
+        tight_heights: e("TIGHT", 0) == 1,
+        whir_y: e("WHIR_Y", 0) == 1,
+    };
+    let x15 = e("X15", 1);
+    if levers.is_default() && x15 == 1 {
+        return p;
+    }
+    with_levers(p, levers, x15, bits)
+}
+pub fn parent_params_debug() -> SystemParams {
