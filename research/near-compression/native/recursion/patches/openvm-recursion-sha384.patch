+        let r0 = (0..mats[0].height()).find(|&r| mats[0].values[r * w + x.cm.kb] == F::ONE).unwrap();
+        mats[0].values[(r0 + 7) * w + x.bc.bl] = F::ONE;
+        must_fail("bind premature last flag", || debug_check(&airs, mats, &pvs));
