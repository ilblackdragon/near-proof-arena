+/// [E2E-D D-5, review-D4 F1] Pinned `(log, tight)` heights of a level's traces from its shape
+/// alone: per AIR, the used rows minus the rows the actual rejections contributed, plus the
+/// rejection slack `delta_max(J_max(eps_bits))` (NvAir: AIR 0; SHA compression: AIR 1, at
+/// `compress4_air::ROWS` rows per compression). The table and byte AIRs have fixed heights.
+/// Also returns `(J_max, NvAir slack rows, SHA slack rows, NvAir base rows, SHA base rows)`.
+pub fn shape_pinned_heights(
+    mats: &[RowMajorMatrix<F>],
+    b: &Builder,
+    l_skip: usize,
+    eps_bits: f64,
+) -> (Vec<super::vd::PinnedHeight>, [usize; 5]) {
+    use p3_matrix::Matrix;
+    let hp = b.height_profile.as_ref().expect("height profile (NvCircuit::generate_*)");
+    let jm = HeightProfile::j_max(hp.k_samples, eps_bits);
+    let (nv_slack, comps_slack) = hp.delta_max(jm);
+    let sha_rows = crate::sha384::compress4_air::ROWS;
+    let used = |m: &RowMajorMatrix<F>| -> usize {
+        let w = m.width();
+        (0..m.height()).rev().find(|&r| m.values[r * w..(r + 1) * w].iter().any(|v| *v != F::ZERO)).map_or(0, |r| r + 1)
+    };
+    let mut out = vec![];
+    let mut base = [0usize; 2];
+    for (a, m) in mats.iter().enumerate() {
+        let (log, tight) = match a {
+            0 | 1 => {
+                let (delta_act, slack) = if a == 0 {
+                    (hp.nv_delta_actual, nv_slack)
+                } else {
+                    (hp.comps_delta_actual * sha_rows, comps_slack * sha_rows)
+                };
+                let u = used(m);
+                assert!(u >= delta_act, "AIR {a}: used rows below the rejection rows");
+                base[a] = u - delta_act;
+                let t = (base[a] + slack).max(1).next_multiple_of(1 << l_skip);
+                let log = (m.height().trailing_zeros() as usize).max(t.next_power_of_two().trailing_zeros() as usize);
+                (log, Some(t.min(1 << log)))
+            }
+            _ => (m.height().trailing_zeros() as usize, Some(used(m).max(1).next_multiple_of(1 << l_skip))),
+        };
+        out.push((log, tight));
+    }
+    (out, [jm, nv_slack, comps_slack * sha_rows, base[0], base[1]])
+}
