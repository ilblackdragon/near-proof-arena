+/// [E2E-D D-5, review-D4 F5] Fiat-Shamir job counter: every SHA-384 evaluation a `ShaTranscript`
+/// makes (flush, commit absorb, squeeze / PoW-run block, PoW block), process-wide. Counting only
+/// (no effect on any hash); read with [`fs_jobs`], reset with [`fs_jobs_reset`]. Used to count
+/// `R` (ZK-ARGUMENT 6.5) on a real verification instead of estimating it.
+pub static FS_JOBS: [std::sync::atomic::AtomicU64; 4] = [
+    std::sync::atomic::AtomicU64::new(0),
+    std::sync::atomic::AtomicU64::new(0),
+    std::sync::atomic::AtomicU64::new(0),
+    std::sync::atomic::AtomicU64::new(0),
+];
+fn fs_count(k: usize) {
+    FS_JOBS[k].fetch_add(1, std::sync::atomic::Ordering::Relaxed);
+}
+/// `[flush, commit, squeeze or PoW-run block, PoW block]` jobs since the last reset.
+pub fn fs_jobs() -> [u64; 4] {
+    core::array::from_fn(|k| FS_JOBS[k].load(std::sync::atomic::Ordering::Relaxed))
+}
+pub fn fs_jobs_reset() {
+    for c in &FS_JOBS {
+        c.store(0, std::sync::atomic::Ordering::Relaxed);
+    }
+}
