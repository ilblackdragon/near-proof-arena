+/// [E2E-D D-5, review-D4 F1] Which rows of an NV level's traces depend on the rejection sampling
+/// of the child's (verified) transcript, and a shape-only height bound.
+///
+/// The in-circuit transcript replays every squeeze / PoW-run block the child's transcript drew.
+/// `sample()` accepts a 32-bit word iff it is `< 2p` (`SAMPLE_BOUND`), so each draw rejects with
+/// probability `rho = 1 - 2p/2^32` (about 1/16), and the number of blocks (one SHA job each: a
+/// hash-chain row, its GLUE rows and its compression rows) and of sample-role rows depends on the
+/// child transcript, i.e. on the witness and the oracle. Everything else in the trace is fixed by
+/// the program (the program is pinned, so the Merkle and leaf jobs are too).
+///
+/// `of` counts, per sample run (consecutive draws with no absorb between them), the blocks and
+/// the sample rows actually used, and the same counts with every word accepted (the shape
+/// minimum). The shape-only part of a trace's used rows is `used - delta_actual`; the pinned
+/// height is that plus `delta_max(J_max)`, the most the rows can grow when the draws reject at
+/// most `J_max` words in total, with `Pr[J > J_max] <= 2^-eps_bits` (Chernoff). A trace above the
+/// pin is a prover abort, an event of probability `<= 2^-eps_bits` (a completeness error, and a
+/// statistical ZK term of the same size).
+#[derive(Clone, Debug, Default)]
+pub struct HeightProfile {
+    /// draws (samples) in the replayed transcript, a function of the program
+    pub k_samples: usize,
+    /// sample runs (fixed by the program)
+    pub n_runs: usize,
+    /// rejected words in this trace
+    pub j_actual: usize,
+    /// squeeze / PoW-run jobs: actual and shape minimum (all draws accepted)
+    pub jobs_actual: usize,
+    pub jobs_min: usize,
+    /// sample-role rows (`ceil(reads / 2)` per job): actual and shape minimum
+    pub samp_actual: usize,
+    pub samp_min: usize,
+    /// per extra block: NvAir rows (hash-chain row + GLUE rows) and SHA compressions, maximised
+    /// over the run types present
+    pub nv_rows_per_job: usize,
+    pub comps_per_job: usize,
+    /// NvAir rows and SHA compressions the actual extra blocks and reads contribute
+    pub nv_delta_actual: usize,
+    pub comps_delta_actual: usize,
+}
+
+fn job_costs(j: &super::transcript2::TrJob2) -> (usize, usize) {
+    let job = j.job();
+    let blocks = super::hash::sha384_blocks(&job.message());
+    let mut cnt = vec![0u32; super::hash::BYTE_TABLE];
+    let nc = blocks.0.len();
+    let g = super::glue::glue_rows(&[job], &[blocks], 0, &mut cnt).len();
+    (1 + g, nc)
+}
+
+impl HeightProfile {
+    pub fn of(log: &crate::sha384::config::ShaTranscriptLog, starts: &[usize], jobs: &[super::transcript2::TrJob2]) -> Self {
+        use super::transcript2::Op2;
+        use crate::sha384::config::{pow_skip_words, KIND_POW, KIND_POW_CONT, KIND_SAMPLE};
+        // shape minimum: walk the log kinds with every draw accepted.
+        // run state: (squeeze jobs, closed sample rows, next word, reads in the current job)
+        type Run = (usize, usize, usize, usize);
+        let mut runs_min: Vec<(usize, usize)> = vec![];
+        let close = |c: &mut Option<Run>, out: &mut Vec<(usize, usize)>| {
+            if let Some((j, s, _, r)) = c.take() {
+                out.push((j, s + r.div_ceil(2)));
+            }
+        };
+        let mut k_samples = 0usize;
+        let (mut i, n) = (0usize, log.kinds.len());
+        let mut cur: Option<Run> = None;
+        let mut pow_pending: Option<usize> = None;
+        while i < n {
+            if i > 0 && starts.contains(&i) {
+                close(&mut cur, &mut runs_min);
+                pow_pending = None;
+            }
+            match log.kinds[i] {
+                KIND_SAMPLE => {
+                    k_samples += 1;
+                    let c = cur.get_or_insert_with(|| match pow_pending.take() {
+                        Some(skip) => (0, 0, skip, 0),
+                        None => (0, 0, 12, 0),
+                    });
+                    if c.2 == 12 {
+                        c.1 += c.3.div_ceil(2);
+                        c.3 = 0;
+                        c.0 += 1;
+                        c.2 = 0;
+                    }
+                    c.2 += 1;
+                    c.3 += 1;
+                    i += 1;
+                }
+                KIND_POW => {
+                    close(&mut cur, &mut runs_min);
+                    pow_pending = Some(pow_skip_words(1));
+                    i += 1;
+                    while i < n && log.kinds[i] == KIND_POW_CONT {
+                        i += 1;
+                    }
+                }
+                _ => {
+                    close(&mut cur, &mut runs_min);
+                    pow_pending = None;
+                    i += 1;
+                }
+            }
+        }
+        close(&mut cur, &mut runs_min);
+        // actual: a run = the reads a PoW job carries itself, then the maximal sequence of
+        // squeeze / PoW-run jobs after it (or after an absorb)
+        let mut runs_act: Vec<(usize, usize, Option<usize>)> = vec![];
+        let mut j_actual = 0usize;
+        let mut open = false;
+        for (x, j) in jobs.iter().enumerate() {
+            let rows = j.reads.len().div_ceil(2);
+            j_actual += j.reads.iter().filter(|r| !r.acc).count();
+            match j.op {
+                Op2::Squeeze | Op2::PowQ => {
+                    if !open {
+                        runs_act.push((0, 0, None));
+                        open = true;
+                    }
+                    let r = runs_act.last_mut().unwrap();
+                    r.0 += 1;
+                    r.1 += rows;
+                    r.2.get_or_insert(x);
+                }
+                Op2::Pow => {
+                    open = rows > 0;
+                    if open {
+                        runs_act.push((0, rows, None));
+                    }
+                }
+                _ => open = false,
+            }
+        }
+        assert_eq!(runs_act.len(), runs_min.len(), "height profile: sample runs do not pair up");
+        let any_sq = jobs.iter().position(|j| matches!(j.op, Op2::Squeeze | Op2::PowQ));
+        let (mut nv_rows_per_job, mut comps_per_job) = any_sq.map_or((0, 0), |x| job_costs(&jobs[x]));
+        let (mut nv_delta_actual, mut comps_delta_actual) = (0usize, 0usize);
+        let (mut jobs_actual, mut jobs_min, mut samp_actual, mut samp_min) = (0, 0, 0, 0);
+        for (ra, rm) in runs_act.iter().zip(&runs_min) {
+            assert!(ra.0 >= rm.0 && ra.1 >= rm.1, "height profile: a run below its shape minimum");
+            jobs_actual += ra.0;
+            jobs_min += rm.0;
+            samp_actual += ra.1;
+            samp_min += rm.1;
+            let (g, c) = ra.2.map_or((0, 0), |x| job_costs(&jobs[x]));
+            nv_rows_per_job = nv_rows_per_job.max(g);
+            comps_per_job = comps_per_job.max(c);
+            nv_delta_actual += (ra.0 - rm.0) * g + (ra.1 - rm.1);
+            comps_delta_actual += (ra.0 - rm.0) * c;
+        }
+        HeightProfile {
+            k_samples,
+            n_runs: runs_min.len(),
+            j_actual,
+            jobs_actual,
+            jobs_min,
+            samp_actual,
+            samp_min,
+            nv_rows_per_job,
+            comps_per_job,
+            nv_delta_actual,
+            comps_delta_actual,
+        }
+    }
+
+    /// Smallest `J_max` with `Pr[J > J_max] <= 2^-eps_bits`, where `J` (rejected words before
+    /// `k` accepted draws) is negative binomial with reject probability `rho`:
+    /// `Pr[J >= t] = Pr[Bin(k + t - 1, rho) >= t] <= exp(-n KL(t/n || rho))`, `n = k + t - 1`.
+    pub fn j_max(k: usize, eps_bits: f64) -> usize {
+        if k == 0 {
+            return 0; // no draws (a program without a child transcript, e.g. a PAD leaf)
+        }
+        let p = crate::sha384::config::SAMPLE_BOUND as f64;
+        let rho = 1.0 - p / 4294967296.0;
+        let target = -eps_bits * std::f64::consts::LN_2;
+        let mut t = (k as f64 * rho / (1.0 - rho)).ceil() as usize + 1;
+        loop {
+            let nn = (k + t - 1) as f64;
+            let a = t as f64 / nn;
+            let kl = a * (a / rho).ln() + (1.0 - a) * ((1.0 - a) / (1.0 - rho)).ln();
+            if -nn * kl <= target {
+                return t - 1;
+            }
+            t += 1;
+        }
+    }
+
+    /// The most NvAir rows and SHA compressions the rejection-dependent part can add over the
+    /// shape minimum when at most `j_max` words are rejected in total: per run, `J_r` rejections
+    /// add at most `ceil(J_r / 12)` blocks, so in total at most `ceil(j_max / 12) + min(j_max,
+    /// runs)` extra blocks; reads add half-rows, at most `ceil(j_max / 2) + (extra blocks) +
+    /// min(j_max, runs)` sample rows.
+    pub fn delta_max(&self, j_max: usize) -> (usize, usize) {
+        let extra_jobs = j_max.div_ceil(12) + j_max.min(self.n_runs);
+        let extra_samp = j_max.div_ceil(2) + extra_jobs + j_max.min(self.n_runs);
+        (extra_jobs * self.nv_rows_per_job + extra_samp, extra_jobs * self.comps_per_job)
+    }
+}
