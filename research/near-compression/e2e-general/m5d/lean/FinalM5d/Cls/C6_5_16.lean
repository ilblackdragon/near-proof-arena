/-! ## `SHD` -/
namespace Shd
def L : Layout := [("act", 1), ("q", 1), ("sb", 2), ("c", 2), ("offv", 1), ("d1", 32), ("d2", 32)]
def T : Cols := ⟨L⟩
def act := T.c "act"
def hdrByte (j : Nat) : Expr :=
  if j < 2 then T.c "sb" j else if j == 8 then T.c "c" 0 else if j == 9 then T.c "c" 1 else 0
def constraints : List Expr :=
  actPrefix T ++ [.isFirst * T.c "q", contRow T * (T.n "q" - T.c "q" - 1),
    endRow T * (T.c "q" - K (NS - 1))]
def interactions : List Interaction :=
  [ rcv B_SID act [T.c "q", T.c "sb" 0 + K 256 * T.c "sb" 1],
    rcv B_SCNT act [T.c "q", T.c "c" 0 + K 256 * T.c "c" 1, T.c "offv"] ] ++
  (List.range 12).map (fun j => snd B_SHA_BYTES act [K SHM0 + T.c "q", K j, hdrByte j]) ++
  [ rcv B_SHA_DIGEST act ([K SHM0 + T.c "q", K 12 + T.c "offv"] ++ T.cs "d1" 32) ] ++
  (List.range 32).map (fun j => snd B_SHA_BYTES act [K SHL0 + T.c "q", K j, T.c "d1" j]) ++
  [ rcv B_SHA_DIGEST act ([K SHL0 + T.c "q", K 32] ++ T.cs "d2" 32),
    snd B_NODE act ([K TR_SH, K 0, T.c "q"] ++ T.cs "d2" 32) ] ++
  (List.range 2).map (fun j => rcv B_R8 act [T.c "sb" j]) ++
  (List.range 2).map (fun j => rcv B_R8 act [T.c "c" j])
def table : Table := { width := L.width, constraints, interactions, maxLog := 8 }
end Shd

/-! ## `PART` -/
namespace Part
def L : Layout := [("act", 1), ("q", 1), ("l", 3), ("d", 32)]
def T : Cols := ⟨L⟩
def act := T.c "act"
def constraints : List Expr :=
  actPrefix T ++ [.isFirst * T.c "q", contRow T * (T.n "q" - T.c "q" - 1),
    endRow T * (T.c "q" - K (RST - 1)),
    act * (T.c "l" 0 + K 256 * T.c "l" 1 + K 65536 * T.c "l" 2 - P PV_L)]
def interactions : List Interaction :=
  (List.range 4).map (fun j => snd B_SHA_BYTES act [K PID0 + T.c "q", K j, if j < 3 then T.c "l" j else 0]) ++
  [ rcv B_SHA_DIGEST act ([K PID0 + T.c "q", K 4 + P PV_L] ++ T.cs "d" 32),
    snd B_NODE act ([K TR_RS, K 0, T.c "q"] ++ T.cs "d" 32) ] ++
  (List.range 3).map (fun j => rcv B_R8 act [T.c "l" j])
def table : Table := { width := L.width, constraints, interactions, maxLog := 10 }
end Part

/-! ## `RS` -/
namespace Rs

/-- The encoding matrix of the class (`NearSpecV3.buildMatrix`, the spec's own). -/
def matrix : GFMat := (buildMatrix RSD RST).getD []

/-- Bit `k` of `c · 2^m` in GF(2^8) (`gfMul`, the spec's multiplication). -/
def mulBit (c k m : Nat) : Nat := (gfMul c (2 ^ m) / 2 ^ k) % 2

def L : Layout := [("act", 1), ("off", 1), ("x", 8 * RSD), ("r", 8 * NPAR), ("q", 8 * NPAR)]
def T : Cols := ⟨L⟩
def act := T.c "act"
def dataByte (p : Nat) : Expr := sumE ((List.range 8).map fun m => K (2 ^ m) * T.c "x" (8 * p + m))
def parByte (i : Nat) : Expr := sumE ((List.range 8).map fun k => K (2 ^ k) * T.c "r" (8 * i + k))
def partByte (p : Nat) : Expr := if p < RSD then dataByte p else parByte (p - RSD)

/-- `Σ_{j,m} A_{M[d+i][j]}[k][m] · x_j[m]`: the GF(2)-sum before reduction mod 2. -/
def paritySum (i k : Nat) : Expr :=
  sumE ((List.range RSD).flatMap fun j => (List.range 8).filterMap fun m =>
    if mulBit (matrix.get (RSD + i) j) k m == 1 then some (T.c "x" (8 * j + m)) else none)

def constraints : List Expr :=
  actPrefix T ++
  (List.range (8 * RSD)).map (fun i => bool (T.c "x" i)) ++
  (List.range (8 * NPAR)).map (fun i => bool (T.c "r" i)) ++
  [.isFirst * T.c "off", contRow T * (T.n "off" - T.c "off" - 1), endRow T * (T.c "off" - P PV_L + 1)] ++
  (List.range NPAR).flatMap (fun i => (List.range 8).map fun k =>
    act * (paritySum i k - T.c "r" (8 * i + k) - K 2 * T.c "q" (8 * i + k)))

def interactions : List Interaction :=
  (List.range RSD).map (fun p => rcv B_RSD act [K p, T.c "off", dataByte p]) ++
  (List.range RST).map (fun p => snd B_SHA_BYTES act [K (PID0 + p), K 4 + T.c "off", partByte p]) ++
  (List.range (8 * NPAR)).map (fun i => rcv B_R8 act [T.c "q" i])
def table : Table := { width := L.width, constraints, interactions, maxLog := 22 }
end Rs

/-! ## `OUTL` -/
namespace Outl
def L : Layout := [("act", 1), ("i", 1), ("leaf", 32), ("acc", 42), ("dg", 48)]
def T : Cols := ⟨L⟩
def act := T.c "act"
def och : Expr := K OCH0 + T.c "i"
def constraints : List Expr :=
  actPrefix T ++ [.isFirst * T.c "i", contRow T * (T.n "i" - T.c "i" - 1)]
def interactions : List Interaction :=
  [ rcv B_CHD act ([K CH_OUT, T.c "i"] ++ T.cs "acc" 42) ] ++
  (List.range 42).map (fun j => snd B_SB act [och, K j, T.c "acc" j]) ++
  (List.range 32).map (fun j => snd B_SB act [och, K (42 + j), T.c "leaf" j]) ++
  [ rcv B_SD act ([och, K 74] ++ T.cs "dg" 48),
    snd B_CHD act ([K CH_OUT, T.c "i" + 1] ++ T.cs "dg" 42),
    snd B_NODE act ([K TR_OUT, K 0, T.c "i"] ++ T.cs "leaf" 32) ]
def table : Table := { width := L.width, constraints, interactions, maxLog := 20 }
end Outl

/-! ## `MRK`: nearcore `merklize` as a walk over the levels

A tree starts at a row with `f = 1` receiving `TSTART (tree, n)`; `c` is the node count of the
current level. A hash row `kh` hashes nodes `2·idx`, `2·idx + 1` into node `idx` of the next
level; a carry row `kc` (only the odd last node, `2·idx + 1 = c`) moves node `2·idx` up unhashed;
`z` ends a level (`2·idx + 2 = c` for a hash row) and the next level has `⌈c / 2⌉` nodes; the
terminal row `kt` at a level with `c = 1` sends its node as the `ROOT`, or (`e0`, `c = 0`) the
zero hash. This is `NearSpec.merkleFold` level by level. -/
namespace Mrk
def L : Layout :=
  [("act", 1), ("f", 1), ("tr", 1), ("lvl", 1), ("idx", 1), ("c", 1), ("kh", 1), ("kc", 1),
   ("kt", 1), ("e0", 1), ("z", 1), ("g", 1), ("lb", 32), ("rb", 32), ("ob", 32)]
def T : Cols := ⟨L⟩
def act := T.c "act"
def kh := T.c "kh"
def kc := T.c "kc"
def kt := T.c "kt"
def mid : Expr := K MID0 + T.c "g"
def walk := kh + kc
def constraints : List Expr :=
  actPrefix T ++ (["f", "kh", "kc", "kt", "e0", "z"].map fun s => bool (T.c s)) ++
  [ kh + kc + kt - act, T.c "f" * (1 - act), T.c "e0" * (1 - kt),
    .isFirst * (T.c "f" - act), .isFirst * T.c "g", contRow T * (T.n "g" - T.c "g" - 1),
    T.c "f" * T.c "lvl", T.c "f" * T.c "idx",
    kc * (K 2 * T.c "idx" + 1 - T.c "c"), kc * (1 - T.c "z"),
    kh * T.c "z" * (K 2 * T.c "idx" + 2 - T.c "c"),
    kt * T.c "idx", kt * (T.c "c" - 1 + T.c "e0"), kt * T.c "z",
    -- a walk row is followed by a row of the same tree
    .isTransition * walk * (1 - T.n "act"), .isTransition * walk * T.n "f",
    .isTransition * walk * (T.n "tr" - T.c "tr"),
    .isTransition * walk * (1 - T.c "z") * (T.n "lvl" - T.c "lvl"),
    .isTransition * walk * (1 - T.c "z") * (T.n "idx" - T.c "idx" - 1),
    .isTransition * walk * (1 - T.c "z") * (T.n "c" - T.c "c"),
    .isTransition * walk * T.c "z" * (T.n "lvl" - T.c "lvl" - 1),
    .isTransition * walk * T.c "z" * T.n "idx",
    .isTransition * walk * T.c "z" * (K 2 * T.n "c" - T.c "c" - kc),
    -- after a terminal row: a new tree or the end
    .isTransition * kt * T.n "act" * (1 - T.n "f") ] ++
  (List.range 32).map (fun j => T.c "e0" * T.c "lb" j)
def interactions : List Interaction :=
  [ rcv B_TSTART (T.c "f") [T.c "tr", T.c "c"],
    rcv B_NODE (act - T.c "e0") ([T.c "tr", T.c "lvl", K 2 * T.c "idx"] ++ T.cs "lb" 32),
    rcv B_NODE kh ([T.c "tr", T.c "lvl", K 2 * T.c "idx" + 1] ++ T.cs "rb" 32) ] ++
  (List.range 32).map (fun j => snd B_SHA_BYTES kh [mid, K j, T.c "lb" j]) ++
  (List.range 32).map (fun j => snd B_SHA_BYTES kh [mid, K (32 + j), T.c "rb" j]) ++
  [ rcv B_SHA_DIGEST kh ([mid, K 64] ++ T.cs "ob" 32),
    snd B_NODE walk ([T.c "tr", T.c "lvl" + 1, T.c "idx"] ++
      (List.range 32).map fun j => kh * T.c "ob" j + kc * T.c "lb" j),
    snd B_ROOT kt ([T.c "tr"] ++ T.cs "lb" 32) ]
def table : Table := { width := L.width, constraints, interactions, maxLog := 20 }
end Mrk

/-! ## The assembled FINAL AIR -/

def shaTable : Table := ZkFormal.Sha.Table.table B_SHA_BYTES B_SHA_DIGEST

def finalNames : List String :=
  ["SHA", "S384", "RNG", "STMT", "FIN", "BODY", "SEG", "RS", "PART", "SHD", "OUTL", "MRK"]

def finalAir : Air :=
  { tables := [shaTable, S384.table, Rng.table, Stmt.table, Fin.table, Body.table, Seg.table,
      Rs.table, Part.table, Shd.table, Outl.table, Mrk.table],
    numBuses := NUM_BUSES, numPub := NUM_PUB }

def finalLayouts : List (String × Layout) :=
  [("S384", S384.L), ("RNG", Rng.L), ("STMT", Stmt.L), ("FIN", Fin.L), ("BODY", Body.L),
   ("SEG", Seg.L), ("RS", Rs.L), ("PART", Part.L), ("SHD", Shd.L), ("OUTL", Outl.L), ("MRK", Mrk.L)]

/-! ## Constants for the trace generator (exported next to the AIR) -/

def natList (l : List Nat) : String := "[" ++ ",".intercalate (l.map toString) ++ "]"

def finalConsts : List (String × String) :=
  [("NS", toString NS), ("RSD", toString RSD), ("RST", toString RST), ("CI_OFF", toString CI_OFF),
   ("HBN", toString HBN), ("PRE_LEN", toString PRE_LEN), ("FI_LEN", toString FI_LEN),
   ("FIN_TAG", toString FIN_TAG), ("SHM0", toString SHM0), ("SHL0", toString SHL0),
   ("PID0", toString PID0), ("MID0", toString MID0), ("ID_CLAIM", toString ID_CLAIM),
   ("ID_FIN", toString ID_FIN), ("ID_HDR", toString ID_HDR), ("ID_OUT", toString ID_OUT),
   ("TAG_HDR", toString TAG_HDR), ("TAG_OUT", toString TAG_OUT), ("PV_HDR", toString PV_HDR),
   ("PV_OUT", toString PV_OUT), ("PV_GU", toString PV_GU), ("PV_BB", toString PV_BB),
   ("RCH0", toString RCH0), ("OCH0", toString OCH0),
   ("CH_OUT", toString CH_OUT), ("CH_RC", toString CH_RC), ("TR_OUT", toString TR_OUT),
   ("TR_SH", toString TR_SH), ("TR_RS", toString TR_RS), ("NUM_PUB", toString NUM_PUB),
   ("acc0", natList acc0), ("ivLimbs", natList S384.ivLimbs),
   ("matrix", "[" ++ ",".intercalate (Rs.matrix.map natList) ++ "]"),
   ("streamFixed", "[" ++ ",".intercalate (streamFixed.map fun (a, b) => natList [a, b]) ++ "]")]

end FinalM5d.C6_5_16
