import StateM5a.StHalfC
import StateM5a.T1WsData

/-!
# StateM5a.T1Ws — B-T2: non-vacuity of the state half on T1's real state leaves (kernel)

T1 = `d3c8/d3/02-h10196-s3` (one STATE segment at template S, `D = 5`, 17 working-set keys, 10
committed changes). The data (`T1WsData`, generated by `m5a/t1_leaves.py` from the trace
generator's own working-set construction and the segment proof's `statement.json`) are T1's
INTAKE leaves, its change list and the proof's public values. Here, **evaluated by the kernel**:

* `t1_pub_rin` / `t1_pub_rout` / `t1_pub_len`: the segment proof's public `R_in` / `R_out` limbs
  (values 17–34 / 35–52), read as the circuit reads them (`WsDecode.decDig`) and turned into bytes
  (`WsBridge.toB`), are the 48-byte roots `ca91c86e…` / `2d2e132a…`; `wsLen` = 17;
* `t1_rootL0` / `t1_rootL1`: the state view's depth-24 root (`StateView.wsRoot`, lane E's depth,
  leaf block `leafBlockN`, SHA-384 nodes) of T1's INTAKE leaves is `R_in`, and of the leaves after
  the writes is `R_out` — an independent check of the generator's tree against the view (it
  failed before B-T2's `cmp384` fix);
* `t1_upd`: applying T1's change list to the INTAKE entries (`StHalfC.updE`) gives exactly the
  after-leaves (the SHA-256 of every written value, in the kernel);
* **`t1_ws_nonvac`**: for every state view with lane E's depth and lane B's leaf block, and every
  entry list with T1's keys and INTAKE leaves, `wsRoot` of it is the proof's `R_in`, `wsRoot` of its
  `updE` is the proof's `R_out` and its length is the proof's `wsLen` — the conclusion of
  `WsBridge.WsMoves` (what `ws_moves_seg` derives from `Holds`) holds on T1's real data and agrees
  with its leaf proof's public values; `t1_posOK` / `t1_stc`: the `STC` / position premises are
  satisfiable by the honest commitment.

Axioms: `propext`, `Classical.choice`, `Quot.sound` only (`decide +kernel`, no `native_decide`).
-/

namespace StateM5a.T1Ws

open NearSpec NearSpecV3 NearSpecV3.D2 NearSpecV3.E2E.Bnd
open StateM5a.StateView StateM5a.StateViewParams StateM5a.T1WsData StateM5a.Merkle
open StateM5a.WsBridge StateM5a.StHalfC

abbrev Bytes := ArenaCore.Bytes

/-- T1's roots (`ca91c86e…`, `2d2e132a…`; data module, byte literals). -/
abbrev RIn : Bytes := rootA
abbrev ROut : Bytes := rootB

/-- A public root (18 limbs from `base`) as bytes, as the circuit reads it. -/
def pubRoot (base : Nat) : Bytes := toB (WsDecode.decDig ((List.range 18).map fun j => pubSeg.getD (base + j) 0))

theorem t1_pub_rin : pubRoot 17 = RIn := by decide +kernel
theorem t1_pub_rout : pubRoot 35 = ROut := by decide +kernel
theorem t1_pub_len : pubSeg.getD 16 0 = 17 := by decide +kernel

/-! ## The view's root from leaves -/

def leafDL (l : WsLeaf) : Bytes := cmp384 (leafBlockN l)

/-- The view's depth-24 root of a leaf list (depth-5 root, extended by 19 zero levels). -/
def rootL (ls : List WsLeaf) : Bytes :=
  ((root nodeH 5 (ls.map leafDL ++ List.replicate (32 - ls.length) zero48)).map
    (extUp nodeH zero48 5 19)).getD []

theorem t1_rootL0 : rootL leaves0 = RIn := by decide +kernel
theorem t1_rootL1 : rootL leaves1 = ROut := by decide +kernel

/-- **The view's root is `rootL` of the entries' leaves** (lane E's depth, lane B's leaf block). -/
theorem wsRoot_leaves (P : StViewParams) (hd : P.depth = 24) (hl : P.leafBlock = leafBlockN)
    (es : List Entry) (hlen : es.length ≤ 32) : wsRoot P es = rootL (es.map leafOf) := by
  have h5 : es.length ≤ 2 ^ 5 := hlen
  rw [TmplView.wsRoot_ext P 5 (by omega) es h5, hd]
  have hf : leafD P = leafDL ∘ leafOf := by funext e; simp only [Function.comp, leafD, leafDL, hl]
  unfold rootL TmplView.leavesD
  rw [List.length_map, List.map_map, ← hf]

/-! ## The change list on T1's entries -/

/-- `updE1` at leaf level. -/
def updL (w : List (Bytes × Option Bytes)) (k : Bytes) (l : WsLeaf) : WsLeaf :=
  match kvFind k w with
  | some x => { l with cur := vref x, wr := true }
  | none => l

theorem leafOf_updE1 (w : List (Bytes × Option Bytes)) (e : Entry) :
    leafOf (updE1 w e) = updL w e.1 (leafOf e) := by
  unfold updE1 updL
  cases kvFind e.1 w <;> rfl

theorem t1_upd_k : (List.zip keys leaves0).map (fun p => updL writes p.1 p.2) = leaves1 := by
  decide +kernel

theorem map_updE (w : List (Bytes × Option Bytes)) (es : List Entry) :
    (updE w es).map leafOf = (List.zip (es.map Prod.fst) (es.map leafOf)).map (fun p => updL w p.1 p.2) := by
  induction es with
  | nil => rfl
  | cons e r ih => simp only [updE, List.map_cons, List.zip_cons_cons, leafOf_updE1] at ih ⊢; rw [ih]

theorem t1_upd (es : List Entry) (hk : es.map Prod.fst = keys) (hl : es.map leafOf = leaves0) :
    (updE writes es).map leafOf = leaves1 := by
  rw [map_updE, hk, hl, t1_upd_k]

theorem leaves0_length : leaves0.length = 17 := rfl

/-- **Non-vacuity on T1** (the conclusion of `WsMoves` on T1's real data, at its proof's public
values). -/
theorem t1_ws_nonvac (P : StViewParams) (hd : P.depth = 24) (hlb : P.leafBlock = leafBlockN)
    (es : List Entry) (hk : es.map Prod.fst = keys) (hl : es.map leafOf = leaves0) :
    es.length = pubSeg.getD 16 0 ∧ wsRoot P es = pubRoot 17 ∧
      wsRoot P (updE writes es) = pubRoot 35 := by
  have hlen : es.length = 17 := by rw [← leaves0_length, ← hl, List.length_map]
  refine ⟨by rw [hlen, t1_pub_len], ?_, ?_⟩
  · rw [wsRoot_leaves P hd hlb es (by omega), hl, t1_rootL0, t1_pub_rin]
  · rw [wsRoot_leaves P hd hlb _ (by rw [updE_length]; omega), t1_upd es hk hl, t1_rootL1, t1_pub_rout]

/-- The `STC` premise is satisfiable at T1's roots: the honest commitment of any `fits` state whose
working set is T1's INTAKE entries opens the input and closes to the output. -/
theorem t1_stc (P : StViewParams) (v : StV) (hf : P.fits v = true) (mo : StMeta)
    (hr : wsRoot P (P.wsOf v) = RIn) :
    StcOK (stD P v) (bdigest (close (commitOf P v) ROut mo).ser) RIn ROut (P.wsOf v).length
      (metaOf P v) mo :=
  ⟨commitOf P v, commitOf_wf P v hf, by simp [stD, hf], hr, rfl, rfl, rfl, rfl⟩

#print axioms t1_pub_rin
#print axioms t1_rootL0
#print axioms t1_rootL1
#print axioms t1_upd
#print axioms t1_ws_nonvac
#print axioms t1_stc

end StateM5a.T1Ws
