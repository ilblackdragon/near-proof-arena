import DKTWhirFold
import DKTG2FoldCerts
import DKTG2FoldCoverageCerts

/- Generated by calc/g2_fold_coverage.py transfers.
   Every O-2 sub-code of every measured FINAL round and of the PARENT O-2 rounds.
   Independent scalar folds: the adaptive composition is in DKTAdaptive and
   DKTRoundCompose; Johnson rounds are absent and need DKTGlue. No WHIR bound. -/
namespace DKTG2FoldCoverage
open Polynomial ReedSolomon DKTWhirFold
set_option maxRecDepth 100000
set_option exponentiation.threshold 1000
variable {F E : Type} [Field F] [NeZero (2 : F)] [Field E] [IsAlgClosed E]

open Classical in
/-- FINAL r0, subfold 0; certificate 2013265920,1048576,37140791,1. -/
theorem final_r0_s0 (hF : ringChar F = 2013265921)
    (domain : SquarePairedDomain F 2013265920)
    (word : Fin 2013265920 × Fin 2 → F) (iota : F →+* E) :
    ∃ exceptional : Finset F, (exceptional.card : ℚ) ≤ 25936717896465433738288377 ∧
      ∀ gamma ∉ exceptional, ∀ P : F[X], P.degree < 1048576 →
        37140791 ≤ (polynomialAgreementSet domain.child (backendFold domain word gamma) P).card →
        ∃ parent : F[X], parent.natDegree < 2097152 ∧
          P = FoldingPolynomial.polyFold parent 2 gamma ∧
          37140791 ≤ (pairedPolynomialAgreementSet domain word parent).card := by
  obtain ⟨ex, hcard, hgood⟩ := DKTG2FoldCoverageCerts.mca0 hF domain.child
    (binarySplitWord domain word) iota
  refine ⟨ex, hcard, ?_⟩
  intro gamma hg P hP hA
  rw [backendFold_eq] at hA
  exact exists_parentPolynomial_of_exactAgreement domain word (by decide)
    (by decide : 37140791 ≤ 2 * 37140791) gamma P hA (hgood gamma hg P hP hA)

