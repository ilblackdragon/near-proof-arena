open Classical in
/-- Measured FINAL r0, subfold 1; certificate 1006632960,524288,18570396,1. -/
theorem final_r0_s1 (hF : ringChar F = 2013265921)
    (domain : SquarePairedDomain F 1006632960)
    (word : Fin 1006632960 × Fin 2 → F) (iota : F →+* E) :
    ∃ exceptional : Finset F, (exceptional.card : ℚ) ≤ 6483461178158842957708865 ∧
      ∀ gamma ∉ exceptional, ∀ P : F[X], P.degree < 524288 →
        18570396 ≤ (polynomialAgreementSet domain.child (backendFold domain word gamma) P).card →
        ∃ parent : F[X], parent.natDegree < 1048576 ∧
          P = FoldingPolynomial.polyFold parent 2 gamma ∧
          37140791 ≤ (pairedPolynomialAgreementSet domain word parent).card := by
  obtain ⟨ex, hcard, hgood⟩ := DKTG2FoldCerts.mca0 hF domain.child
    (binarySplitWord domain word) iota
  refine ⟨ex, hcard, ?_⟩
  intro gamma hg P hP hA
  rw [backendFold_eq] at hA
  exact exists_parentPolynomial_of_exactAgreement domain word (by decide)
    (by decide : 37140791 ≤ 2 * 18570396) gamma P hA (hgood gamma hg P hP hA)

