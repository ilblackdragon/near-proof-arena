+                            if near_primitives::hash::hash(&bytes) != hash.0 {
+                                return Err("exported code hash mismatch".into());
+                            }
+                            write(&format!("code/{}.wasm", hash.0), &bytes)?;
+                            codes.push(hash.0.to_string());
+                        }
+                        Err(err) => missing.push(format!("{}: {}", hash.0, err)),
+                    }
+                }
+                for code in &contract_updates.contract_deploys {
+                    write(&format!("code/{}.wasm", code.hash()), code.code())?;
+                }
+                let metadata = serde_json::json!({
+                    "schema": "near-w13-native-capture-v1", "nearcore_commit": "44f7ae6cd7ef08bab604e20a473bf77e35d4c993",
+                    "block_hash": block.hash(), "block_height": block.header().height(),
+                    "chunk_hash": header.chunk_hash(), "height_created": header.height_created(),
+                    "shard_id": header.shard_id(), "epoch_id": state_witness.epoch_id(),
+                    "protocol_version": self.epoch_manager.get_epoch_protocol_version(state_witness.epoch_id())?,
+                    "witness_hash": near_primitives::hash::hash(&raw), "witness_bytes": raw.len(),
+                    "main_transition_shard_id": main_transition_shard_id,
+                    "code_hashes": codes, "missing_code": missing,
+                    "validation_status": "pending; see native-validation.json"
+                });
+                write("capture.json", &serde_json::to_vec_pretty(&metadata)?)?;
+                tracing::info!(target: "client", path=?dir, "W13 witness and full chunk exported");
+                Ok(())
+            };
+            if let Err(err) = capture() {
+                tracing::error!(target: "client", error=%err, "W13 capture failed");
+            }
+        }
         if self.config.save_latest_witnesses {
             self.chain.chain_store.save_latest_chunk_state_witness(&state_witness)?;
         }
