{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CandidateManifest",
  "description": "Parsed `candidate.toml`. Every field is a *claim* the judge validates.",
  "type": "object",
  "required": [
    "agent",
    "backend_family",
    "build",
    "challenge",
    "entry",
    "hardware",
    "name",
    "schema",
    "security_profile_request"
  ],
  "properties": {
    "agent": {
      "type": "string"
    },
    "backend_family": {
      "type": "string"
    },
    "build": {
      "$ref": "#/definitions/BuildSection"
    },
    "challenge": {
      "type": "string"
    },
    "entry": {
      "$ref": "#/definitions/EntrySection"
    },
    "formal": {
      "anyOf": [
        {
          "$ref": "#/definitions/FormalSection"
        },
        {
          "type": "null"
        }
      ]
    },
    "hardware": {
      "$ref": "#/definitions/HardwareRequest"
    },
    "name": {
      "type": "string"
    },
    "parent": {
      "type": [
        "string",
        "null"
      ]
    },
    "schema": {
      "type": "string"
    },
    "security_profile_request": {
      "type": "string"
    }
  },
  "additionalProperties": false,
  "definitions": {
    "BuildSection": {
      "type": "object",
      "required": [
        "outputs",
        "recipe"
      ],
      "properties": {
        "outputs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "recipe": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "EntrySection": {
      "type": "object",
      "required": [
        "prepare",
        "prove",
        "verify"
      ],
      "properties": {
        "prepare": {
          "type": "string"
        },
        "prove": {
          "type": "string"
        },
        "verifier_bytecode": {
          "description": "Built NPAI image (relative path among `build.outputs`), required iff `verify_route = \"npai-v1\"`.",
          "type": [
            "string",
            "null"
          ]
        },
        "verify": {
          "type": "string"
        },
        "verify_route": {
          "description": "How the arena runs verification (v1.2, additive). `native` (default): the built `verify` executable. `npai-v1`: the arena's own NPAI interpreter runs `verifier_bytecode` (docs/INTERP_SPEC.md); `prepare` must then emit exactly `public_dir/public.bin`. `native-lean`: the judge builds `verify` itself from the Lean model `formal.verifier_model` with the governed Lean compiler (the candidate's binary is not used).",
          "anyOf": [
            {
              "$ref": "#/definitions/VerifyRoute"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "FormalSection": {
      "type": "object",
      "required": [
        "certificate",
        "lean_project"
      ],
      "properties": {
        "certificate": {
          "description": "Lean constant whose *type* the judge constructs; candidate supplies the value.",
          "type": "string"
        },
        "lean_project": {
          "type": "string"
        },
        "verifier_model": {
          "description": "`native-lean` route (v1.2, optional): the candidate-defined verifier model `ArenaCore.OracleVerifier` (e.g. `Candidate.Model.verify`) that the judge splices into the expected statement and compiles into `verify`.",
          "type": [
            "string",
            "null"
          ]
        },
        "verifier_model_module": {
          "description": "Lean module declaring `verifier_model` (e.g. `Candidate.Model`).",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "HardwareRequest": {
      "type": "object",
      "required": [
        "gpu",
        "min_ram_gb"
      ],
      "properties": {
        "gpu": {
          "type": "boolean"
        },
        "min_ram_gb": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        }
      },
      "additionalProperties": false
    },
    "VerifyRoute": {
      "type": "string",
      "enum": [
        "native",
        "npai-v1",
        "native-lean"
      ]
    }
  }
}
