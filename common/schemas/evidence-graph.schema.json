{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "EvidenceGraph",
  "type": "object",
  "required": [
    "edges",
    "nodes"
  ],
  "properties": {
    "edges": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/EvidenceEdge"
      }
    },
    "nodes": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/EvidenceNode"
      }
    }
  },
  "definitions": {
    "Digest": {
      "description": "`sha256:<64 lowercase hex>`",
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "EdgeStatus": {
      "oneOf": [
        {
          "description": "Machine-checked evidence (kernel-checked proof, digest equality, ...).",
          "type": "string",
          "enum": [
            "checked"
          ]
        },
        {
          "description": "Approved, visible trusted-base entry.",
          "type": "string",
          "enum": [
            "trusted"
          ]
        },
        {
          "description": "Only tested (differential/fuzz); NOT a substitute for a formal arrow.",
          "type": "string",
          "enum": [
            "tested"
          ]
        },
        {
          "description": "No evidence. Must be rendered.",
          "type": "string",
          "enum": [
            "missing"
          ]
        }
      ]
    },
    "EvidenceEdge": {
      "type": "object",
      "required": [
        "evidence",
        "from",
        "kind",
        "note",
        "status",
        "to"
      ],
      "properties": {
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Digest"
          }
        },
        "from": {
          "type": "string"
        },
        "kind": {
          "description": "e.g. `refines`, `binds`, `assumes`, `built_from`, `tested_against`.",
          "type": "string"
        },
        "note": {
          "type": "string"
        },
        "status": {
          "$ref": "#/definitions/EdgeStatus"
        },
        "to": {
          "type": "string"
        }
      }
    },
    "EvidenceNode": {
      "type": "object",
      "required": [
        "id",
        "kind",
        "label"
      ],
      "properties": {
        "digest": {
          "anyOf": [
            {
              "$ref": "#/definitions/Digest"
            },
            {
              "type": "null"
            }
          ]
        },
        "id": {
          "type": "string"
        },
        "kind": {
          "$ref": "#/definitions/NodeKind"
        },
        "label": {
          "type": "string"
        }
      }
    },
    "NodeKind": {
      "type": "string",
      "enum": [
        "nearcore_source",
        "formal_semantics",
        "backend_semantics",
        "theorem",
        "assumption",
        "artifact",
        "tcb_component",
        "test_suite",
        "measurement"
      ]
    }
  }
}
