{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ChallengeDefinition",
  "type": "object",
  "required": [
    "chain_id",
    "claim_encoding",
    "created_at",
    "hardware_profile",
    "measurement",
    "name",
    "nearcore",
    "not_applicable_gates",
    "protocol_version",
    "required_obligations",
    "resource_limits",
    "runtime_config_digest",
    "schema",
    "season",
    "security_profile",
    "semantic_scope",
    "tier",
    "toolchain_policy",
    "workload_suite"
  ],
  "properties": {
    "chain_id": {
      "type": "string"
    },
    "claim_encoding": {
      "$ref": "#/definitions/ClaimEncoding"
    },
    "coverage": {
      "description": "Coverage tiers (v1.7, additive; absent ⇒ not serialized, so existing challenge ids are unchanged). docs/CONTRACTS.md §11.",
      "anyOf": [
        {
          "$ref": "#/definitions/CoverageSpec"
        },
        {
          "type": "null"
        }
      ]
    },
    "created_at": {
      "type": "string"
    },
    "formal_params": {
      "description": "Formal admission-statement parameters (v1.2, additive; absent ⇒ not serialized, so existing challenge ids are unchanged).",
      "anyOf": [
        {
          "$ref": "#/definitions/FormalParams"
        },
        {
          "type": "null"
        }
      ]
    },
    "hardware_profile": {
      "$ref": "#/definitions/HardwareProfile"
    },
    "measurement": {
      "$ref": "#/definitions/MeasurementProcedure"
    },
    "name": {
      "type": "string"
    },
    "nearcore": {
      "$ref": "#/definitions/NearcorePin"
    },
    "not_applicable_gates": {
      "description": "Gates that may be `NOT_APPLICABLE` under this challenge (e.g. FORMAL_ZK for validity-only profiles).",
      "type": "array",
      "items": {
        "$ref": "#/definitions/ObligationId"
      }
    },
    "protocol_version": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0.0
    },
    "required_obligations": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/ObligationId"
      }
    },
    "resource_limits": {
      "$ref": "#/definitions/ResourceLimits"
    },
    "runtime_config_digest": {
      "$ref": "#/definitions/Digest"
    },
    "schema": {
      "type": "string"
    },
    "scoring": {
      "description": "Scoring kind and, for `cost_v1`, the pinned price model and reference cost components (v1.5, additive; absent ⇒ `speed` and not serialized, so existing challenge ids are unchanged). docs/BENCHMARK_SPEC.md §14.",
      "anyOf": [
        {
          "$ref": "#/definitions/ScoringSpec"
        },
        {
          "type": "null"
        }
      ]
    },
    "season": {
      "type": "string"
    },
    "security_profile": {
      "$ref": "#/definitions/SecurityProfile"
    },
    "semantic_scope": {
      "$ref": "#/definitions/SemanticScope"
    },
    "supersedes": {
      "type": [
        "string",
        "null"
      ]
    },
    "tier": {
      "$ref": "#/definitions/Tier"
    },
    "toolchain_policy": {
      "$ref": "#/definitions/ToolchainPolicy"
    },
    "workload_suite": {
      "$ref": "#/definitions/WorkloadSuite"
    }
  },
  "additionalProperties": false,
  "definitions": {
    "AdversaryClass": {
      "oneOf": [
        {
          "description": "Classical PPT adversary. Nothing in this profile implies post-quantum security.",
          "type": "string",
          "enum": [
            "classical"
          ]
        }
      ]
    },
    "BaselineMode": {
      "description": "Where a `cost_v1` class's reference cost comes from (contracts v1.8, bench-spec-v1.6; docs/BENCHMARK_SPEC.md §6.2, §14.12).",
      "oneOf": [
        {
          "description": "The pinned `cost_baseline` (bench-spec-v1.2–v1.4; the absent field).",
          "type": "string",
          "enum": [
            "frozen"
          ]
        },
        {
          "description": "The paired baseline control: the judge runs the challenge's reference (`workload_suite.baseline_submission`) on exactly the candidate's sampled batches, interleaved round by round on the same CPUs, and each class's reference cost is measured in the same session (`ClassMeasurement.ref_*`). `cost_baseline` stays pinned as the documented reference profile and is reported, never scored.",
          "type": "string",
          "enum": [
            "paired"
          ]
        }
      ]
    },
    "CalibrationSpec": {
      "description": "The judge calibration workload (bench-spec-v1.6, §6.1): a fixed, deterministic binary (`runners/calibrate`, `arena-calibrate`), pinned by digest, run in the benchmark sandbox on the benchmark CPUs as probes before the session, at the start of every measured round, and after it.",
      "type": "object",
      "required": [
        "binary_digest",
        "edge_probes",
        "expected_checksum",
        "max_noise_ppm",
        "max_step_ppm",
        "steps_per_probe",
        "threads",
        "workload"
      ],
      "properties": {
        "binary_digest": {
          "description": "sha256 of the static `arena-calibrate` binary; the worker refuses any other.",
          "allOf": [
            {
              "$ref": "#/definitions/Digest"
            }
          ]
        },
        "edge_probes": {
          "description": "Probes before and after the session (each).",
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        },
        "expected_checksum": {
          "description": "The checksum the workload must print (a wrong one is INFRA).",
          "type": "string"
        },
        "max_noise_ppm": {
          "description": "Gate: MAD / median over all probes of the session (ppm).",
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        },
        "max_reference_drift_ppm": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0.0
        },
        "max_step_ppm": {
          "description": "Gate: the 90th-percentile step between consecutive probes (ppm).",
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        },
        "reference_median_ns": {
          "description": "Host admission median of one probe on this hardware profile; when set, the session median must be within `max_reference_drift_ppm` of it.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0.0
        },
        "steps_per_probe": {
          "description": "Timed runs per probe, after one untimed warm-up run, all in one sandbox instance; the probe is their median.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        },
        "threads": {
          "description": "Worker threads per probe (= the benchmark vCPUs).",
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        },
        "workload": {
          "description": "`arena-calibrate-v1`.",
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "ClaimEncoding": {
      "type": "object",
      "required": [
        "format",
        "max_claim_bytes",
        "max_request_bytes",
        "max_witness_bytes",
        "spec_digest"
      ],
      "properties": {
        "format": {
          "type": "string"
        },
        "max_claim_bytes": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        },
        "max_request_bytes": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        },
        "max_witness_bytes": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        },
        "spec_digest": {
          "$ref": "#/definitions/Digest"
        }
      },
      "additionalProperties": false
    },
    "CostBaselineClass": {
      "description": "Reference-candidate cost components of one class, measured under the challenge's procedure (component medians over measured runs; one run = one batch of `batch_size` requests).",
      "type": "object",
      "required": [
        "class_id",
        "proof_bytes",
        "prove_ns",
        "verify_ns"
      ],
      "properties": {
        "class_id": {
          "type": "string"
        },
        "proof_bytes": {
          "description": "Median Σ proof bytes per batch.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        },
        "prove_ns": {
          "description": "Median Σ prove wall ns per batch; must equal `workload_suite.baseline_ns`.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        },
        "verify_ns": {
          "description": "Median Σ verify wall ns per batch, on `verifier_vcpus` CPUs.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        }
      },
      "additionalProperties": false
    },
    "CoverageSpec": {
      "description": "`ChallengeDefinition.coverage`.",
      "type": "object",
      "required": [
        "soundness_lift",
        "statement_spec",
        "tiers",
        "version"
      ],
      "properties": {
        "soundness_lift": {
          "description": "Trusted Lean lemma lifting tier soundness to the statement, e.g. `NearSpecV3.sound_lift`.",
          "type": "string"
        },
        "statement_spec": {
          "description": "Lean declaration of the top `ChallengeSpec` (the statement every admitted verifier is sound for), e.g. `NearSpecV3.challengeSpecChunkTop`.",
          "type": "string"
        },
        "tiers": {
          "description": "Tiers in any order; `rank` is the total order (higher = larger domain).",
          "type": "array",
          "items": {
            "$ref": "#/definitions/CoverageTier"
          }
        },
        "version": {
          "description": "`\"coverage-v1\"`.",
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "CoverageTier": {
      "type": "object",
      "required": [
        "classes",
        "id",
        "params",
        "rank"
      ],
      "properties": {
        "classes": {
          "description": "Workload classes this tier is complete for: an abstention on a positive case of one of them is `COVERAGE_GAP_IN_TIER`.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "id": {
          "description": "Tier id, e.g. `D0`, `D1`, `D2`, `D3a`.",
          "type": "string"
        },
        "params": {
          "description": "Lean declaration (term) of the tier's `ChallengeParams`, e.g. `NearSpecV3.challengeParamsChunk .d0`. The judge's per-tier Expected template (formal-checker config `tiers`) instantiates exactly this.",
          "type": "string"
        },
        "rank": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        }
      },
      "additionalProperties": false
    },
    "Digest": {
      "description": "`sha256:<64 lowercase hex>`",
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "FormalParams": {
      "description": "Parameters of the judge-built admission statement that are not resource limits of the sandbox (`ArenaCore.ChallengeParams`). Optional so that challenges without a formal statement (demo) keep their ids.",
      "type": "object",
      "required": [
        "max_proof_bytes",
        "max_reduction_fuel",
        "verify_fuel"
      ],
      "properties": {
        "max_proof_bytes": {
          "description": "Honest proof-size bound used by `VerifierComplete` (`ChallengeParams.maxProofBytes`); must equal `resource_limits.max_proof_bytes`.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        },
        "max_reduction_fuel": {
          "description": "Fuel cap of an explicit standard-model security reduction (`ChallengeParams.maxReductionFuel`).",
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        },
        "verify_fuel": {
          "description": "NPAI fuel given to the approved interpreter for one `verify` call (`ChallengeParams.verifyFuel`).",
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        }
      },
      "additionalProperties": false
    },
    "FormalSpecRef": {
      "type": "object",
      "required": [
        "lean_toolchain",
        "relation_decl",
        "relation_module",
        "tree_digest"
      ],
      "properties": {
        "lean_toolchain": {
          "description": "Lean toolchain, e.g. `leanprover/lean4:v4.x.y`.",
          "type": "string"
        },
        "relation_decl": {
          "description": "Fully qualified Lean name of the relation, e.g. `NearSpec.TransferV1.NearRelation`.",
          "type": "string"
        },
        "relation_module": {
          "description": "Lean module that defines `NearRelation` for this challenge.",
          "type": "string"
        },
        "tree_digest": {
          "description": "Tree digest of `spec/lean` + `formal-core` sources the challenge was frozen against.",
          "allOf": [
            {
              "$ref": "#/definitions/Digest"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "HardwareProfile": {
      "type": "object",
      "required": [
        "cpu_model",
        "id",
        "ram_bytes",
        "vcpus"
      ],
      "properties": {
        "cpu_model": {
          "type": "string"
        },
        "gpu": {
          "type": [
            "string",
            "null"
          ]
        },
        "id": {
          "type": "string"
        },
        "ram_bytes": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        },
        "vcpus": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        }
      },
      "additionalProperties": false
    },
    "InvocationMode": {
      "description": "Sandbox-instance granularity of steady-state benchmark runs.",
      "oneOf": [
        {
          "description": "bench-spec-v1: every `prove` invocation in its own fresh sandbox instance (a microVM boot per request is inside nothing timed, but the guest page cache is cold for every invocation).",
          "type": "string",
          "enum": [
            "vm_per_invocation"
          ]
        },
        {
          "description": "bench-spec-v1.1: each measured batch runs in ONE fresh sandbox instance; every request is still a fresh process with a wiped scratch, only its own inputs and no state carried between requests. One untimed warm-up invocation on the batch's first request precedes the timed ones. Cold runs stay one instance per invocation.",
          "type": "string",
          "enum": [
            "vm_per_batch"
          ]
        }
      ]
    },
    "MeasurementProcedure": {
      "type": "object",
      "required": [
        "aggregation",
        "cold_runs",
        "concurrency",
        "measured_runs",
        "outlier_mad_k",
        "per_run_timeout_ms",
        "warmup_runs"
      ],
      "properties": {
        "aggregation": {
          "description": "`median` only in v1.",
          "type": "string"
        },
        "calibration": {
          "description": "The pinned calibration binary and its probe rule (v1.8, additive; docs/BENCHMARK_SPEC.md §6.1). Absent = no in-session calibration (the live worker before v1.8).",
          "anyOf": [
            {
              "$ref": "#/definitions/CalibrationSpec"
            },
            {
              "type": "null"
            }
          ]
        },
        "cold_runs": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        },
        "concurrency": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        },
        "invocation_mode": {
          "description": "How benchmark invocations are isolated (v1.4, additive; absent ⇒ `vm_per_invocation`, i.e. bench-spec-v1, and not serialized, so existing challenge ids are unchanged). See docs/BENCHMARK_SPEC.md §4.",
          "anyOf": [
            {
              "$ref": "#/definitions/InvocationMode"
            },
            {
              "type": "null"
            }
          ]
        },
        "measured_runs": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        },
        "outlier_mad_k": {
          "description": "Runs farther than this many MADs from the median are flagged (not dropped).",
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        },
        "per_run_timeout_ms": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        },
        "warmup_runs": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        }
      },
      "additionalProperties": false
    },
    "NearcorePin": {
      "type": "object",
      "required": [
        "commit",
        "repo",
        "tag"
      ],
      "properties": {
        "commit": {
          "type": "string"
        },
        "repo": {
          "type": "string"
        },
        "tag": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "ObligationId": {
      "type": "string",
      "enum": [
        "PKG_WELLFORMED",
        "BUILD_REPRODUCIBLE",
        "ARTIFACT_BINDING",
        "FORMAL_SEMANTIC_SOUNDNESS",
        "FORMAL_SEMANTIC_COMPLETENESS",
        "FORMAL_CRYPTO_SOUNDNESS",
        "FORMAL_IMPL_CONNECTION",
        "FORMAL_ZK",
        "AXIOM_AUDIT",
        "CONFORMANCE_DIFFERENTIAL",
        "ADVERSARIAL_PROOFS",
        "PROVER_RELIABILITY",
        "RESOURCE_LIMITS",
        "BENCHMARK"
      ]
    },
    "PriceModel": {
      "description": "`arena-price-model-v1`: integers only, femto-USD. Per-chunk system cost of one proved request (docs/BENCHMARK_SPEC.md §14.2):\n\n```text C = c_cpu·vcpus_p·T_prove + c_cpu·vcpus_p·T_prepare·/A + N_v · ( c_cpu·vcpus_v·T_verify + (c_bw + c_store)·proof_bytes ) ```",
      "type": "object",
      "required": [
        "bandwidth_fusd_per_byte",
        "cpu_fusd_per_vcpu_second",
        "currency",
        "effective_from",
        "id",
        "prepare_amortization_requests",
        "rationale",
        "schema",
        "status",
        "storage_fusd_per_byte",
        "unit",
        "validators_per_chunk",
        "verifier_vcpus",
        "version"
      ],
      "properties": {
        "bandwidth_fusd_per_byte": {
          "description": "`c_bw`: network cost per proof byte per validator.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        },
        "cpu_fusd_per_vcpu_second": {
          "description": "`c_cpu`: price of one vCPU for one second (prover and validator).",
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        },
        "currency": {
          "description": "`USD`.",
          "type": "string"
        },
        "effective_from": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "prepare_amortization_requests": {
          "description": "`A`: requests over which one `prepare` is amortized; 0 = `prepare` is not charged (reported only, bench-spec-v1 §2).",
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        },
        "rationale": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/PriceRationale"
          }
        },
        "schema": {
          "description": "`arena-price-model-v1`.",
          "type": "string"
        },
        "status": {
          "description": "`draft` (never pinned by a signed challenge) or `governed`.",
          "type": "string"
        },
        "storage_fusd_per_byte": {
          "description": "`c_store`: retention cost per proof byte per validator (0 = none).",
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        },
        "unit": {
          "description": "`femto_usd`.",
          "type": "string"
        },
        "validators_per_chunk": {
          "description": "`N_v`: validators that each verify every chunk's proof (stateless validation fan-out). ≥ 1.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        },
        "verifier_vcpus": {
          "description": "vCPUs of the reference validator profile; `verify` is measured pinned to this many of the benchmark CPUs and charged for them. ≥ 1 and ≤ the challenge's `hardware_profile.vcpus`.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        },
        "version": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        }
      },
      "additionalProperties": false
    },
    "PriceRationale": {
      "description": "Why a price-model parameter has its value (part of the hashed object, so the rationale cannot be edited without a new version).",
      "type": "object",
      "required": [
        "basis",
        "note",
        "param",
        "sources"
      ],
      "properties": {
        "basis": {
          "description": "`protocol` (read from pinned nearcore), `published` (public price list / docs), or `estimate` (a modelling choice).",
          "type": "string"
        },
        "note": {
          "type": "string"
        },
        "param": {
          "description": "Field name of the parameter, e.g. `validators_per_chunk`.",
          "type": "string"
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "Privacy": {
      "type": "string",
      "enum": [
        "validity_only",
        "zero_knowledge"
      ]
    },
    "ResourceLimits": {
      "type": "object",
      "required": [
        "max_build_ms",
        "max_prepare_ms",
        "max_proof_bytes",
        "max_prove_ms",
        "max_public_artifact_bytes",
        "max_ram_bytes",
        "max_verify_ms",
        "max_vram_bytes"
      ],
      "properties": {
        "max_build_ms": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        },
        "max_prepare_ms": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        },
        "max_proof_bytes": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        },
        "max_prove_ms": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        },
        "max_public_artifact_bytes": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        },
        "max_ram_bytes": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        },
        "max_verify_ms": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        },
        "max_vram_bytes": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        }
      },
      "additionalProperties": false
    },
    "Restriction": {
      "type": "object",
      "required": [
        "id",
        "text"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "text": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "ScopeKind": {
      "type": "string",
      "enum": [
        "full_chunk_transition",
        "subset"
      ]
    },
    "ScoringKind": {
      "oneOf": [
        {
          "description": "bench-spec-v1 §8: weighted geometric mean of prove-time speedups.",
          "type": "string",
          "enum": [
            "speed"
          ]
        },
        {
          "description": "bench-spec §14: weighted geometric mean of per-class system-cost ratios under a pinned [`PriceModel`].",
          "type": "string",
          "enum": [
            "cost_v1"
          ]
        }
      ]
    },
    "ScoringSpec": {
      "description": "`ChallengeDefinition.scoring` (v1.5, additive).",
      "type": "object",
      "required": [
        "kind"
      ],
      "properties": {
        "baseline_mode": {
          "description": "v1.8, additive; absent = `frozen`.",
          "anyOf": [
            {
              "$ref": "#/definitions/BaselineMode"
            },
            {
              "type": "null"
            }
          ]
        },
        "cost_baseline": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/CostBaselineClass"
          }
        },
        "cost_baseline_prepare_ns": {
          "description": "Reference candidate's `prepare` wall ns (only charged when `prepare_amortization_requests > 0`).",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0.0
        },
        "kind": {
          "$ref": "#/definitions/ScoringKind"
        },
        "price_model": {
          "anyOf": [
            {
              "$ref": "#/definitions/PriceModel"
            },
            {
              "type": "null"
            }
          ]
        },
        "price_model_digest": {
          "description": "JCS sha256 of `price_model`; shown on every cost-board row.",
          "anyOf": [
            {
              "$ref": "#/definitions/Digest"
            },
            {
              "type": "null"
            }
          ]
        },
        "verify_statistic": {
          "description": "Aggregation of per-run verify totals (v1.6, additive; absent = `median`). `cost_baseline.verify_ns` is pinned with the same statistic.",
          "anyOf": [
            {
              "$ref": "#/definitions/VerifyStatistic"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "SecurityModel": {
      "type": "string",
      "enum": [
        "standard",
        "random_oracle"
      ]
    },
    "SecurityProfile": {
      "description": "Governed security profile (`security/profiles/<id>.json`).",
      "type": "object",
      "required": [
        "adversary",
        "allowed_assumptions",
        "deployment_proofs_log2",
        "id",
        "max_aggregation_depth",
        "max_hash_queries_log2",
        "max_prover_queries_log2",
        "model",
        "privacy",
        "setup_model",
        "target_bits"
      ],
      "properties": {
        "adversary": {
          "$ref": "#/definitions/AdversaryClass"
        },
        "allowed_assumptions": {
          "description": "Ids into `security/assumptions/*.json`; each pins an exact Lean declaration.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "deployment_proofs_log2": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        },
        "id": {
          "type": "string"
        },
        "max_aggregation_depth": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        },
        "max_hash_queries_log2": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        },
        "max_prover_queries_log2": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        },
        "model": {
          "$ref": "#/definitions/SecurityModel"
        },
        "privacy": {
          "$ref": "#/definitions/Privacy"
        },
        "setup_model": {
          "$ref": "#/definitions/SetupModel"
        },
        "target_bits": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        }
      },
      "additionalProperties": false
    },
    "SemanticScope": {
      "type": "object",
      "required": [
        "excludes",
        "formal_spec",
        "granularity",
        "kind",
        "name",
        "restrictions",
        "spec_doc_digest"
      ],
      "properties": {
        "excludes": {
          "description": "Properties explicitly NOT established by an admitted proof.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "formal_spec": {
          "$ref": "#/definitions/FormalSpecRef"
        },
        "granularity": {
          "description": "e.g. `single_action_receipt_transition`, `chunk_transition`.",
          "type": "string"
        },
        "kind": {
          "$ref": "#/definitions/ScopeKind"
        },
        "name": {
          "type": "string"
        },
        "restrictions": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Restriction"
          }
        },
        "spec_doc_digest": {
          "description": "Human-readable spec document digest (`spec/<name>.md`).",
          "allOf": [
            {
              "$ref": "#/definitions/Digest"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "SetupModel": {
      "type": "string",
      "enum": [
        "none",
        "transparent",
        "approved_ceremony"
      ]
    },
    "Tier": {
      "oneOf": [
        {
          "description": "Official ranked board; all formal obligations mandatory.",
          "type": "string",
          "enum": [
            "formal"
          ]
        },
        {
          "description": "Tests + diagnostic timings only; never ranked as formal.",
          "type": "string",
          "enum": [
            "experimental"
          ]
        },
        {
          "description": "Plumbing demonstration; simulated components allowed, always labelled DEMO.",
          "type": "string",
          "enum": [
            "demo"
          ]
        }
      ]
    },
    "ToolchainPolicy": {
      "type": "object",
      "required": [
        "allowed_packages",
        "axiom_allowlist",
        "checker_image",
        "lean_toolchain",
        "recheckers"
      ],
      "properties": {
        "allowed_packages": {
          "description": "Allowed Lean package imports: name -> pinned git commit.",
          "type": "array",
          "items": {
            "type": "array",
            "items": [
              {
                "type": "string"
              },
              {
                "type": "string"
              }
            ],
            "maxItems": 2,
            "minItems": 2
          }
        },
        "axiom_allowlist": {
          "description": "Exact logical axioms permitted (fully qualified names).",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "checker_image": {
          "description": "Digest of the formal checker image (rootfs) used for clean rechecks.",
          "allOf": [
            {
              "$ref": "#/definitions/Digest"
            }
          ]
        },
        "lean_toolchain": {
          "type": "string"
        },
        "recheckers": {
          "description": "Independent kernel recheckers that must all accept, e.g. `lean4checker`, `nanoda`.",
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "VerifyStatistic": {
      "description": "How the per-run verify totals of a class are aggregated into the `V` component of the cost (docs/BENCHMARK_SPEC.md §14.3; contracts v1.6).",
      "oneOf": [
        {
          "description": "`median_u64` (bench-spec-v1.2 / v1.3; the meaning of an absent field).",
          "type": "string",
          "enum": [
            "median"
          ]
        },
        {
          "description": "`lower_quartile_u64`: the order statistic at index ⌊(n−1)/4⌋ of the sorted runs (bench-spec-v1.4).",
          "type": "string",
          "enum": [
            "lower_quartile"
          ]
        }
      ]
    },
    "WeightSource": {
      "description": "Provenance of `WorkloadSuite` class weights (contracts v1.7, additive).",
      "type": "object",
      "required": [
        "note",
        "status"
      ],
      "properties": {
        "note": {
          "description": "What the weights rest on (the assumption, or how they were measured).",
          "type": "string"
        },
        "ref": {
          "description": "Repo-relative path or digest of the supporting record (the documented assumption, or the measurement report). Required for `MEASURED`.",
          "type": [
            "string",
            "null"
          ]
        },
        "status": {
          "$ref": "#/definitions/WeightSourceStatus"
        }
      },
      "additionalProperties": false
    },
    "WeightSourceStatus": {
      "oneOf": [
        {
          "description": "Documented assumption; no measured mix exists yet.",
          "type": "string",
          "enum": [
            "ASSUMED"
          ]
        },
        {
          "description": "Measured from a real-chain mix (e.g. mainnet replay).",
          "type": "string",
          "enum": [
            "MEASURED"
          ]
        }
      ]
    },
    "WorkloadClass": {
      "type": "object",
      "required": [
        "batch_size",
        "description",
        "generator",
        "id",
        "weight_ppm"
      ],
      "properties": {
        "batch_size": {
          "description": "Number of requests per measured batch.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        },
        "description": {
          "type": "string"
        },
        "generator": {
          "description": "Digest of the generator spec (fresh inputs are sampled after freeze).",
          "allOf": [
            {
              "$ref": "#/definitions/Digest"
            }
          ]
        },
        "id": {
          "type": "string"
        },
        "weight_ppm": {
          "description": "Weight in parts-per-million; all weights in a suite sum to 1_000_000.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        }
      },
      "additionalProperties": false
    },
    "WorkloadSuite": {
      "type": "object",
      "required": [
        "baseline_ns",
        "classes",
        "heldout_commitment",
        "public_fixtures",
        "revision"
      ],
      "properties": {
        "baseline_ns": {
          "type": "array",
          "items": {
            "type": "array",
            "items": [
              {
                "type": "string"
              },
              {
                "type": "integer",
                "format": "uint64",
                "minimum": 0.0
              }
            ],
            "maxItems": 2,
            "minItems": 2
          }
        },
        "baseline_submission": {
          "description": "Baseline candidate submission id and per-class baseline medians (ns).",
          "type": [
            "string",
            "null"
          ]
        },
        "classes": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/WorkloadClass"
          }
        },
        "heldout_commitment": {
          "description": "Commitment to the held-out set (digest of its tree), revealed at season end.",
          "allOf": [
            {
              "$ref": "#/definitions/Digest"
            }
          ]
        },
        "public_fixtures": {
          "description": "Public dev fixtures (tree digest). Held-out and fresh inputs are not listed here.",
          "allOf": [
            {
              "$ref": "#/definitions/Digest"
            }
          ]
        },
        "revision": {
          "type": "string"
        },
        "weight_source": {
          "description": "Where the class weights come from (v1.7, additive; absent ⇒ not serialized, so existing challenge ids are unchanged). docs/CONTRACTS.md §11, docs/BENCHMARK_SPEC.md §17.",
          "anyOf": [
            {
              "$ref": "#/definitions/WeightSource"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false
    }
  }
}
