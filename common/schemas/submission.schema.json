{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SubmissionView",
  "description": "Public view of a submission (API `GET /v1/submissions/{id}`).",
  "type": "object",
  "required": [
    "agent",
    "backend_family",
    "candidate_name",
    "challenge_id",
    "created_at",
    "gates",
    "id",
    "package_digest",
    "reason_codes",
    "stage",
    "tier",
    "updated_at"
  ],
  "properties": {
    "accepted": {
      "description": "`null` while pending; `true` only if every mandatory gate passed.",
      "type": [
        "boolean",
        "null"
      ]
    },
    "agent": {
      "type": "string"
    },
    "artifacts": {
      "description": "Public artifacts produced by the judge for this run.",
      "default": [],
      "type": "array",
      "items": {
        "$ref": "#/definitions/ArtifactRef"
      }
    },
    "assumptions": {
      "description": "Assumptions the admission may rely on (the challenge's security profile).",
      "default": [],
      "type": "array",
      "items": {
        "$ref": "#/definitions/AssumptionRef"
      }
    },
    "backend_family": {
      "type": "string"
    },
    "benchmark": {
      "anyOf": [
        {
          "$ref": "#/definitions/BenchmarkResult"
        },
        {
          "type": "null"
        }
      ]
    },
    "build": {
      "default": null,
      "anyOf": [
        {
          "$ref": "#/definitions/BuildInfo"
        },
        {
          "type": "null"
        }
      ]
    },
    "candidate_name": {
      "type": "string"
    },
    "challenge_id": {
      "type": "string"
    },
    "change_class": {
      "anyOf": [
        {
          "$ref": "#/definitions/ChangeClass"
        },
        {
          "type": "null"
        }
      ]
    },
    "coverage": {
      "description": "Coverage-tiered challenges: the declared tier and proven coverage (CONTRACTS §11).",
      "anyOf": [
        {
          "$ref": "#/definitions/CoverageReport"
        },
        {
          "type": "null"
        }
      ]
    },
    "created_at": {
      "type": "string"
    },
    "decision": {
      "anyOf": [
        {
          "$ref": "#/definitions/Decision"
        },
        {
          "type": "null"
        }
      ]
    },
    "evidence_graph": {
      "anyOf": [
        {
          "$ref": "#/definitions/EvidenceGraph"
        },
        {
          "type": "null"
        }
      ]
    },
    "gates": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/GateResult"
      }
    },
    "id": {
      "type": "string"
    },
    "logs": {
      "description": "Bounded, sanitized plain-text log excerpts (never HTML).",
      "default": [],
      "type": "array",
      "items": {
        "$ref": "#/definitions/LogExcerpt"
      }
    },
    "package_digest": {
      "$ref": "#/definitions/Digest"
    },
    "parent": {
      "type": [
        "string",
        "null"
      ]
    },
    "reason_codes": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/ReasonCode"
      }
    },
    "revocation_history": {
      "default": [],
      "type": "array",
      "items": {
        "$ref": "#/definitions/RevocationEvent"
      }
    },
    "revoked": {
      "anyOf": [
        {
          "$ref": "#/definitions/Revocation"
        },
        {
          "type": "null"
        }
      ]
    },
    "score_milli": {
      "type": [
        "integer",
        "null"
      ],
      "format": "uint64",
      "minimum": 0.0
    },
    "stage": {
      "$ref": "#/definitions/Stage"
    },
    "tier": {
      "$ref": "#/definitions/Tier"
    },
    "trusted_base": {
      "description": "Trusted computing base entries the result depends on.",
      "default": [],
      "type": "array",
      "items": {
        "$ref": "#/definitions/TrustedBaseEntry"
      }
    },
    "updated_at": {
      "type": "string"
    },
    "verified_surface": {
      "description": "Verified-surface digests (set once the judge build completed).",
      "default": null,
      "anyOf": [
        {
          "$ref": "#/definitions/VerifiedSurface"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "definitions": {
    "ArtifactRef": {
      "type": "object",
      "required": [
        "digest",
        "label"
      ],
      "properties": {
        "digest": {
          "$ref": "#/definitions/Digest"
        },
        "label": {
          "type": "string"
        }
      }
    },
    "AssumptionRef": {
      "type": "object",
      "required": [
        "id"
      ],
      "properties": {
        "description": {
          "type": [
            "string",
            "null"
          ]
        },
        "id": {
          "type": "string"
        },
        "lean_decl": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "BenchmarkResult": {
      "type": "object",
      "required": [
        "classes",
        "hardware_profile",
        "measured_by",
        "prepare_ns",
        "public_artifact_bytes",
        "suite_revision"
      ],
      "properties": {
        "classes": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/ClassMeasurement"
          }
        },
        "cost": {
          "description": "Cost-board result for `scoring.kind = cost_v1` challenges (v1.5, additive). Never compared with `score_milli` (a speed score).",
          "anyOf": [
            {
              "$ref": "#/definitions/CostResult"
            },
            {
              "type": "null"
            }
          ]
        },
        "hardware_profile": {
          "type": "string"
        },
        "measured_by": {
          "type": "string"
        },
        "prepare_ns": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        },
        "public_artifact_bytes": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        },
        "score_ci_milli": {
          "description": "Half-width of a bootstrap 95% interval, milli units.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0.0
        },
        "score_milli": {
          "description": "Score * 1000 as integer (e.g. 100000 == 100.000).",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0.0
        },
        "suite_revision": {
          "type": "string"
        }
      }
    },
    "BuildInfo": {
      "type": "object",
      "required": [
        "reproducible"
      ],
      "properties": {
        "build_ns": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0.0
        },
        "reproducible": {
          "description": "`BUILD_REPRODUCIBLE` passed (two judge builds bit-identical).",
          "type": "boolean"
        },
        "toolchain_image": {
          "description": "Build sandbox image/rootfs digest or id, if reported.",
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "ChangeClass": {
      "description": "Change classification, computed by the judge (never trusted from the agent).",
      "type": "string",
      "enum": [
        "NO_PARENT",
        "PROVER_ONLY",
        "VERIFIER_OR_PROTOCOL"
      ]
    },
    "ClassCoverage": {
      "description": "Per-class tally of positive cases.",
      "type": "object",
      "required": [
        "abstained",
        "cases",
        "proven"
      ],
      "properties": {
        "abstained": {
          "description": "`prove` answered `UNSUPPORTED`.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        },
        "cases": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        },
        "proven": {
          "description": "Proved and accepted by `verify`.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        }
      },
      "additionalProperties": false
    },
    "ClassMeasurement": {
      "type": "object",
      "required": [
        "baseline_ns",
        "class_id",
        "mad_ns",
        "median_ns",
        "peak_rss_bytes",
        "proof_bytes_max",
        "runs_ns",
        "verify_median_ns",
        "weight_ppm"
      ],
      "properties": {
        "abstained": {
          "description": "v1.7 (coverage-tiered challenges only): `prove` answered `UNSUPPORTED` in this class, so it carries no timing (all time fields 0) and is excluded from the score with the weights renormalized (BENCHMARK_SPEC §17).",
          "type": "boolean"
        },
        "baseline_ns": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        },
        "class_id": {
          "type": "string"
        },
        "cold_ns": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0.0
        },
        "mad_ns": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        },
        "median_ns": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        },
        "peak_rss_bytes": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        },
        "proof_bytes_max": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        },
        "proof_bytes_runs": {
          "description": "Per measured run: Σ proof bytes of the batch (v1.5, additive).",
          "type": "array",
          "items": {
            "type": "integer",
            "format": "uint64",
            "minimum": 0.0
          }
        },
        "runs_ns": {
          "type": "array",
          "items": {
            "type": "integer",
            "format": "uint64",
            "minimum": 0.0
          }
        },
        "verify_median_ns": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        },
        "verify_runs_ns": {
          "description": "Per measured run (same order as `runs_ns`): Σ verify wall ns of the batch's proofs (v1.5, additive; empty in older results).",
          "type": "array",
          "items": {
            "type": "integer",
            "format": "uint64",
            "minimum": 0.0
          }
        },
        "weight_ppm": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        }
      }
    },
    "CostClass": {
      "description": "Cost components of one class (component medians, integer femto-USD per batch run). `*_fusd` validator terms already include the `N_v` factor.",
      "type": "object",
      "required": [
        "bandwidth_fusd",
        "baseline_total_fusd",
        "class_id",
        "prepare_fusd",
        "proof_bytes",
        "prove_fusd",
        "prove_ns",
        "storage_fusd",
        "total_fusd",
        "verify_fusd",
        "verify_ns",
        "weight_ppm"
      ],
      "properties": {
        "bandwidth_fusd": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        },
        "baseline_total_fusd": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        },
        "class_id": {
          "type": "string"
        },
        "prepare_fusd": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        },
        "proof_bytes": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        },
        "prove_fusd": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        },
        "prove_ns": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        },
        "storage_fusd": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        },
        "total_fusd": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        },
        "verify_fusd": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        },
        "verify_ns": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        },
        "weight_ppm": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        }
      }
    },
    "CostResult": {
      "description": "`BenchmarkResult.cost` (v1.5, additive): the cost-board result.",
      "type": "object",
      "required": [
        "classes",
        "kind",
        "price_model_digest",
        "price_model_id",
        "validators_per_chunk",
        "verifier_vcpus"
      ],
      "properties": {
        "classes": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/CostClass"
          }
        },
        "kind": {
          "$ref": "#/definitions/ScoringKind"
        },
        "price_model_digest": {
          "$ref": "#/definitions/Digest"
        },
        "price_model_id": {
          "type": "string"
        },
        "score_ci_milli": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0.0
        },
        "score_milli": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0.0
        },
        "validators_per_chunk": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        },
        "verifier_vcpus": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        }
      }
    },
    "CoverageReport": {
      "description": "Report field `coverage` (CONTRACTS §11).",
      "type": "object",
      "required": [
        "conformance",
        "tier"
      ],
      "properties": {
        "conformance": {
          "description": "Public fixtures and judge-sampled cases.",
          "allOf": [
            {
              "$ref": "#/definitions/CoverageSection"
            }
          ]
        },
        "heldout": {
          "description": "Committed held-out cases (absent when the worker ran none).",
          "anyOf": [
            {
              "$ref": "#/definitions/CoverageSection"
            },
            {
              "type": "null"
            }
          ]
        },
        "tier": {
          "description": "The declared tier.",
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "CoverageSection": {
      "description": "One case set (conformance or held-out).",
      "type": "object",
      "required": [
        "per_class",
        "share_ppm"
      ],
      "properties": {
        "per_class": {
          "description": "Keyed by workload class id; public fixtures without a class are tallied under [`FIXTURES_KEY`] (not a class: excluded from `share_ppm`).",
          "type": "object",
          "additionalProperties": {
            "$ref": "#/definitions/ClassCoverage"
          }
        },
        "share_ppm": {
          "description": "Weight-averaged proven fraction over the challenge's workload classes, in parts per million (contracts carry no floating point).",
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        }
      },
      "additionalProperties": false
    },
    "Decision": {
      "type": "string",
      "enum": [
        "ADMITTED",
        "REJECTED",
        "INCONCLUSIVE",
        "INFRA_ERROR",
        "CANCELLED"
      ]
    },
    "Digest": {
      "description": "`sha256:<64 lowercase hex>`",
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "EdgeStatus": {
      "oneOf": [
        {
          "description": "Machine-checked evidence (kernel-checked proof, digest equality, ...).",
          "type": "string",
          "enum": [
            "checked"
          ]
        },
        {
          "description": "Approved, visible trusted-base entry.",
          "type": "string",
          "enum": [
            "trusted"
          ]
        },
        {
          "description": "Only tested (differential/fuzz); NOT a substitute for a formal arrow.",
          "type": "string",
          "enum": [
            "tested"
          ]
        },
        {
          "description": "No evidence. Must be rendered.",
          "type": "string",
          "enum": [
            "missing"
          ]
        }
      ]
    },
    "EvidenceEdge": {
      "type": "object",
      "required": [
        "evidence",
        "from",
        "kind",
        "note",
        "status",
        "to"
      ],
      "properties": {
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Digest"
          }
        },
        "from": {
          "type": "string"
        },
        "kind": {
          "description": "e.g. `refines`, `binds`, `assumes`, `built_from`, `tested_against`.",
          "type": "string"
        },
        "note": {
          "type": "string"
        },
        "status": {
          "$ref": "#/definitions/EdgeStatus"
        },
        "to": {
          "type": "string"
        }
      }
    },
    "EvidenceGraph": {
      "type": "object",
      "required": [
        "edges",
        "nodes"
      ],
      "properties": {
        "edges": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/EvidenceEdge"
          }
        },
        "nodes": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/EvidenceNode"
          }
        }
      }
    },
    "EvidenceNode": {
      "type": "object",
      "required": [
        "id",
        "kind",
        "label"
      ],
      "properties": {
        "digest": {
          "anyOf": [
            {
              "$ref": "#/definitions/Digest"
            },
            {
              "type": "null"
            }
          ]
        },
        "id": {
          "type": "string"
        },
        "kind": {
          "$ref": "#/definitions/NodeKind"
        },
        "label": {
          "type": "string"
        }
      }
    },
    "EvidenceRef": {
      "type": "object",
      "required": [
        "digest",
        "label",
        "public"
      ],
      "properties": {
        "digest": {
          "$ref": "#/definitions/Digest"
        },
        "label": {
          "type": "string"
        },
        "public": {
          "description": "Whether this artifact may be shown publicly (held-out data must not).",
          "type": "boolean"
        }
      }
    },
    "GateResult": {
      "type": "object",
      "required": [
        "evidence",
        "gate",
        "mandatory",
        "reason_codes",
        "status",
        "summary"
      ],
      "properties": {
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/EvidenceRef"
          }
        },
        "finished_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "gate": {
          "description": "Gate id; equals the obligation id for obligation gates.",
          "allOf": [
            {
              "$ref": "#/definitions/ObligationId"
            }
          ]
        },
        "mandatory": {
          "type": "boolean"
        },
        "reason_codes": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/ReasonCode"
          }
        },
        "reused_from": {
          "description": "Set when the result was reused from a parent via the content-addressed cache.",
          "type": [
            "string",
            "null"
          ]
        },
        "started_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "status": {
          "$ref": "#/definitions/GateStatus"
        },
        "summary": {
          "description": "Bounded, sanitized, plain text (never HTML).",
          "type": "string"
        }
      }
    },
    "GateStatus": {
      "type": "string",
      "enum": [
        "PASS",
        "FAIL",
        "UNKNOWN",
        "NOT_APPLICABLE"
      ]
    },
    "LogExcerpt": {
      "type": "object",
      "required": [
        "name",
        "stage",
        "text",
        "truncated"
      ],
      "properties": {
        "name": {
          "description": "Log name, e.g. `BUILD` or `BUILD/error`.",
          "type": "string"
        },
        "stage": {
          "description": "Pipeline stage / job kind the log belongs to.",
          "type": "string"
        },
        "text": {
          "type": "string"
        },
        "truncated": {
          "type": "boolean"
        }
      }
    },
    "NodeKind": {
      "type": "string",
      "enum": [
        "nearcore_source",
        "formal_semantics",
        "backend_semantics",
        "theorem",
        "assumption",
        "artifact",
        "tcb_component",
        "test_suite",
        "measurement"
      ]
    },
    "ObligationId": {
      "type": "string",
      "enum": [
        "PKG_WELLFORMED",
        "BUILD_REPRODUCIBLE",
        "ARTIFACT_BINDING",
        "FORMAL_SEMANTIC_SOUNDNESS",
        "FORMAL_SEMANTIC_COMPLETENESS",
        "FORMAL_CRYPTO_SOUNDNESS",
        "FORMAL_IMPL_CONNECTION",
        "FORMAL_ZK",
        "AXIOM_AUDIT",
        "CONFORMANCE_DIFFERENTIAL",
        "ADVERSARIAL_PROOFS",
        "PROVER_RELIABILITY",
        "RESOURCE_LIMITS",
        "BENCHMARK"
      ]
    },
    "ReasonCode": {
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "MANIFEST_INVALID",
            "ARCHIVE_UNSAFE",
            "CHALLENGE_UNKNOWN",
            "PROFILE_NOT_ALLOWED",
            "BUILD_FAILED",
            "BUILD_NOT_REPRODUCIBLE",
            "CERTIFICATE_MISSING",
            "THEOREM_TYPE_MISMATCH",
            "UNAPPROVED_ASSUMPTION",
            "FORBIDDEN_AXIOM",
            "SORRY_FOUND",
            "NATIVE_EVAL_FOUND",
            "SHADOWED_DEFINITION",
            "RECHECK_FAILED",
            "ARTIFACT_BINDING_FAILED",
            "CLAIM_MISMATCH",
            "COUNTEREXAMPLE_FOUND",
            "HOSTILE_PROOF_ACCEPTED",
            "VERIFIER_NONDETERMINISTIC",
            "PROVER_FAILED",
            "RESOURCE_LIMIT",
            "TIMEOUT",
            "SANDBOX_VIOLATION",
            "SECURITY_BOUND_INSUFFICIENT",
            "OBLIGATION_UNDISCHARGED",
            "DEMO_ONLY",
            "INFRA_ERROR",
            "CANCELLED"
          ]
        },
        {
          "description": "v1.7 (coverage-tiered challenges): `prove` answered `UNSUPPORTED` on a positive case of a class its declared tier is complete for.",
          "type": "string",
          "enum": [
            "COVERAGE_GAP_IN_TIER"
          ]
        }
      ]
    },
    "Revocation": {
      "type": "object",
      "required": [
        "reason",
        "revoked_at",
        "revoked_by"
      ],
      "properties": {
        "reason": {
          "type": "string"
        },
        "revoked_at": {
          "type": "string"
        },
