{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "VerifiedSurface",
  "description": "The digests that define the *verified* surface. If all are equal between a child and its parent, formal results may be reused (`ProverOnly`).",
  "type": "object",
  "required": [
    "certificate_decl",
    "challenge_id",
    "checker_image",
    "formal_tree",
    "prepare_artifact",
    "public_artifacts",
    "verify_artifact"
  ],
  "properties": {
    "certificate_decl": {
      "type": "string"
    },
    "challenge_id": {
      "type": "string"
    },
    "checker_image": {
      "$ref": "#/definitions/Digest"
    },
    "declared_tier": {
      "type": [
        "string",
        "null"
      ]
    },
    "formal_tree": {
      "$ref": "#/definitions/Digest"
    },
    "prepare_artifact": {
      "$ref": "#/definitions/Digest"
    },
    "public_artifacts": {
      "$ref": "#/definitions/Digest"
    },
    "verifier_bytecode": {
      "description": "`npai-v1`: SHA-256 digest of the built verifier bytecode image.",
      "anyOf": [
        {
          "$ref": "#/definitions/Digest"
        },
        {
          "type": "null"
        }
      ]
    },
    "verifier_model": {
      "description": "`native-lean`: `[formal] verifier_model`.",
      "type": [
        "string",
        "null"
      ]
    },
    "verifier_model_module": {
      "description": "`native-lean`: `[formal] verifier_model_module`.",
      "type": [
        "string",
        "null"
      ]
    },
    "verify_artifact": {
      "$ref": "#/definitions/Digest"
    },
    "verify_route": {
      "description": "Effective verify route (`native` when the manifest omits it).",
      "anyOf": [
        {
          "$ref": "#/definitions/VerifyRoute"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "definitions": {
    "Digest": {
      "description": "`sha256:<64 lowercase hex>`",
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "VerifyRoute": {
      "type": "string",
      "enum": [
        "native",
        "npai-v1",
        "native-lean"
      ]
    }
  }
}
