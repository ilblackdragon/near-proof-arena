{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "LeaderboardEntry",
  "type": "object",
  "required": [
    "agent",
    "backend_family",
    "candidate_name",
    "hardware_profile",
    "revoked",
    "scope",
    "security_profile",
    "submission_id",
    "submitted_at",
    "tier"
  ],
  "properties": {
    "accepted": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "agent": {
      "type": "string"
    },
    "backend_family": {
      "type": "string"
    },
    "board": {
      "description": "Which board `rank` belongs to: `speed` (default) or `cost_v1` (additive, v1.5).",
      "anyOf": [
        {
          "$ref": "#/definitions/ScoringKind"
        },
        {
          "type": "null"
        }
      ]
    },
    "candidate_name": {
      "type": "string"
    },
    "challenge_id": {
      "description": "The challenge this result was measured under (additive, v1.4). A result is never re-labelled or moved to another challenge's board.",
      "default": "",
      "type": "string"
    },
    "cost": {
      "description": "Per-class cost components, so the board shows why (v1.5).",
      "anyOf": [
        {
          "$ref": "#/definitions/CostResult"
        },
        {
          "type": "null"
        }
      ]
    },
    "cost_score_ci_milli": {
      "type": [
        "integer",
        "null"
      ],
      "format": "uint64",
      "minimum": 0.0
    },
    "cost_score_milli": {
      "description": "Cost-board score and its CI (cost_v1 challenges only; v1.5).",
      "type": [
        "integer",
        "null"
      ],
      "format": "uint64",
      "minimum": 0.0
    },
    "coverage_share_ppm": {
      "description": "`coverage.conformance.share_ppm` of the ranked run.",
      "type": [
        "integer",
        "null"
      ],
      "format": "uint32",
      "minimum": 0.0
    },
    "decision": {
      "anyOf": [
        {
          "$ref": "#/definitions/Decision"
        },
        {
          "type": "null"
        }
      ]
    },
    "declared_tier": {
      "description": "Declared coverage tier; the board orders by its rank first.",
      "type": [
        "string",
        "null"
      ]
    },
    "hardware_profile": {
      "type": "string"
    },
    "peak_rss_bytes": {
      "type": [
        "integer",
        "null"
      ],
      "format": "uint64",
      "minimum": 0.0
    },
    "proof_bytes": {
      "type": [
        "integer",
        "null"
      ],
      "format": "uint64",
      "minimum": 0.0
    },
    "protocol_version": {
      "description": "That challenge's NEAR protocol version (additive, v1.4).",
      "default": 0,
      "type": "integer",
      "format": "uint32",
      "minimum": 0.0
    },
    "prove_median_ns": {
      "type": [
        "integer",
        "null"
      ],
      "format": "uint64",
      "minimum": 0.0
    },
    "rank": {
      "type": [
        "integer",
        "null"
      ],
      "format": "uint32",
      "minimum": 0.0
    },
    "revoked": {
      "type": "boolean"
    },
    "scope": {
      "type": "string"
    },
    "score_ci_milli": {
      "description": "Half-width of the score's 95% interval, milli units (additive, v1.1).",
      "default": null,
      "type": [
        "integer",
        "null"
      ],
      "format": "uint64",
      "minimum": 0.0
    },
    "score_milli": {
      "type": [
        "integer",
        "null"
      ],
      "format": "uint64",
      "minimum": 0.0
    },
    "security_profile": {
      "type": "string"
    },
    "submission_id": {
      "type": "string"
    },
    "submitted_at": {
      "type": "string"
    },
    "superseded_by": {
      "description": "Set when the challenge has been superseded: the board is historical (frozen, closed for new submissions) and scores are not comparable with the successor's (additive, v1.4).",
      "default": null,
      "type": [
        "string",
        "null"
      ]
    },
    "tier": {
      "$ref": "#/definitions/Tier"
    },
    "tier_rank": {
      "type": [
        "integer",
        "null"
      ],
      "format": "uint32",
      "minimum": 0.0
    },
    "verify_median_ns": {
      "type": [
        "integer",
        "null"
      ],
      "format": "uint64",
      "minimum": 0.0
    }
  },
  "definitions": {
    "CostClass": {
      "description": "Cost components of one class (component medians, integer femto-USD per batch run). `*_fusd` validator terms already include the `N_v` factor.",
      "type": "object",
      "required": [
        "bandwidth_fusd",
        "baseline_total_fusd",
        "class_id",
        "prepare_fusd",
        "proof_bytes",
        "prove_fusd",
        "prove_ns",
        "storage_fusd",
        "total_fusd",
        "verify_fusd",
        "verify_ns",
        "weight_ppm"
      ],
      "properties": {
        "bandwidth_fusd": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        },
        "baseline_total_fusd": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        },
        "class_id": {
          "type": "string"
        },
        "prepare_fusd": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        },
        "proof_bytes": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        },
        "prove_fusd": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        },
        "prove_ns": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        },
        "storage_fusd": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        },
        "total_fusd": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        },
        "verify_fusd": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        },
        "verify_ns": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        },
        "weight_ppm": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        }
      }
    },
    "CostResult": {
      "description": "`BenchmarkResult.cost` (v1.5, additive): the cost-board result.",
      "type": "object",
      "required": [
        "classes",
        "kind",
        "price_model_digest",
        "price_model_id",
        "validators_per_chunk",
        "verifier_vcpus"
      ],
      "properties": {
        "classes": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/CostClass"
          }
        },
        "kind": {
          "$ref": "#/definitions/ScoringKind"
        },
        "price_model_digest": {
          "$ref": "#/definitions/Digest"
        },
        "price_model_id": {
          "type": "string"
        },
        "score_ci_milli": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0.0
        },
        "score_milli": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0.0
        },
        "validators_per_chunk": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        },
        "verifier_vcpus": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        }
      }
    },
    "Decision": {
      "type": "string",
      "enum": [
        "ADMITTED",
        "REJECTED",
        "INCONCLUSIVE",
        "INFRA_ERROR",
        "CANCELLED"
      ]
    },
    "Digest": {
      "description": "`sha256:<64 lowercase hex>`",
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "ScoringKind": {
      "oneOf": [
        {
          "description": "bench-spec-v1 §8: weighted geometric mean of prove-time speedups.",
          "type": "string",
          "enum": [
            "speed"
          ]
        },
        {
          "description": "bench-spec §14: weighted geometric mean of per-class system-cost ratios under a pinned [`PriceModel`].",
          "type": "string",
          "enum": [
            "cost_v1"
          ]
        }
      ]
    },
    "Tier": {
      "oneOf": [
        {
          "description": "Official ranked board; all formal obligations mandatory.",
          "type": "string",
          "enum": [
            "formal"
          ]
        },
        {
          "description": "Tests + diagnostic timings only; never ranked as formal.",
          "type": "string",
          "enum": [
            "experimental"
          ]
        },
        {
          "description": "Plumbing demonstration; simulated components allowed, always labelled DEMO.",
          "type": "string",
          "enum": [
            "demo"
          ]
        }
      ]
    }
  }
}
