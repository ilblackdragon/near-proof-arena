;; kgashost: calls the three gas-key promise host functions (keys scenario only, src/keys.rs).
;; Every method builds one promise batch; input layout per method:
;;   `addfull`: borsh public key      -> self batch, add_gas_key_with_full_access(pk, 2 nonces)
;;   `addfc`:   borsh public key      -> self batch, add_gas_key_with_function_call(pk, 3 nonces,
;;                                       allowance 0.001 NEAR, receiver = self, methods "run,cb")
;;   `fund`:    borsh public key      -> self batch, transfer_to_gas_key(pk, 1 NEAR)
;;   `addfund`: borsh public key      -> self batch, add_gas_key_with_full_access + transfer_to_gas_key
;;   `fundto`:  u8 len ‖ account ‖ pk -> batch on `account`, transfer_to_gas_key(pk, 1 NEAR)
;; A malformed key fails inside the host (after the base and action fees are charged).
(module
  (import "env" "input" (func $input (param i64)))
  (import "env" "register_len" (func $register_len (param i64) (result i64)))
  (import "env" "read_register" (func $read_register (param i64 i64)))
  (import "env" "current_account_id" (func $current_account_id (param i64)))
  (import "env" "promise_batch_create" (func $promise_batch_create (param i64 i64) (result i64)))
  (import "env" "promise_batch_action_add_gas_key_with_full_access" (func $add_full (param i64 i64 i64 i64)))
  (import "env" "promise_batch_action_add_gas_key_with_function_call"
    (func $add_fc (param i64 i64 i64 i64 i64 i64 i64 i64 i64)))
  (import "env" "promise_batch_action_transfer_to_gas_key" (func $fund (param i64 i64 i64 i64)))
  (memory 1)
  ;; 16: 1 NEAR (u128 LE); 48: allowance 10^21 (u128 LE); 64: "run,cb"; 300..: own account id;
  ;; 1024..: input
  (data (i32.const 16) "\00\00\00\a1\ed\cc\ce\1b\c2\d3\00\00\00\00\00\00")
  (data (i32.const 48) "\00\00\a0\de\c5\ad\c9\35\36\00\00\00\00\00\00\00")
  (data (i32.const 64) "run,cb")
  (global $self_len (mut i64) (i64.const 0))
  (func $read_input (result i64) (local $n i64)
    (call $input (i64.const 0))
    (local.set $n (call $register_len (i64.const 0)))
    (if (i64.gt_u (local.get $n) (i64.const 8192)) (then (local.set $n (i64.const 8192))))
    (call $read_register (i64.const 0) (i64.const 1024))
    (local.get $n))
  (func $self_batch (result i64)
    (call $current_account_id (i64.const 1))
    (call $read_register (i64.const 1) (i64.const 300))
    (global.set $self_len (call $register_len (i64.const 1)))
    (call $promise_batch_create (global.get $self_len) (i64.const 300)))
  (func $addfull (local $n i64)
    (local.set $n (call $read_input))
    (call $add_full (call $self_batch) (local.get $n) (i64.const 1024) (i64.const 2)))
  (func $addfc (local $n i64) (local $p i64)
    (local.set $n (call $read_input))
    (local.set $p (call $self_batch))
    (call $add_fc (local.get $p) (local.get $n) (i64.const 1024) (i64.const 3) (i64.const 48)
      (global.get $self_len) (i64.const 300) (i64.const 6) (i64.const 64)))
  (func $fundself (local $n i64)
    (local.set $n (call $read_input))
    (call $fund (call $self_batch) (local.get $n) (i64.const 1024) (i64.const 16)))
  (func $addfund (local $n i64) (local $p i64)
    (local.set $n (call $read_input))
    (local.set $p (call $self_batch))
    (call $add_full (local.get $p) (local.get $n) (i64.const 1024) (i64.const 2))
    (call $fund (local.get $p) (local.get $n) (i64.const 1024) (i64.const 16)))
  (func $fundto (local $n i64) (local $l i64) (local $p i64)
    (local.set $n (call $read_input))
    (local.set $l (i64.extend_i32_u (i32.load8_u (i32.const 1024))))
    (local.set $p (call $promise_batch_create (local.get $l) (i64.const 1025)))
    (call $fund (local.get $p) (i64.sub (i64.sub (local.get $n) (i64.const 1)) (local.get $l))
      (i64.add (i64.const 1025) (local.get $l)) (i64.const 16)))
  (export "addfull" (func $addfull))
  (export "addfc" (func $addfc))
  (export "fund" (func $fundself))
  (export "addfund" (func $addfund))
  (export "fundto" (func $fundto)))
