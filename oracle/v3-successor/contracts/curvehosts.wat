;; curvehosts: one FunctionCall method per curve host and input source, for whole-chunk curve
;; fixtures (`NEAR_SUCCESSOR_SCENARIO=curve-hosts`, src/curve_hosts.rs). Every method calls its
;; host unconditionally and then `$finish`es: the host's u64 result (0 for the two `()` alt_bn128
;; writers) followed by register 1 (if the host wrote it) is returned with `value_return` and
;; written to storage key "o", so outputs reach both the outcome and the state root.
;;
;; Method families (the call's args are the host's raw input unless stated otherwise):
;;   <host>       memory input: args are copied to IN (1024) and passed as (len, IN)
;;   <host>_reg   register input: args stay in register 0, passed as (u64::MAX, 0)
;;   <host>_oob   out-of-bounds memory input: (64, 0x7fffffff), a MemoryAccessViolation
;;   p256_verify  args = [sig_len u8][pk_len u8][sig][pk][msg]
;;   ecrecover    args = [v u8][flag u8][sig_len u8][hash_len u8][sig][hash]
(module
  (import "env" "input" (func $input (param i64)))
  (import "env" "register_len" (func $register_len (param i64) (result i64)))
  (import "env" "read_register" (func $read_register (param i64 i64)))
  (import "env" "value_return" (func $value_return (param i64 i64)))
  (import "env" "storage_write" (func $storage_write (param i64 i64 i64 i64 i64) (result i64)))
  (import "env" "alt_bn128_g1_multiexp" (func $bn_multiexp (param i64 i64 i64)))
  (import "env" "alt_bn128_g1_sum" (func $bn_sum (param i64 i64 i64)))
  (import "env" "alt_bn128_pairing_check" (func $bn_pairing (param i64 i64) (result i64)))
  (import "env" "bls12381_p1_sum" (func $p1_sum (param i64 i64 i64) (result i64)))
  (import "env" "bls12381_p2_sum" (func $p2_sum (param i64 i64 i64) (result i64)))
  (import "env" "bls12381_g1_multiexp" (func $g1_multiexp (param i64 i64 i64) (result i64)))
  (import "env" "bls12381_g2_multiexp" (func $g2_multiexp (param i64 i64 i64) (result i64)))
  (import "env" "bls12381_map_fp_to_g1" (func $map_fp (param i64 i64 i64) (result i64)))
  (import "env" "bls12381_map_fp2_to_g2" (func $map_fp2 (param i64 i64 i64) (result i64)))
  (import "env" "bls12381_pairing_check" (func $bls_pairing (param i64 i64) (result i64)))
  (import "env" "bls12381_p1_decompress" (func $p1_dec (param i64 i64 i64) (result i64)))
  (import "env" "bls12381_p2_decompress" (func $p2_dec (param i64 i64 i64) (result i64)))
  (import "env" "p256_verify" (func $p256 (param i64 i64 i64 i64 i64 i64) (result i64)))
  (import "env" "ecrecover" (func $ecrecover (param i64 i64 i64 i64 i64 i64 i64) (result i64)))
  (memory 2)
  (data (i32.const 0) "o")

  ;; args -> memory at IN = 1024; returns their length
  (func $load (result i64)
    (call $input (i64.const 0))
    (call $read_register (i64.const 0) (i64.const 1024))
    (call $register_len (i64.const 0)))

  ;; OUT = 32768: [result u64 LE][register 1, if set]
  (func $finish (param $r i64)
    (local $n i64)
    (i64.store (i32.const 32768) (local.get $r))
    (local.set $n (call $register_len (i64.const 1)))
    (if (i64.eq (local.get $n) (i64.const -1))
      (then (local.set $n (i64.const 0)))
      (else (call $read_register (i64.const 1) (i64.const 32776))))
    (call $value_return (i64.add (local.get $n) (i64.const 8)) (i64.const 32768))
    (drop (call $storage_write (i64.const 1) (i64.const 0)
      (i64.add (local.get $n) (i64.const 8)) (i64.const 32768) (i64.const 2))))

  ;; ---- alt_bn128
  (func (export "alt_bn128_g1_multiexp")
    (call $bn_multiexp (call $load) (i64.const 1024) (i64.const 1)) (call $finish (i64.const 0)))
  (func (export "alt_bn128_g1_multiexp_reg")
    (call $input (i64.const 0))
    (call $bn_multiexp (i64.const -1) (i64.const 0) (i64.const 1)) (call $finish (i64.const 0)))
  (func (export "alt_bn128_g1_multiexp_oob")
    (call $bn_multiexp (i64.const 64) (i64.const 0x7fffffff) (i64.const 1)) (call $finish (i64.const 0)))
  (func (export "alt_bn128_g1_sum")
    (call $bn_sum (call $load) (i64.const 1024) (i64.const 1)) (call $finish (i64.const 0)))
  (func (export "alt_bn128_g1_sum_reg")
    (call $input (i64.const 0))
    (call $bn_sum (i64.const -1) (i64.const 0) (i64.const 1)) (call $finish (i64.const 0)))
  (func (export "alt_bn128_pairing_check")
    (call $finish (call $bn_pairing (call $load) (i64.const 1024))))
  (func (export "alt_bn128_pairing_check_reg")
    (call $input (i64.const 0))
    (call $finish (call $bn_pairing (i64.const -1) (i64.const 0))))
  (func (export "alt_bn128_pairing_check_oob")
    (call $finish (call $bn_pairing (i64.const 64) (i64.const 0x7fffffff))))

  ;; ---- BLS12-381 writers (bls12381_impl!)
  (func (export "bls12381_p1_sum")
    (call $finish (call $p1_sum (call $load) (i64.const 1024) (i64.const 1))))
  (func (export "bls12381_p1_sum_reg")
    (call $input (i64.const 0))
    (call $finish (call $p1_sum (i64.const -1) (i64.const 0) (i64.const 1))))
  (func (export "bls12381_p1_sum_oob")
    (call $finish (call $p1_sum (i64.const 64) (i64.const 0x7fffffff) (i64.const 1))))
  (func (export "bls12381_p2_sum")
    (call $finish (call $p2_sum (call $load) (i64.const 1024) (i64.const 1))))
  (func (export "bls12381_g1_multiexp")
    (call $finish (call $g1_multiexp (call $load) (i64.const 1024) (i64.const 1))))
  (func (export "bls12381_g2_multiexp")
    (call $finish (call $g2_multiexp (call $load) (i64.const 1024) (i64.const 1))))
  (func (export "bls12381_map_fp_to_g1")
    (call $finish (call $map_fp (call $load) (i64.const 1024) (i64.const 1))))
  (func (export "bls12381_map_fp2_to_g2")
    (call $finish (call $map_fp2 (call $load) (i64.const 1024) (i64.const 1))))
  (func (export "bls12381_p1_decompress")
    (call $finish (call $p1_dec (call $load) (i64.const 1024) (i64.const 1))))
  (func (export "bls12381_p2_decompress")
    (call $finish (call $p2_dec (call $load) (i64.const 1024) (i64.const 1))))

  ;; ---- BLS12-381 pairing (own body: read before the per-element charge)
  (func (export "bls12381_pairing_check")
    (call $finish (call $bls_pairing (call $load) (i64.const 1024))))
  (func (export "bls12381_pairing_check_reg")
    (call $input (i64.const 0))
    (call $finish (call $bls_pairing (i64.const -1) (i64.const 0))))
  (func (export "bls12381_pairing_check_oob")
    (call $finish (call $bls_pairing (i64.const 64) (i64.const 0x7fffffff))))

  ;; ---- p256_verify(sig_len, sig_ptr, msg_len, msg_ptr, pk_len, pk_ptr)
  (func (export "p256_verify")
    (local $n i64) (local $sl i64) (local $pl i64)
    (local.set $n (call $load))
    (local.set $sl (i64.load8_u (i32.const 1024)))
    (local.set $pl (i64.load8_u (i32.const 1025)))
    (call $finish (call $p256
      (local.get $sl) (i64.const 1026)
      (i64.sub (i64.sub (i64.sub (local.get $n) (i64.const 2)) (local.get $sl)) (local.get $pl))
      (i64.add (i64.const 1026) (i64.add (local.get $sl) (local.get $pl)))
      (local.get $pl) (i64.add (i64.const 1026) (local.get $sl)))))

  ;; ---- ecrecover(hash_len, hash_ptr, sig_len, sig_ptr, v, malleability_flag, register_id)
  (func (export "ecrecover")
    (local $sl i64) (local $hl i64)
    (drop (call $load))
    (local.set $sl (i64.load8_u (i32.const 1026)))
    (local.set $hl (i64.load8_u (i32.const 1027)))
    (call $finish (call $ecrecover
      (local.get $hl) (i64.add (i64.const 1028) (local.get $sl))
      (local.get $sl) (i64.const 1028)
      (i64.load8_u (i32.const 1024)) (i64.load8_u (i32.const 1025)) (i64.const 1)))))
