;; d3rich: the D3 oracle's input-driven contract (integer-only, no curve host functions; InD3α).
;; Methods `run` and `cb` both interpret their input as a program of byte-coded operations
;; (callbacks receive their program as promise arguments). `bad_sig` has the wrong signature
;; (MethodInvalidSignature); `noop` does nothing. Encodings: b = u8, w = u16 LE, s = b-length
;; byte string, S = w-length byte string, d = deposit index into
;; [0, 1, 10^18, 10^21, 10^24] (mod 5), g = gas in Tgas, pk = 33-byte borsh ED25519 key,
;; slot = index into the promise stack of this call (an out-of-range slot passes an invalid
;; promise index: a host error).
;;   01 s:key w:len b:fill   storage_write(key, len × fill)        02 s:key  storage_read
;;   03 s:key                storage_has_key                       04 s:key  storage_remove
;;   05 s                    log_utf8                              06 s      log_utf16
;;   07 s                    value_return
;;   08 s:acct s:meth S:args d g        promise_create → push
;;   09 slot s:acct s:meth S:args d g   promise_then   → push
;;   0a b:n n×slot           promise_and → push
;;   0b s:acct               promise_batch_create → push    0c slot s:acct  promise_batch_then → push
;;   0d slot s:meth S:args d g          batch FunctionCall
;;   0e slot d               batch Transfer                 0f slot   batch CreateAccount
;;   10 slot pk              batch AddKey(full access)      11 slot   batch DeployContract(d3tiny)
;;   12 slot pk              batch DeleteKey                13 slot d pk  batch Stake
;;   14 slot pk d:allowance s:receiver s:methods   batch AddKey(function call)
;;   15 slot s:beneficiary   batch DeleteAccount            16 slot   promise_return
;;   17                      promise_results_count + promise_result(i): log_utf8 of '0'+status
;;   18                      value_return(promise result 0) if it succeeded
;;   19 b:sub [s:acct]       getter sub → storage_write("g"‖sub, value):
;;        0 account_balance 1 account_locked_balance 2 attached_deposit 3 storage_usage
;;        4 block_index 5 block_timestamp 6 epoch_height 7 prepaid_gas 8 used_gas
;;        9 current_account_id 10 signer_account_id 11 signer_account_pk
;;        12 predecessor_account_id 13 random_seed 14 chain_id 15 validator_total_stake
;;        16 validator_stake(acct) 17 input
;;   1a b:sub s:data         sha256 / keccak256 / keccak512 / ripemd160 (sub mod 4)
;;                           → storage_write("h"‖sub, digest)
;;   1b panic   1c s panic_utf8   1d abort   1e w:n burn n·256 loop iterations
;;   1f unreachable   20 out-of-bounds load   21 integer divide by zero
;;   22 b:sub [s]            registers: 0 write_register(8, s) + read_register,
;;                           1 read_register(99) (invalid register), 2 register_len(99)
;;   23 slot s:meth S:args d g b:weight  batch FunctionCall with gas weight
;;   24 s:meth S:args g b:weight         promise_yield_create → storage_write("y", data id)
;;   25 s:payload            promise_yield_resume(storage_read("y"), payload)
;;                           → storage_write("r", result)
;;   26 b:n                  memory.grow(n)
;;   27 b:n                  n × storage_write("L"‖i, i)
;;   28 b:n                  recursion of depth 64·n
;; Any other opcode (or the end of the input) stops.
;; Memory: input at 0 (≤ 16 KiB), amounts at 20100, promise stack at 20016, promise_and
;; indices at 21000, status buffer at 22000, getter scratch 24000/24100, keys 25000,
;; fill buffer 32768 (≤ 64 KiB), abort strings 26000, d3tiny code at 98304.
(module
  (import "env" "input" (func $input (param i64)))
  (import "env" "register_len" (func $register_len (param i64) (result i64)))
  (import "env" "read_register" (func $read_register (param i64 i64)))
  (import "env" "write_register" (func $write_register (param i64 i64 i64)))
  (import "env" "storage_write" (func $storage_write (param i64 i64 i64 i64 i64) (result i64)))
  (import "env" "storage_read" (func $storage_read (param i64 i64 i64) (result i64)))
  (import "env" "storage_has_key" (func $storage_has_key (param i64 i64) (result i64)))
  (import "env" "storage_remove" (func $storage_remove (param i64 i64 i64) (result i64)))
  (import "env" "log_utf8" (func $log_utf8 (param i64 i64)))
  (import "env" "log_utf16" (func $log_utf16 (param i64 i64)))
  (import "env" "value_return" (func $value_return (param i64 i64)))
  (import "env" "panic" (func $panic))
  (import "env" "panic_utf8" (func $panic_utf8 (param i64 i64)))
  (import "env" "abort" (func $abort (param i32 i32 i32 i32)))
  (import "env" "promise_create" (func $promise_create (param i64 i64 i64 i64 i64 i64 i64 i64) (result i64)))
  (import "env" "promise_then" (func $promise_then (param i64 i64 i64 i64 i64 i64 i64 i64 i64) (result i64)))
  (import "env" "promise_and" (func $promise_and (param i64 i64) (result i64)))
  (import "env" "promise_batch_create" (func $pb_create (param i64 i64) (result i64)))
  (import "env" "promise_batch_then" (func $pb_then (param i64 i64 i64) (result i64)))
  (import "env" "promise_batch_action_function_call" (func $pba_fc (param i64 i64 i64 i64 i64 i64 i64)))
  (import "env" "promise_batch_action_function_call_weight" (func $pba_fcw (param i64 i64 i64 i64 i64 i64 i64 i64)))
  (import "env" "promise_batch_action_transfer" (func $pba_transfer (param i64 i64)))
  (import "env" "promise_batch_action_create_account" (func $pba_create (param i64)))
  (import "env" "promise_batch_action_add_key_with_full_access" (func $pba_akf (param i64 i64 i64 i64)))
  (import "env" "promise_batch_action_add_key_with_function_call" (func $pba_akfc (param i64 i64 i64 i64 i64 i64 i64 i64 i64)))
  (import "env" "promise_batch_action_deploy_contract" (func $pba_deploy (param i64 i64 i64)))
  (import "env" "promise_batch_action_delete_key" (func $pba_dk (param i64 i64 i64)))
  (import "env" "promise_batch_action_stake" (func $pba_stake (param i64 i64 i64 i64)))
  (import "env" "promise_batch_action_delete_account" (func $pba_da (param i64 i64 i64)))
  (import "env" "promise_return" (func $promise_return (param i64)))
  (import "env" "promise_results_count" (func $promise_results_count (result i64)))
  (import "env" "promise_result" (func $promise_result (param i64 i64) (result i64)))
  (import "env" "promise_yield_create" (func $yield_create (param i64 i64 i64 i64 i64 i64 i64) (result i64)))
  (import "env" "promise_yield_resume" (func $yield_resume (param i64 i64 i64 i64) (result i32)))
  (import "env" "account_balance" (func $account_balance (param i64)))
  (import "env" "account_locked_balance" (func $account_locked_balance (param i64)))
  (import "env" "attached_deposit" (func $attached_deposit (param i64)))
  (import "env" "storage_usage" (func $storage_usage (result i64)))
  (import "env" "block_index" (func $block_index (result i64)))
  (import "env" "block_timestamp" (func $block_timestamp (result i64)))
  (import "env" "epoch_height" (func $epoch_height (result i64)))
  (import "env" "prepaid_gas" (func $prepaid_gas (result i64)))
  (import "env" "used_gas" (func $used_gas (result i64)))
  (import "env" "current_account_id" (func $current_account_id (param i64)))
  (import "env" "signer_account_id" (func $signer_account_id (param i64)))
  (import "env" "signer_account_pk" (func $signer_account_pk (param i64)))
  (import "env" "predecessor_account_id" (func $predecessor_account_id (param i64)))
  (import "env" "random_seed" (func $random_seed (param i64)))
  (import "env" "chain_id" (func $chain_id (param i64)))
  (import "env" "validator_total_stake" (func $validator_total_stake (param i64)))
  (import "env" "validator_stake" (func $validator_stake (param i64 i64 i64)))
  (import "env" "sha256" (func $sha256 (param i64 i64 i64)))
  (import "env" "keccak256" (func $keccak256 (param i64 i64 i64)))
  (import "env" "keccak512" (func $keccak512 (param i64 i64 i64)))
  (import "env" "ripemd160" (func $ripemd160 (param i64 i64 i64)))
  (memory 3)
  (global $pc (mut i32) (i32.const 0))
  (global $end (mut i32) (i32.const 0))
  (global $np (mut i32) (i32.const 0))
  ;; last string read: pointer / length (two string slots: A and B)
  (global $ap (mut i32) (i32.const 0))
  (global $al (mut i32) (i32.const 0))
  (global $bp (mut i32) (i32.const 0))
  (global $bl (mut i32) (i32.const 0))
  (global $cp (mut i32) (i32.const 0))
  (global $cl (mut i32) (i32.const 0))
  ;; deposit table [0, 1, 1e18, 1e21, 1e24] (u128 LE)
  (data (i32.const 20100)
    "\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00"
    "\01\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00"
    "\00\00\64\a7\b3\b6\e0\0d\00\00\00\00\00\00\00\00"
    "\00\00\a0\de\c5\ad\c9\35\36\00\00\00\00\00\00\00"
    "\00\00\00\a1\ed\cc\ce\1b\c2\d3\00\00\00\00\00\00")
  ;; AssemblyScript-style strings for abort: u32 byte length, then UTF-16 "d3"
  (data (i32.const 26000) "\04\00\00\00d\003\00")
  ;; d3tiny.wasm (345 bytes)
  (data (i32.const 98304) "\00\61\73\6d\01\00\00\00\01\1b\05\60\01\7e\00\60\01\7e\01\7e\60\02\7e\7e\00\60\05\7e\7e\7e\7e\7e\01\7e\60\00\00\02\6a\06\03\65\6e\76\05\69\6e\70\75\74\00\00\03\65\6e\76\0c\72\65\67\69\73\74\65\72\5f\6c\65\6e\00\01\03\65\6e\76\0d\72\65\61\64\5f\72\65\67\69\73\74\65\72\00\02\03\65\6e\76\0d\73\74\6f\72\61\67\65\5f\77\72\69\74\65\00\03\03\65\6e\76\08\6c\6f\67\5f\75\74\66\38\00\02\03\65\6e\76\0c\76\61\6c\75\65\5f\72\65\74\75\72\6e\00\02\03\02\01\04\05\03\01\00\01\07\0c\02\03\72\75\6e\00\06\02\63\62\00\06\0a\3f\01\3d\01\01\7e\42\00\10\00\42\00\10\01\21\00\20\00\42\e0\d4\03\56\04\40\42\e0\d4\03\21\00\0b\42\00\42\10\10\02\42\01\42\00\20\00\42\10\42\01\10\03\1a\42\04\42\01\10\04\20\00\42\10\10\05\0b\0b\0b\01\00\41\00\0b\05\74\74\69\6e\79\00\61\04\6e\61\6d\65\01\52\07\00\05\69\6e\70\75\74\01\0c\72\65\67\69\73\74\65\72\5f\6c\65\6e\02\0d\72\65\61\64\5f\72\65\67\69\73\74\65\72\03\0d\73\74\6f\72\61\67\65\5f\77\72\69\74\65\04\08\6c\6f\67\5f\75\74\66\38\05\0c\76\61\6c\75\65\5f\72\65\74\75\72\6e\06\04\6d\61\69\6e\02\06\01\06\01\00\01\6e")

  (func $b (result i32) (local $v i32)
    (if (i32.ge_u (global.get $pc) (global.get $end)) (then (return (i32.const 0))))
    (local.set $v (i32.load8_u (global.get $pc)))
    (global.set $pc (i32.add (global.get $pc) (i32.const 1)))
    (local.get $v))
  (func $w (result i32)
    (i32.or (call $b) (i32.shl (call $b) (i32.const 8))))
  ;; clamp a string [pc, pc+len) to the input end
  (func $clamp (param $len i32) (result i32)
    (if (i32.gt_u (i32.add (global.get $pc) (local.get $len)) (global.get $end))
      (then (return (i32.sub (global.get $end) (global.get $pc)))))
    (local.get $len))
  (func $sa (local $l i32)
    (local.set $l (call $clamp (call $b)))
    (global.set $ap (global.get $pc)) (global.set $al (local.get $l))
    (global.set $pc (i32.add (global.get $pc) (local.get $l))))
  (func $sb (local $l i32)
    (local.set $l (call $clamp (call $b)))
    (global.set $bp (global.get $pc)) (global.set $bl (local.get $l))
    (global.set $pc (i32.add (global.get $pc) (local.get $l))))
  (func $SC (local $l i32)
    (local.set $l (call $clamp (call $w)))
    (global.set $cp (global.get $pc)) (global.set $cl (local.get $l))
    (global.set $pc (i32.add (global.get $pc) (local.get $l))))
  ;; a 33-byte public key: returns its pointer (fewer bytes left: the rest of the input)
  (func $pk (result i64) (local $p i32)
    (local.set $p (global.get $pc))
    (global.set $pc (i32.add (global.get $pc) (call $clamp (i32.const 33))))
    (i64.extend_i32_u (local.get $p)))
  (func $dep (result i64)
    (i64.extend_i32_u (i32.add (i32.const 20100) (i32.mul (i32.rem_u (call $b) (i32.const 5)) (i32.const 16)))))
  (func $gas (result i64)
    (i64.mul (i64.extend_i32_u (call $b)) (i64.const 1000000000000)))
  (func $push (param $v i64)
    (if (i32.lt_u (global.get $np) (i32.const 64))
      (then
        (i64.store (i32.add (i32.const 20016) (i32.shl (global.get $np) (i32.const 3))) (local.get $v))
        (global.set $np (i32.add (global.get $np) (i32.const 1))))))
  (func $slot (result i64) (local $s i32)
    (local.set $s (call $b))
    (if (i32.lt_u (local.get $s) (global.get $np))
      (then (return (i64.load (i32.add (i32.const 20016) (i32.shl (local.get $s) (i32.const 3)))))))
    (i64.add (i64.extend_i32_u (local.get $s)) (i64.const 1000)))
  (func $p64 (param $x i32) (result i64) (i64.extend_i32_u (local.get $x)))
  ;; storage_write(tag ‖ sub, len bytes at ptr)
  (func $put (param $tag i32) (param $sub i32) (param $len i64) (param $ptr i64)
    (i32.store8 (i32.const 25000) (local.get $tag))
    (i32.store8 (i32.const 25001) (local.get $sub))
    (drop (call $storage_write (i64.const 2) (i64.const 25000) (local.get $len) (local.get $ptr) (i64.const 5))))
  ;; register r → 24100, returns its length (≤ 1024)
  (func $reg (param $r i64) (result i64) (local $l i64)
    (local.set $l (call $register_len (local.get $r)))
    (if (i64.gt_u (local.get $l) (i64.const 1024)) (then (return (i64.const 0))))
    (call $read_register (local.get $r) (i64.const 24100))
    (local.get $l))
  (func $rec (param $n i32) (result i32)
    (if (result i32) (i32.eqz (local.get $n))
      (then (i32.const 0))
      (else (i32.add (i32.const 1) (call $rec (i32.sub (local.get $n) (i32.const 1)))))))

  (func $getter (local $sub i32) (local $l i64)
    (local.set $sub (call $b))
    (block $done
      (if (i32.eq (local.get $sub) (i32.const 0)) (then (call $account_balance (i64.const 24000)) (local.set $l (i64.const 16)) (br $done)))
      (if (i32.eq (local.get $sub) (i32.const 1)) (then (call $account_locked_balance (i64.const 24000)) (local.set $l (i64.const 16)) (br $done)))
      (if (i32.eq (local.get $sub) (i32.const 2)) (then (call $attached_deposit (i64.const 24000)) (local.set $l (i64.const 16)) (br $done)))
      (local.set $l (i64.const 8))
      (if (i32.eq (local.get $sub) (i32.const 3)) (then (i64.store (i32.const 24000) (call $storage_usage)) (br $done)))
      (if (i32.eq (local.get $sub) (i32.const 4)) (then (i64.store (i32.const 24000) (call $block_index)) (br $done)))
      (if (i32.eq (local.get $sub) (i32.const 5)) (then (i64.store (i32.const 24000) (call $block_timestamp)) (br $done)))
      (if (i32.eq (local.get $sub) (i32.const 6)) (then (i64.store (i32.const 24000) (call $epoch_height)) (br $done)))
      (if (i32.eq (local.get $sub) (i32.const 7)) (then (i64.store (i32.const 24000) (call $prepaid_gas)) (br $done)))
      (if (i32.eq (local.get $sub) (i32.const 8)) (then (i64.store (i32.const 24000) (call $used_gas)) (br $done)))
      (local.set $l (i64.const 16))
      (if (i32.eq (local.get $sub) (i32.const 15)) (then (call $validator_total_stake (i64.const 24000)) (br $done)))
      (if (i32.eq (local.get $sub) (i32.const 16))
        (then (call $sa)
              (call $validator_stake (call $p64 (global.get $al)) (call $p64 (global.get $ap)) (i64.const 24000)) (br $done)))
      ;; register getters (register 6) → 24100
      (block $r
        (if (i32.eq (local.get $sub) (i32.const 9)) (then (call $current_account_id (i64.const 6)) (br $r)))
        (if (i32.eq (local.get $sub) (i32.const 10)) (then (call $signer_account_id (i64.const 6)) (br $r)))
        (if (i32.eq (local.get $sub) (i32.const 11)) (then (call $signer_account_pk (i64.const 6)) (br $r)))
        (if (i32.eq (local.get $sub) (i32.const 12)) (then (call $predecessor_account_id (i64.const 6)) (br $r)))
        (if (i32.eq (local.get $sub) (i32.const 13)) (then (call $random_seed (i64.const 6)) (br $r)))
        (if (i32.eq (local.get $sub) (i32.const 14)) (then (call $chain_id (i64.const 6)) (br $r)))
        (if (i32.eq (local.get $sub) (i32.const 17)) (then (call $input (i64.const 6)) (br $r)))
        (return))
      (local.set $l (call $reg (i64.const 6)))
      (call $put (i32.const 103) (local.get $sub) (local.get $l) (i64.const 24100))
      (return))
    (call $put (i32.const 103) (local.get $sub) (local.get $l) (i64.const 24000)))

  (func $hash (local $sub i32)
    (local.set $sub (i32.and (call $b) (i32.const 3)))
    (call $sa)
    (if (i32.eq (local.get $sub) (i32.const 0)) (then (call $sha256 (call $p64 (global.get $al)) (call $p64 (global.get $ap)) (i64.const 7))))
    (if (i32.eq (local.get $sub) (i32.const 1)) (then (call $keccak256 (call $p64 (global.get $al)) (call $p64 (global.get $ap)) (i64.const 7))))
    (if (i32.eq (local.get $sub) (i32.const 2)) (then (call $keccak512 (call $p64 (global.get $al)) (call $p64 (global.get $ap)) (i64.const 7))))
    (if (i32.eq (local.get $sub) (i32.const 3)) (then (call $ripemd160 (call $p64 (global.get $al)) (call $p64 (global.get $ap)) (i64.const 7))))
    (call $put (i32.const 104) (local.get $sub) (call $reg (i64.const 7)) (i64.const 24100)))

  (func $interp (local $op i32) (local $n i32) (local $i i32) (local $s i64) (local $t i64) (local $u i64) (local $len i64) (local $acc i64)
    (call $input (i64.const 0))
    (local.set $len (call $register_len (i64.const 0)))
    (if (i64.gt_u (local.get $len) (i64.const 16384)) (then (local.set $len (i64.const 16384))))
    (if (i64.gt_u (call $register_len (i64.const 0)) (i64.const 16384))
      (then (drop (call $storage_write (i64.const 1) (i64.const 0) (i64.const 0) (i64.const 0) (i64.const 1))))
      (else (call $read_register (i64.const 0) (i64.const 0))))
    (global.set $end (i32.wrap_i64 (local.get $len)))
    (global.set $pc (i32.const 0))
    (global.set $np (i32.const 0))
    (block $done
      (loop $next
        (br_if $done (i32.ge_u (global.get $pc) (global.get $end)))
        (local.set $op (call $b))
        (block $ok
          ;; 01 storage_write(key, len × fill)
          (if (i32.eq (local.get $op) (i32.const 0x01))
            (then
              (call $sa)
              (local.set $n (call $w))
              (local.set $i (call $b))
              (local.set $s (i64.const 0))
              (block $f (loop $fl
                (br_if $f (i64.ge_u (local.get $s) (i64.extend_i32_u (local.get $n))))
                (i32.store8 (i32.add (i32.const 32768) (i32.wrap_i64 (local.get $s))) (local.get $i))
                (local.set $s (i64.add (local.get $s) (i64.const 1)))
                (br $fl)))
              (drop (call $storage_write (call $p64 (global.get $al)) (call $p64 (global.get $ap))
                      (call $p64 (local.get $n)) (i64.const 32768) (i64.const 1)))
              (br $ok)))
          (if (i32.eq (local.get $op) (i32.const 0x02))
            (then (call $sa) (drop (call $storage_read (call $p64 (global.get $al)) (call $p64 (global.get $ap)) (i64.const 1))) (br $ok)))
          (if (i32.eq (local.get $op) (i32.const 0x03))
            (then (call $sa) (drop (call $storage_has_key (call $p64 (global.get $al)) (call $p64 (global.get $ap)))) (br $ok)))
          (if (i32.eq (local.get $op) (i32.const 0x04))
            (then (call $sa) (drop (call $storage_remove (call $p64 (global.get $al)) (call $p64 (global.get $ap)) (i64.const 1))) (br $ok)))
          (if (i32.eq (local.get $op) (i32.const 0x05))
            (then (call $sa) (call $log_utf8 (call $p64 (global.get $al)) (call $p64 (global.get $ap))) (br $ok)))
          (if (i32.eq (local.get $op) (i32.const 0x06))
            (then (call $sa) (call $log_utf16 (call $p64 (global.get $al)) (call $p64 (global.get $ap))) (br $ok)))
          (if (i32.eq (local.get $op) (i32.const 0x07))
