import ArenaCore.SHA256
open ArenaCore

-- "" and "abc" (FIPS 180-2 Appendix B.1) and the 56-byte two-block vector (B.2).
#eval (sha256 []).toHex
#eval (sha256 (Bytes.ofString "abc")).toHex
#eval (sha256 (Bytes.ofString "abcdbcdecdefdefgefghfghighijhijkijkljklmklmnlmnomnopnopq")).toHex

/-- Kernel-checked test vector: SHA-256("abc"). -/
theorem sha256_abc :
    sha256 [0x61, 0x62, 0x63] =
      [0xba, 0x78, 0x16, 0xbf, 0x8f, 0x01, 0xcf, 0xea, 0x41, 0x41, 0x40, 0xde, 0x5d, 0xae, 0x22, 0x23,
       0xb0, 0x03, 0x61, 0xa3, 0x96, 0x17, 0x7a, 0x9c, 0xb4, 0x10, 0xff, 0x61, 0xf2, 0x00, 0x15, 0xad] := by
  decide +kernel
